---
// The wordmark: the aperture ring IS the O.
//
// Previous versions set a ring beside the full word, which meant the lockup carried two O's —
// one drawn, one typed — and the mark read as a badge bolted to the front of a name. Making the
// ring the letter itself removes the redundancy and gives the drawn element a job: the word
// cannot be set without it.
//
// It reads O-X-I-E-D-O, with the first O drawn and the rest typed. For that to work rather than
// look like a logo glued to a word, three things have to be true, and they are handled in the
// CSS: the ring's diameter matches the type's cap height, its stroke matches the type's stem
// weight, and the space after it matches the tracking. Miss any one and it stops being a letter.
//
// THE APERTURE — the gap cut out of the ring — is the one idea. A bounded structure you can see
// into, which is what ORMAS is. The visible text is "XIEDO"; the link carries the full name, so
// assistive tech reads "Oxiedo", never the fragment.
export interface Props {
	href?: string;
	class?: string;
}

const { href = '/', class: className = '' } = Astro.props;

// Unique per instance. Nav and footer both render this on every page, and SVG url(#id) resolves
// to the first match in the document — with a shared id the footer ring would reference the
// nav's gradient and paint deep indigo on the ink at 2.21:1.
const uid = Math.random().toString(36).slice(2, 8);
---

<a href={href} class={`logo ${className}`} aria-label="Oxiedo — home">
	<span class="logo-o" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="none">
			<defs>
				{/* The sweep runs corner to corner so the hue turns as the eye travels the arc.
				    Two sets: the deep one holds on cream, the light one on ink — no single set
				    clears 3:1 on both grounds. */}
				<linearGradient id={`logo-sweep-${uid}`} x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" class="ring-stop-a" />
					<stop offset="50%" class="ring-stop-b" />
					<stop offset="100%" class="ring-stop-c" />
				</linearGradient>
			</defs>
			<circle class="logo-ring" cx="12" cy="12" r="9.4" pathLength="100" stroke={`url(#logo-sweep-${uid})`} />
		</svg>
	</span>
	<span class="logo-word" aria-hidden="true">XIEDO</span>
</a>
