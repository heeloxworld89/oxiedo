---
// design/12 §Pull Stat, ui_ux/01 §2. The warning variant exists because the homepage's
// −1.0 pp known-failure cell must not render in the same amber as the three wins beside it —
// three wins and a loss in one colour reads as four wins. It is a variant of this component,
// not a colour override left to the call site, so every future warning stat inherits the same
// treatment automatically.
export interface Props {
	figure: string;
	caption: string;
	variant?: 'default' | 'warning';
}

const { figure, caption, variant = 'default' } = Astro.props;
---

<div class={`pull-stat pull-stat--${variant}`}>
	<p class="pull-stat-figure tabular">{figure}</p>
	<p class="pull-stat-caption">{caption}</p>
</div>
