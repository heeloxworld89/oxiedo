---
// THE REPLAY INSTRUMENT. Added 2026-09-17, rebuilt the same day.
//
// WHY IT EXISTS. Four of the five sector pages already promised an evaluator a
// worked alarm output and a worked modification record. Both existed only as
// sentences. This is those two, shown, from an archived run.
//
// WHY IT WAS REBUILT. The first version drew two accuracy charts side by side:
// a page whose thesis is "the black box is opened" rendering two boxes with a
// number written on the outside of each. A reader who had never seen a neural
// network learned only that one line ended higher than the other. The network
// itself — the thing the whole argument is about — was never drawn.
//
// WHAT IT DRAWS NOW. The network. Three convolutional stages at their real
// shapes, the signal passing through them, each stage's health as a level you
// can watch fall and recover, and the bounded four-operation chain descending
// into the shared bottleneck. The accuracy curve is one strip underneath, with
// both arms on a single axis — evidence that the repair worked, not the exhibit.
//
// BOTH PANES DRAW THE SAME ANATOMY. Same stages, same heights, same positions,
// because it is the same network. The left one is sealed; the right one is cut
// open. That is the honest form of the claim: nothing was withheld from the
// baseline, the quantity was never computed.
//
// IT RUNS ON A DARK GROUND, alone on a light site. Telemetry reads as emitted
// signal against dark, which is why every instrument console is dark, and it
// separates the exhibit from the page's prose. This is equipment, not a figure.
//
// NOTHING COMPUTES IN THE BROWSER. Every value is read from a bundle generated
// from the experiment archive by scripts/build-replay-bundle.py and asserted
// against every published figure by scripts/verify-replay-bundle.py. Stage fill
// is `goodness`; an emptied stage is `weight_norm == 0`, which is literally what
// the archive records at the lesion; strikes are real correction events at their
// real steps. There is no decorative data on this page.
export interface Props {
	scenario?: string;
	/** Hide the scenario selector when embedded on a page about one feature. */
	fixed?: boolean;
	/** Open on the record — used on /product/diary. */
	openRecord?: boolean;
	/** Restart when the run finishes, instead of ending on the record.
	 *  True where the replay is ambient — an embed inside a page about
	 *  something else. False on /demo, where the run IS the subject and the
	 *  record is the payoff a reader came for. */
	loop?: boolean;
	compact?: boolean;
	/** 'auto' opens the guided read by itself, once per browser, when the component first
	 *  scrolls into view. For the page whose whole subject is this component. Everywhere
	 *  else the replay is an illustration inside a page about something else, and a tour
	 *  that starts itself there is an interruption. */
	guide?: 'auto' | 'manual';
}
const {
	scenario = 'dead-layer-lesion',
	fixed = false,
	openRecord = false,
	loop = false,
	compact = false,
	guide = 'manual',
} = Astro.props;

const SCENARIOS = [
	{ key: 'dead-layer-lesion', label: 'Dead-layer lesion' },
	{ key: 'full-hierarchy', label: 'Full-hierarchy lesion' },
	{ key: 'label-noise', label: 'Corrupted labels' },
	{ key: 'adversarial', label: 'Adversarial weight injection' },

];
---

<section
	class={`rp${compact ? ' rp--compact' : ''}`}
	data-replay
	data-scenario={scenario}
	data-open-record={openRecord ? 'true' : 'false'}
	data-loop={loop ? 'true' : 'false'}
	data-guide-mode={guide}
>
	<header class="rp-bar">
		<div class="rp-bar-left">
			<p class="rp-legend-item">The same network, twice. One sealed, one open.</p>
			{!fixed ? (
				<label class="rp-pick">
					<span class="rp-pick-label">Scenario</span>
					<select class="rp-select" data-select>
						{SCENARIOS.map((s) => (
							<option value={s.key} selected={s.key === scenario}>{s.label}</option>
						))}
					</select>
				</label>
			) : (
				<p class="rp-title" data-title>—</p>
			)}
		</div>
		<p class="rp-run" data-conditions>Loading the archived run…</p>
	</header>

	{/* PLAIN LANGUAGE, FIRST. Everything else in this component is written for somebody who
	    already knows what an epoch is. A first-time reader who does not gets a wall of
	    instrumentation and no reason to press anything, which is what was reported. Two
	    sentences, no jargon, above the diagram rather than below it. */}
	<p class="rp-plain">
		<strong>A neural network is damaged partway through training.</strong> The version on the
		right names which parts broke, two steps later, and repairs itself. The one on the left
		cannot say anything about it, and never will.
	</p>

	<div class="rp-stageband">
		<div class="rp-panes">
			<article class="rp-pane rp-pane--sealed">
				<div class="rp-anatomy" data-anatomy-baseline></div>
			</article>
			<article class="rp-pane rp-pane--open">
				<div class="rp-anatomy" data-anatomy-ormas></div>
			</article>
		</div>
	</div>

	<p class="rp-beat" data-beat hidden></p>

	<div class="rp-controls">
		<button type="button" class="rp-btn rp-btn--play" data-play aria-label="Play">
			<span data-play-label>Play</span>
		</button>
		<label class="rp-scrub">
			<span class="rp-sr">Epoch</span>
			<input type="range" data-scrub min="0" max="199" value="0" step="1" />
		</label>
		<output class="rp-epoch" data-epoch>epoch 0 / 199</output>
		<div class="rp-rates" role="group" aria-label="Playback speed">
			{[1, 4, 16].map((r) => (
				<button type="button" class="rp-rate" data-rate={r} aria-pressed={r === 1}>{r}×</button>
			))}
		</div>
		<button type="button" class="rp-btn rp-btn--event" data-replay-event>Replay from the event</button>
		{/* THE GUIDED READ. Opt-in, never automatic: the ambient homepage embed hides this
		    button entirely (see the loop branch in the island), because a tour that starts
		    itself over a looping background animation is an interruption, not guidance. */}
		<button type="button" class="rp-btn rp-btn--guide" data-guide-start>Guided read</button>
		<p class="rp-nature" data-nature></p>
	</div>

	{/* The annotation card is STATIC MARKUP, not injected at runtime. Astro scopes styles by
	    appending a [data-astro-cid-…] attribute to every selector, and an element created in
	    JavaScript never carries it — twice now that has shipped as a silently unstyled panel.
	    Only text content and hidden/class state are touched from the island. */}
	<aside class="rp-guide" data-guide hidden aria-live="polite">
		{/* The rail runs the full width across the top: every stop visible at once, the
		    current one filled, each reachable. Dots told a reader their position and nothing
		    else — not how far it runs, and not how to get back to one they had passed. */}
		<nav class="rp-guide-rail" data-guide-rail aria-label="Guided read progress"></nav>
		<div class="rp-guide-text">
			<p class="rp-guide-eyebrow">
				<span data-guide-count></span><span data-guide-where></span>
				<span class="rp-guide-live" data-guide-live></span>
			</p>
			<h4 class="rp-guide-title" data-guide-title></h4>
			<p class="rp-guide-body" data-guide-body></p>
		</div>
		<div class="rp-guide-foot">
			<button type="button" class="rp-guide-skip" data-guide-skip>Close</button>
			<button type="button" class="rp-btn" data-guide-back>Back</button>
			<button type="button" class="rp-btn rp-btn--primary" data-guide-next>Next</button>
		</div>
	</aside>

	{/* ── ONE PANEL AT A TIME ──────────────────────────────────────────────────────
	    The chart, the ledger, the answer table and the record used to stack, and the
	    component came to 1113px against 811px of usable height at 1440×900. Everything a
	    reader was asked to compare was therefore off-screen from everything else, and every
	    problem reported on this component — the guided read with nowhere to sit, the dock
	    hunting for room, having to scroll to see what changed — was downstream of that one
	    number.

	    Tabbed, the component is bar 63 + panes 336 + controls 71 + panel 291 = 761px. It
	    fits, with room to spare.

	    UNDER the panes, not beside them. The side-by-side arrangement is the obvious one and
	    it cannot work here: anatomy.ts holds each network to MIN_W = 560, so the two need
	    1120px between them, and a right-hand panel taking a third of a 1280px container
	    would leave them 395px each and force an overflow.

	    "What each one can answer" is the default tab deliberately. It is the only panel a
	    non-technical reader understands on sight — a list of questions, and whether each
	    network can answer them. The chart and the ledger are for someone already convinced. */}
	<div class="rp-tabs">
		<div class="rp-tablist" role="tablist" aria-label="Replay panels">
			<button type="button" class="rp-tab" role="tab" id="rp-tab-answers" aria-controls="rp-panel-answers" aria-selected="true" data-tab="answers">What each one can answer</button>
			<button type="button" class="rp-tab" role="tab" id="rp-tab-accuracy" aria-controls="rp-panel-accuracy" aria-selected="false" tabindex="-1" data-tab="accuracy">Accuracy</button>
			<button type="button" class="rp-tab" role="tab" id="rp-tab-ledger" aria-controls="rp-panel-ledger" aria-selected="false" tabindex="-1" data-tab="ledger">Corrections</button>
			<button type="button" class="rp-tab" role="tab" id="rp-tab-record" aria-controls="rp-panel-record" aria-selected="false" tabindex="-1" data-tab="record">The record</button>
		</div>

		<div class="rp-panel" id="rp-panel-answers" role="tabpanel" aria-labelledby="rp-tab-answers" data-panel="answers">
			<div class="rp-verdict">
			<p class="rp-chart-label">What each one can answer, at this epoch</p>
			<table class="rp-verdict-table">
				<thead>
					<tr>
						<th scope="col">The question</th>
						<th scope="col">Standard CNN</th>
						<th scope="col">ORMAS</th>
					</tr>
				</thead>
				<tbody data-verdict></tbody>
			</table>
			</div>
		</div>

		<div class="rp-panel" id="rp-panel-accuracy" role="tabpanel" aria-labelledby="rp-tab-accuracy" data-panel="accuracy" hidden>
			<div class="rp-chart">
			<p class="rp-chart-label">Test accuracy · both arms, one axis</p>
			<div class="rp-chart-box">
				<canvas data-canvas aria-label="Test accuracy across training for both networks on one axis"></canvas>
			</div>
			</div>
		</div>

		<div class="rp-panel" id="rp-panel-ledger" role="tabpanel" aria-labelledby="rp-tab-ledger" data-panel="ledger" hidden>
			<div class="rp-ledger">
			<p class="rp-chart-label">Correction ledger · written during training</p>
			<div class="rp-alarms" data-alarms></div>
			</div>
		</div>

		<div class="rp-panel" id="rp-panel-record" role="tabpanel" aria-labelledby="rp-tab-record" data-panel="record" hidden>
			<div class="rp-record" data-record>
			<header class="rp-record-head">
				<h4 class="rp-record-title">The record</h4>
				<p class="rp-record-sub" data-record-sub></p>
			</header>
			<dl class="rp-record-grid" data-record-grid></dl>
			<div class="rp-table-wrap">
				<table class="rp-table">
					<caption class="rp-sr">Every correction, with its component, diagnosis, step, magnitude and declared ceiling</caption>
					<thead>
						<tr><th scope="col">Step</th><th scope="col">Component</th><th scope="col">Diagnosis</th><th scope="col">Magnitude</th><th scope="col">Ceiling</th></tr>
					</thead>
					<tbody data-record-rows></tbody>
				</table>
			</div>
			<div class="rp-record-actions">
				<button type="button" class="rp-btn rp-btn--primary" data-download>Download the record</button>
				<button type="button" class="rp-btn" data-diff>Diff against the pre-event version</button>
			</div>
			<div class="rp-diff" data-diff-panel hidden></div>
			</div>
		</div>
	</div>

	<noscript>
		<p class="rp-noscript">
			This replay needs JavaScript. The underlying figures are on the technology
			page, with the conditions each was measured under.
		</p>
	</noscript>
</section>

<script>
	import { ReplayEngine } from '../scripts/replay/engine';
	import { draw, readTheme, sizeCanvas } from '../scripts/replay/render';
	import { Anatomy } from '../scripts/replay/anatomy';
	import type { Bundle, Correction } from '../scripts/replay/types';
	import { buildGuide, type GuideStep } from '../scripts/replay/guide';

	const DIAGNOSIS: Record<string, string> = {
		dead: 'dead', oscillating: 'oscillating', saturated: 'saturated',
		loss_stagnant: 'loss stagnant', gradient_dead: 'gradient dead',
		low_confidence: 'low confidence', exploded: 'exploded',
	};

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
	const num = (v: number) => v.toLocaleString('en-GB');
	const teardown: Array<() => void> = [];

	function init(root: HTMLElement) {
		if (root.dataset.replayReady === 'true') return;
		root.dataset.replayReady = 'true';

		const q = <T extends HTMLElement>(s: string) => root.querySelector(s) as T | null;
		const canvas = q<HTMLCanvasElement>('[data-canvas]')!;
		const elRun = q('[data-conditions]')!;
		const elTitle = q('[data-title]');
		const elAlarms = q('[data-alarms]')!;
		const elBeat = q('[data-beat]')!;
		const elEpoch = q('[data-epoch]')!;
		const elScrub = q<HTMLInputElement>('[data-scrub]')!;
		const btnPlay = q<HTMLButtonElement>('[data-play]')!;
		const lblPlay = q('[data-play-label]')!;
		const btnEvent = q<HTMLButtonElement>('[data-replay-event]')!;
		const select = q<HTMLSelectElement>('[data-select]');
		const elRecord = q('[data-record]')!;
		const elGuide = q('[data-guide]')!;
		const btnGuide = q<HTMLButtonElement>('[data-guide-start]')!;

		const anaBase = new Anatomy(q('[data-anatomy-baseline]')!, { instrumented: false, reduced });
		const anaOrmas = new Anatomy(q('[data-anatomy-ormas]')!, { instrumented: true, reduced });

		let engine: ReplayEngine | null = null;
		let bundle: Bundle | null = null;
		let theme = readTheme(root);

		function render(epoch: number) {
			if (!bundle || !engine) return;
			const e = Math.round(epoch);

			draw(canvas, bundle, epoch, theme);

			const frame = bundle.health.find((f) => f.epoch === e)
				?? bundle.health.filter((f) => f.epoch <= e).pop()
				?? bundle.health[0] ?? null;

			// A correction pulses on the stage it names, for the epoch it fired in.
			const striking = new Set<number>();
			for (const c of bundle.corrections) {
				if (c.epoch === e) striking.add(c.node);
			}
			anaOrmas.update(frame, striking, engine.isPlaying);
			anaBase.update(null, new Set(), engine.isPlaying);

			elEpoch.textContent = `epoch ${e} / ${engine.lastEpoch}`;
			if (document.activeElement !== elScrub) elScrub.value = String(e);
			renderAlarms(e);
			renderBeat(e);
			renderVerdict(e, frame);
		}

		/* The comparison, stated rather than implied. Every row is answered from
		   the frame on screen. The last row is the important one: the aggregate
		   IS available to both, and saying so is what keeps the other four
		   rows credible — the baseline is not blind to everything, it is blind
		   to everything beneath the aggregate. */
		function renderVerdict(epoch: number, frame: ReturnType<typeof Object> | null) {
			if (!bundle || !engine) return;
			const ev = bundle.event;
			const fired = ev != null && epoch >= ev.epoch;
			const f = frame as { nodes: Array<{ id: number; weight_norm: number | null }> } | null;

			const down = f ? f.nodes.filter((n) => (n.weight_norm ?? 0) === 0).map((n) => n.id) : [];
			const seen = bundle.corrections.filter((c) => c.epoch !== null && c.epoch <= epoch);
			const last = seen[seen.length - 1];

			const oAcc = bundle.series.ormas.accuracy[Math.min(epoch, engine.lastEpoch)];
            const bAcc = bundle.series.baseline.accuracy[Math.min(epoch, engine.lastEpoch)];

			const none = '<span class="rp-v-none">no such quantity exists</span>';
			const rows: Array<[string, string, string]> = [
				[
					'Which component is failing?',
					none,
					down.length
						? `<span class="rp-v-hit">${down.map((i) => `stage ${i}`).join(', ')} — dead</span>`
						: (last ? `stage ${last.node} — ${DIAGNOSIS[last.diagnosis] ?? last.diagnosis}` : 'none flagged'),
				],
				[
					'At which step?',
					ev ? (fired ? '<span class="rp-v-none">not until the loss moves</span>' : none)
					   : '<span class="rp-v-none">not until the curve turns down</span>',
					last ? `<span class="rp-v-hit">${num(last.step)}</span>` : '—',
				],
				[
					'By how much?',
					none,
					last?.magnitude != null
						? `magnitude ${last.magnitude.toFixed(4)}${last.ceiling != null ? `, ceiling ${last.ceiling.toFixed(2)} w` : ''}`
						: '—',
				],
				[
					ev ? 'What was done about it?' : 'What was done about the bad labels?',
					'<span class="rp-v-none">nothing — the run continues</span>',
					seen.length
						? `<span class="rp-v-hit">${seen.length} bounded correction${seen.length === 1 ? '' : 's'}</span>, each inside its declared ceiling`
						: 'nothing yet',
				],
				[
					'Test accuracy right now',
					`<span class="rp-v-both">${pct(bAcc)}</span>`,
					`<span class="rp-v-both">${pct(oAcc)}</span>`,
				],
			];

			const tb = q('[data-verdict]');
			if (tb) {
				tb.innerHTML = rows.map(([qn, a, b]) =>
					`<tr><th scope="row">${qn}</th><td>${a}</td><td>${b}</td></tr>`).join('');
			}
		}

		function renderAlarms(epoch: number) {
			if (!bundle) return;
			const seen = bundle.corrections.filter((c) => c.epoch !== null && c.epoch <= epoch);
			const recent = seen.slice(-5).reverse();
			if (!recent.length) {
				elAlarms.innerHTML =
					'<p class="rp-alarms-idle">No component has crossed its own baseline.</p>';
				return;
			}
			const rows = recent.map((c, i) => `
				<p class="rp-alarm${i === 0 ? ' is-latest' : ''}">
					<span class="rp-alarm-step">${num(c.step)}</span>
					<span class="rp-alarm-node">stage ${c.node}</span>
					<span class="rp-alarm-diag rp-alarm-diag--${c.diagnosis}">${DIAGNOSIS[c.diagnosis] ?? c.diagnosis}</span>
					<span class="rp-alarm-cap">${c.ceiling != null ? `≤ ${c.ceiling.toFixed(2)} w` : ''}</span>
				</p>`).join('');
			elAlarms.innerHTML =
				`<p class="rp-alarms-count">${seen.length} written so far</p>${rows}`;
		}

		function renderBeat(epoch: number) {
			const ev = bundle?.event;
			if (!ev || epoch < ev.epoch) { elBeat.hidden = true; return; }
			const named = ev.detected_nodes?.length
				? ev.detected_nodes.map((n) => `stage ${n}`).join(' and ')
				: null;
			if (ev.detected_step != null && ev.step_confirmed && ev.detected_lag_steps != null) {
				const lag = ev.detected_lag_steps;
				elBeat.innerHTML =
					`<strong>${ev.label}</strong> at step ${num(ev.step)}.` +
					(named ? ` Named at step ${num(ev.detected_step)} — ${lag === 1 ? 'one step' : `${num(lag)} steps`} later, on ${named}.` : '');
			} else {
				elBeat.innerHTML = `<strong>${ev.label}</strong> at epoch ${ev.epoch}.` +
					(named ? ` Named within one epoch, on ${named}.` : '');
			}
			elBeat.hidden = false;
		}

		function renderRecord() {
			if (!bundle) return;
			const rec = bundle.record as any;
			const c = bundle.conditions;
			q('[data-record-sub]')!.textContent =
				`${c.run_id_ormas} · seed ${c.seed} · ${c.dataset} · generated during training`;

			const m = rec.mission ?? {}, shock = rec.shock ?? null, rcv = rec.recovery ?? null;
			const items: [string, string][] = [
				['Epochs', String(m.epochs ?? '—')],
				['Peak', m.peak != null ? `${pct(m.peak)} at ${m.peak_epoch}` : '—'],
				['Final', m.final != null ? pct(m.final) : '—'],
				['Corrections', String(m.corrections ?? '—')],
				['Epochs with corrections', String(m.epochs_with_corrections ?? '—')],
			];
			if (shock) {
				items.push(['Event at epoch', String(shock.epoch)]);
				items.push(['Before → after', `${pct(shock.pre)} → ${pct(shock.post)}`]);
			}
			if (rcv) {
				items.push(['Recovered to', `${pct(rcv.to)} by ${rcv.by_epoch}`]);
				items.push(['Of what was lost', `${rcv.reclaimed_pct}%`]);
			}
			q('[data-record-grid]')!.innerHTML = items.map(([k, v]) =>
				`<div class="rp-record-cell"><dt>${k}</dt><dd>${v}</dd></div>`).join('');

			q('[data-record-rows]')!.innerHTML = (bundle.corrections as Correction[]).map((x) => `
				<tr><td>${num(x.step)}</td><td>stage ${x.node}</td>
				<td>${DIAGNOSIS[x.diagnosis] ?? x.diagnosis}</td>
				<td>${x.magnitude != null ? x.magnitude.toFixed(4) : '—'}</td>
				<td>${x.ceiling != null ? x.ceiling.toFixed(2) : '—'}</td></tr>`).join('');
		}

		// ── TABS ────────────────────────────────────────────────────────────────
		//
		// One panel visible at a time is what gets the component under the fold line. The
		// panels use the `hidden` attribute and carry NO display rule of their own, so
		// reset.css's `[hidden] { display: none !important }` is what hides them — the same
		// trap that shipped an always-visible guide card is avoided by simply not setting
		// display here. check.py's fourth audit fails the build if anyone adds one.
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];

		function selectTab(name: string, focus = false) {
			for (const b of tabs) {
				const on = b.dataset.tab === name;
				b.setAttribute('aria-selected', String(on));
				b.tabIndex = on ? 0 : -1;
				if (on && focus) b.focus();
			}
			for (const el of panels) el.hidden = el.dataset.panel !== name;

			// A canvas in a hidden panel has no box, so it sizes to zero and draws nothing.
			// Sizing on reveal is not an optimisation here; without it the accuracy tab is
			// blank the first time it is opened.
			if (name === 'accuracy') {
				sizeCanvas(canvas);
				if (engine) render(engine.epoch);
			}
		}

		for (const b of tabs) {
			b.addEventListener('click', () => selectTab(b.dataset.tab!));
		}
		// Arrow keys move between tabs, which is what a tablist is expected to do.
		root.querySelector('.rp-tablist')?.addEventListener('keydown', (e) => {
			const k = (e as KeyboardEvent).key;
			const i = tabs.findIndex((b) => b.getAttribute('aria-selected') === 'true');
			if (k !== 'ArrowRight' && k !== 'ArrowLeft' && k !== 'Home' && k !== 'End') return;
			e.preventDefault();
			const next = k === 'Home' ? 0
				: k === 'End' ? tabs.length - 1
				: (i + (k === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
			selectTab(tabs[next].dataset.tab!, true);
		});

		function showRecord() { selectTab('record'); renderRecord(); }

		function setPlayLabel() {
			const on = engine?.isPlaying ?? false;
			lblPlay.textContent = on ? 'Pause' : 'Play';
			btnPlay.setAttribute('aria-label', on ? 'Pause' : 'Play');
			root.classList.toggle('is-running', on);
		}

		// ─── GUIDED READ ────────────────────────────────────────────────────────
		//
		// It DRIVES the engine rather than sitting on top of it. Next resumes playback and the
		// frame callback stops the run when it reaches the next stop's epoch, so the reader
		// watches the run arrive at each beat instead of being teleported between freeze-frames.
		// The run is the argument; a slideshow of its stills is not.
		let guide: GuideStep[] = [];
		let guideAt = -1;          // -1 = not running
		let guideWaiting = -1;     // epoch the engine is currently travelling towards
		let travelFrom = -1;       // epoch the current travel started from, for the rail fill

		function guideRunning() { return guideAt >= 0; }

		// EVERY LOOKUP INSIDE THE DOCK GOES THROUGH gq, NEVER q.
		//
		// q() is bound to `root`, and the dock is re-parented to <body> while a guided read is
		// running — `.rp` has container-type: inline-size, so a fixed child of it is fixed to
		// the component rather than the viewport and has to leave. The first version of this
		// function used q() anyway. Every lookup returned null, the non-null assertion is a
		// compile-time claim and not a runtime guard, and the first assignment threw. The
		// component dimmed and no dock ever appeared: a blank grey screen with no way out.
		const gq = <T extends HTMLElement>(s: string) => elGuide.querySelector(s) as T | null;

		function paintGuide() {
			const step = guide[guideAt];
			if (!step) return;

			const count = gq('[data-guide-count]');
			if (count) count.textContent = `${guideAt + 1} / ${guide.length}`;
			const where = gq('[data-guide-where]');
			if (where) where.textContent = step.eyebrow ? ` · ${step.eyebrow}` : '';
			const title = gq('[data-guide-title]');
			if (title) title.textContent = step.title;
			const body = gq('[data-guide-body]');
			if (body) body.textContent = step.body;

			// The rail is the orientation device: every stop visible at once, the current one
			// filled, the rest reachable. Dots gave a reader no idea what was coming or how to
			// get back to something they had already passed.
			const rail = gq('[data-guide-rail]');
			if (rail) {
				rail.replaceChildren(...guide.map((s, i) => {
					const seg = document.createElement('button');
					seg.type = 'button';
					seg.className = 'rp-guide-seg';
					seg.dataset.seg = String(i);
					seg.setAttribute('aria-current', String(i === guideAt));
					seg.setAttribute('aria-label', `Stop ${i + 1} of ${guide.length}: ${s.title}`);
					if (i < guideAt) seg.dataset.done = 'true';
					return seg;
				}));
			}

			const back = gq<HTMLButtonElement>('[data-guide-back]');
			if (back) back.disabled = guideAt === 0;
			const next = gq<HTMLButtonElement>('[data-guide-next]');
			if (next) next.textContent = guideAt === guide.length - 1 ? 'Finish' : 'Next';

			// Highlight by ADDITION. The previous version dropped everything to 0.3, which made
			// a working instrument look disabled rather than guided. The rest now recedes only
			// slightly; the lit panel is raised by an outline and a lift.
			for (const el of root.querySelectorAll('.is-lit')) el.classList.remove('is-lit');
			const lit = root.querySelector(step.target);

			// OPEN THE TAB THE TARGET LIVES IN, FIRST. Three of the four stops point at
			// something that is now inside a tab panel, and a panel that is not selected is
			// `hidden` — so the guide was lighting an element with no box and telling the
			// reader to look at nothing. Caught by the browser test at stop 4 on every
			// viewport: "the highlighted panel is visible" failed the moment the panels
			// became tabs. Derived from the DOM rather than a second lookup table, so a stop
			// that points at a new panel needs no change here.
			const owner = lit?.closest<HTMLElement>('[data-panel]');
			if (owner && owner.hidden) selectTab(owner.dataset.panel!);

			lit?.classList.add('is-lit');

			// The dock does not move; the panel comes to the reader.
			elGuide.hidden = false;
			if (lit) scrollToBand(lit);
		}

		function guideStop() {
			guideAt = -1;
			guideWaiting = -1;
			travelFrom = -1;
			elGuide.classList.remove('is-travelling');
			elGuide.style.removeProperty('--travel');
			elGuide.hidden = true;
			// Back where the markup put it, so a client-side navigation cannot leave a
			// detached dock on the body of the next page.
			if (elGuide.parentElement !== root) root.appendChild(elGuide);
			root.classList.remove('is-guided');
			for (const el of root.querySelectorAll('.is-lit')) el.classList.remove('is-lit');
			engine?.pause();
			setPlayLabel();
		}

		/** Travel to a stop. Under reduced motion the run does not play between stops —
		 *  it seeks, because the motion IS the thing being suppressed. */
		/** Centre the lit panel in the band between the fixed nav and the dock.
		 *
		 *  scrollIntoView({block:'center'}) centres against the VIEWPORT, which knows nothing
		 *  about either fixture — measured in a browser, it left the verdict table at y=1093
		 *  in a 900px window, entirely below the fold, on the one stop whose whole point is
		 *  that the table changes. This computes the free band and centres in that. A panel
		 *  taller than the band is aligned to its top instead, because centring something
		 *  that cannot fit hides both of its ends. */
		function scrollToBand(lit: Element) {
			const navH = document.querySelector('.nav')?.getBoundingClientRect().height ?? 0;
			const dockH = elGuide.hidden ? 0 : elGuide.getBoundingClientRect().height;
			const bandTop = navH + 16;
			const band = window.innerHeight - dockH - 16 - bandTop;
			const r = lit.getBoundingClientRect();
			const offset = r.height > band ? bandTop : bandTop + (band - r.height) / 2;
			window.scrollTo({
				top: Math.max(0, r.top + window.scrollY - offset),
				behavior: reduced ? 'auto' : 'smooth',
			});
		}

		/** Travel to a stop.
		 *
		 *  THE DOCK IS NEVER HIDDEN. The first version hid it while the run travelled, and
		 *  travelling from epoch 101 to 199 takes several seconds — so the reader got a dimmed
		 *  component and no controls at all, which is indistinguishable from the thing having
		 *  crashed. The destination stop is painted immediately, the dock says it is running,
		 *  the rail segment fills as the epochs pass, and pressing Next again arrives at once.
		 *
		 *  `instant` skips the travel: used by the rail, by Back, and by a second Next. */
		function guideGoTo(i: number, instant = false) {
			if (!engine || i < 0 || i >= guide.length) return guideStop();
			const target = guide[i].epoch;
			const here = Math.round(Number(elScrub.value));
			guideAt = i;

			if (reduced || instant || target <= here) {
				engine.seekEpoch(target);
				guideWaiting = -1;
				travelFrom = -1;
				elGuide.classList.remove('is-travelling');
				paintGuide();
				setPlayLabel();
				return;
			}

			guideWaiting = target;
			travelFrom = here;
			paintGuide();                       // destination copy is up before the travel starts
			elGuide.classList.add('is-travelling');
			engine.play();
			setPlayLabel();
		}

		function guideStart() {
			if (!engine || !bundle) return;
			guide = buildGuide(bundle);
			if (guide.length === 0) return;
			// OUT OF THE COMPONENT. `.rp` sets container-type: inline-size, which applies
			// layout containment and makes it the containing block for fixed-position
			// descendants — the dock would be fixed to the component, not the viewport.
			// Scoping is attribute-based, so the styles travel with the element.
			document.body.appendChild(elGuide);
			root.classList.add('is-guided');
			selectTab('answers');
			engine.setRate(4);          // the gaps between stops are long at 1x
			for (const b of root.querySelectorAll('[data-rate]')) {
				b.setAttribute('aria-pressed', String(b.getAttribute('data-rate') === '4'));
			}
			engine.seekEpoch(0);
			guideAt = 0;
			guideWaiting = -1;
			paintGuide();
			setPlayLabel();
			// No scrollIntoView on the dock: it is position:fixed, so there is nothing to scroll to.
		}

		btnGuide.addEventListener('click', () => (guideRunning() ? guideStop() : guideStart()));
		gq('[data-guide-skip]')!.addEventListener('click', guideStop);
		gq('[data-guide-next]')!.addEventListener('click', () => {
			// Pressed while the run is still travelling: arrive now rather than queueing.
			if (guideWaiting >= 0) { guideGoTo(guideAt, true); return; }
			if (guideAt >= guide.length - 1) { guideStop(); showRecord(); return; }
			guideGoTo(guideAt + 1);
		});
		gq('[data-guide-back]')!.addEventListener('click', () => {
			if (guideAt > 0) guideGoTo(guideAt - 1, true);
		});
		// Delegated: the rail's segments are rebuilt on every paint.
		elGuide.addEventListener('click', (e) => {
			const seg = (e.target as HTMLElement)?.closest?.('[data-seg]') as HTMLElement | null;
			if (seg) guideGoTo(Number(seg.dataset.seg), true);
		});
		// Escape leaves it, the same key that closes every other overlay on the site.
		root.addEventListener('keydown', (e) => {
			if ((e as KeyboardEvent).key === 'Escape' && guideRunning()) guideStop();
		});

		async function load(key: string) {
			const embedded = (window as unknown as {
				__REPLAY_BUNDLES__?: Record<string, Bundle>;
			}).__REPLAY_BUNDLES__;
			if (embedded && embedded[key]) {
				bundle = embedded[key];
			} else {
				const res = await fetch(`/black-box/runs/${key}.json`);
				if (!res.ok) { elRun.textContent = 'The archived run could not be loaded.'; return; }
				bundle = await res.json();
			}
			if (!bundle) return;

			engine?.destroy();
			engine = new ReplayEngine(bundle);
			engine.onFrame = (e) => {
				render(e);
				// Travelling: fill the live rail segment so the wait reads as motion rather
				// than as the thing having stopped responding.
				if (guideWaiting >= 0) {
					const span = Math.max(1, guideWaiting - travelFrom);
					const pct = Math.max(0, Math.min(1, (e - travelFrom) / span));
					elGuide.style.setProperty('--travel', `${(pct * 100).toFixed(1)}%`);
					const live = elGuide.querySelector('[data-guide-live]');
					if (live) live.textContent = `running · epoch ${Math.round(e)}`;
				}
				// Arrive, hold, and settle the card.
				if (guideWaiting >= 0 && e >= guideWaiting) {
					guideWaiting = -1;
					travelFrom = -1;
					engine?.pause();
					engine?.seekEpoch(guide[guideAt].epoch);
					elGuide.classList.remove('is-travelling');
					elGuide.style.removeProperty('--travel');
					setPlayLabel();
					paintGuide();
				}
			};
			engine.onEnd = () => {
				setPlayLabel();
				// An ambient embed loops; the run holds on its final frame for a
				// beat first, so the recovered figure and the finished record
				// register before it starts over.
				if (root.dataset.loop === 'true' && !reduced) {
					clearTimeout(loopTimer);
					loopTimer = window.setTimeout(() => {
						if (!inView || !engine) return;
						engine.seekEpoch(0);
						engine.play();
						setPlayLabel();
					}, 2200);
					return;
				}
				showRecord();
			};

			// The looping homepage embed is ambient: it plays itself and must not invite a
			// reader into a modal sequence over the top of it. The button is removed there
			// rather than hidden, so nothing can tab to it.
			if (root.dataset.loop === 'true') btnGuide.remove();

			// A scenario change abandons any guide in progress — its stops are built from the
			// bundle that was loaded, and half of them would point at epochs in the old run.
			if (guideRunning()) guideStop();

			anaBase.load(bundle);
			anaOrmas.load(bundle);

			const c = bundle.conditions;
			elRun.textContent =
				`${c.dataset} · seed ${c.seed} · run ${c.archive_index} · ${c.run_id_ormas}`;
			if (elTitle) elTitle.textContent = bundle.title;

			// A run with no event has a different shape of story and the chrome
			// has to say so, or the reader waits for a catastrophe that never
			// comes and concludes the demo is broken.
			const hasEvent = bundle.event != null;
			btnEvent.textContent = hasEvent ? 'Replay from the event' : 'Replay from the divergence';
			const nature = q('[data-nature]');
			if (nature) {
				nature.textContent = hasEvent
					? ''
					: 'Nothing is inflicted in this run. The corruption is in the data from the first step.';
			}

			elScrub.max = String(engine.lastEpoch);
			selectTab('answers');
			q('[data-diff-panel]')!.hidden = true;

			if (reduced || root.dataset.openRecord === 'true') {
				engine.toEnd();   // fires onEnd, which opens the record
			} else {
				engine.seekEpoch(0);
			}
			setPlayLabel();
			maybeAutoStart();   // the observer may already have fired
		}

		// TAKING A CONTROL ENDS THE GUIDE. Someone who reaches for the scrubber or the play
		// button has decided to drive; leaving a sequence half-open over the top of that is
		// the behaviour everyone hates about tours. It does not resume, and it does not ask.
		btnPlay.addEventListener('click', () => {
			clearTimeout(loopTimer);
			if (guideRunning()) guideStop();
			engine?.toggle();
			setPlayLabel();
		});
		btnEvent.addEventListener('click', () => {
			if (guideRunning()) guideStop();
			if (!engine || !bundle) return;
			if (bundle.event) {
				engine.replayFromEvent();
			} else {
				// Where the arms first part by more than a point and stay parted.
				const o = bundle.series.ormas.accuracy;
				const b = bundle.series.baseline.accuracy;
				let at = 0;
				for (let e = 1; e < o.length; e++) {
					if (o[e] - b[e] > 0.01) { at = e; break; }
				}
				engine.pause();
				engine.seekEpoch(Math.max(0, at - 5));
				engine.play();
			}
			setPlayLabel();
		});
		elScrub.addEventListener('input', () => {
			clearTimeout(loopTimer);
			if (guideRunning()) guideStop();
			engine?.pause(); engine?.seekEpoch(Number(elScrub.value)); setPlayLabel();
		});
		root.querySelectorAll<HTMLButtonElement>('[data-rate]').forEach((btn) => {
			btn.addEventListener('click', () => {
				engine?.setRate(Number(btn.dataset.rate));
				root.querySelectorAll('[data-rate]').forEach((o) =>
					o.setAttribute('aria-pressed', String(o === btn)));
			});
		});
		select?.addEventListener('change', () => {
			root.dataset.openRecord = 'false';
			autoStarted = false;   // a chosen scenario should run, not wait
			load(select.value);
			const u = new URL(location.href);
			u.searchParams.set('scenario', select.value);
			history.replaceState(null, '', u);
		});

		q<HTMLButtonElement>('[data-download]')?.addEventListener('click', () => {
			if (!bundle) return;
			const payload = {
				note: 'Modification record generated during training. Replayed from the '
					+ 'archived run named below; regenerable from its seed.',
				conditions: bundle.conditions, event: bundle.event, record: bundle.record,
			};
			const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
			const a = document.createElement('a');
			a.href = URL.createObjectURL(blob);
			a.download = `ormas-record-${bundle.key}-${bundle.conditions.run_id_ormas}.json`;
			a.click();
			URL.revokeObjectURL(a.href);
		});

		q<HTMLButtonElement>('[data-diff]')?.addEventListener('click', () => {
			const panel = q('[data-diff-panel]')!;
			if (!bundle || !bundle.event) return;
			if (!panel.hidden) { panel.hidden = true; return; }
			const before = bundle.health.find((f) => f.epoch === bundle!.event!.epoch - 1);
			const after = bundle.health[bundle.health.length - 1];
			if (!before || !after) return;
			panel.innerHTML = `
				<p class="rp-diff-label">Component state, epoch ${before.epoch} against epoch ${after.epoch}</p>
				<table class="rp-table"><thead><tr><th scope="col">Component</th>
				<th scope="col">Weight norm before</th><th scope="col">After</th><th scope="col">Change</th></tr></thead>
				<tbody>${before.nodes.map((bn) => {
					const an = after.nodes.find((z) => z.id === bn.id);
					const bw = bn.weight_norm ?? 0, aw = an?.weight_norm ?? 0, d = aw - bw;
					return `<tr><td>stage ${bn.id}</td><td>${bw.toFixed(2)}</td><td>${aw.toFixed(2)}</td><td>${d >= 0 ? '+' : ''}${d.toFixed(2)}</td></tr>`;
				}).join('')}</tbody></table>`;
			panel.hidden = false;
		});

		// The replay starts itself the first time it is properly on screen. A demo
		// that waits to be pressed is a demo most readers scroll past: on the home
		// page especially, this section IS the argument and the play button is one
		// more thing to not do.
		//
		// Once only, so scrolling back up does not restart a run mid-way and lose
		// the reader's place; never under reduced motion; and never in the mode
		// that opens straight on the record, where the run is already over.
		// The observer fires once on observe(), which can be BEFORE the bundle has
		// finished loading and the engine exists. So intersection is recorded as
		// state and the decision is taken from two places — whichever of the two
		// happens second wins, and neither can miss the other.
		let autoStarted = false;
		let inView = false;
		let loopTimer = 0;

		// FIRST VISIT GETS THE GUIDED READ, ONCE.
		//
		// Nobody clicks a button they do not know is there, so on the page whose subject is
		// this component the guided read opens itself the first time the component is
		// scrolled to. Once per browser: the flag is written the moment it fires, so a second
		// visit gets the plain autoplay and is never walked through it again.
		//
		// localStorage is wrapped both ways. It throws in a private window and in a browser
		// with site data blocked, and an exception here would take out the autostart with it.
		// A reader whose storage is unavailable gets the guide every visit, which is the safe
		// direction to fail in.
		const GUIDE_SEEN = 'oxiedo.blackbox.guideSeen';
		function guideAlreadySeen() {
			try { return localStorage.getItem(GUIDE_SEEN) === '1'; } catch { return false; }
		}
		function rememberGuideSeen() {
			try { localStorage.setItem(GUIDE_SEEN, '1'); } catch { /* storage unavailable */ }
		}

		function maybeAutoStart() {
			if (autoStarted || reduced) return;
			if (root.dataset.openRecord === 'true') return;
			if (!inView || !engine || engine.isPlaying) return;
			autoStarted = true;

			if (root.dataset.guideMode === 'auto' && !guideAlreadySeen() && !guideRunning()) {
				rememberGuideSeen();
				guideStart();
				return;
			}

			engine.seekEpoch(0);
			engine.play();
			setPlayLabel();
		}

		const io = new IntersectionObserver((entries) => {
			inView = entries[0]?.isIntersecting ?? true;
			if (!inView) { clearTimeout(loopTimer); engine?.pause(); setPlayLabel(); return; }
			maybeAutoStart();
		}, { threshold: 0.4 });
		io.observe(root);

		const onVisibility = () => {
			if (document.hidden) { engine?.pause(); setPlayLabel(); }
		};
		document.addEventListener('visibilitychange', onVisibility);

		let rt = 0;
		const onResize = () => {
			clearTimeout(rt);
			rt = window.setTimeout(() => {
				theme = readTheme(root);
				sizeCanvas(canvas);
				if (engine) render(engine.epoch);
			}, 120);
		};
		window.addEventListener('resize', onResize);

		teardown.push(() => {
			clearTimeout(loopTimer);
			// The dock may be parented to <body>; ClientRouter swaps the page under it and
			// would otherwise strand a fixed panel over the next route.
			if (guideRunning()) guideStop();
			elGuide.remove();
			engine?.destroy(); engine = null;
			anaBase.destroy(); anaOrmas.destroy();
			io.disconnect();
			window.removeEventListener('resize', onResize);
			document.removeEventListener('visibilitychange', onVisibility);
			clearTimeout(rt);
			delete root.dataset.replayReady;
		});

		const url = new URL(location.href);
		const wanted = url.searchParams.get('scenario');
		const initial = (wanted && select
			&& Array.from(select.options).some((o) => o.value === wanted))
			? wanted : (root.dataset.scenario || 'dead-layer-lesion');
		if (select) select.value = initial;
		load(initial);
	}

	function initAll() {
		document.querySelectorAll<HTMLElement>('[data-replay]').forEach((element) => {
			try { init(element); } catch (err) { console.error('[replay] init failed', err); }
		});
	}

	document.addEventListener('astro:page-load', initAll);
	document.addEventListener('astro:before-swap', () => {
		while (teardown.length) teardown.pop()?.();
	});
	if (document.readyState !== 'loading') initAll();
	else document.addEventListener('DOMContentLoaded', initAll);
</script>

<style>
	/* THE REPLAY INSTRUMENT, as a scientific plate.
	   REPALETTED 2026-09-17. The first version ran on --bg-dark, on the theory
	   that telemetry reads as emitted signal and every instrument console is
	   dark. That reference was wrong twice over. A single dark slab on a cream
	   editorial site reads as a foreign object — an embedded player rather than
	   part of the document — and near-black with one amber accent is the exact
	   generic treatment this site's design notes warn against.
	   The right reference is the printed plate: an anatomical drawing, an
	   engineering section, a spectrogram. All light-ground, and so are the
	   technical account's own figures, where the ORMAS line is already this
	   amber. A light plate also survives being screenshotted into a deck or a
	   paper, which is most of what this asset is for.
	   No new palette: every value below is a token the site already ships. */

	.rp {
		--plate: var(--bg-surface);
		--plate-sunk: var(--bg-base);
		--rule: var(--border-hairline);
		--fg: var(--text-primary);
		--fg-mid: var(--text-secondary);
		--fg-dim: var(--text-muted);
		--ormas: var(--chart-ormas);
		--base: var(--chart-baseline);
		--warn: var(--chart-warning);
		--mono: ui-monospace, SFMono-Regular, Menlo, monospace;

		background: var(--plate);
		color: var(--fg);
		border: 1px solid var(--rule);
		border-radius: 4px;
		overflow: hidden;
		container-type: inline-size;
	}

	/* ── chrome ───────────────────────────────────────────────── */

	.rp-bar {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-lg);
		align-items: baseline;
		justify-content: space-between;
		padding: var(--space-md) var(--space-lg);
		border-bottom: 1px solid var(--rule);
	}

	.rp-bar-left { display: flex; align-items: baseline; gap: var(--space-md); min-width: 0; }
	.rp-pick { display: flex; align-items: baseline; gap: var(--space-sm); }

	.rp-pick-label, .rp-chart-label {
		font-size: var(--text-eyebrow);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--fg-dim);
	}

	.rp-select {
		font: inherit;
		font-size: var(--text-small);
		color: var(--fg);
		background: var(--plate);
		border: 1px solid var(--rule);
		border-radius: 3px;
		padding: 4px 8px;
	}

	.rp-title { margin: 0; font-size: var(--text-small); font-weight: 600; }

	/* Conditions stay in the chrome at every frame: screenshots travel without
	   their context, and a figure loose on a timeline with no conditions reads
	   as an overclaim. */
	.rp-run { margin: 0; font-family: var(--mono); font-size: 11px; color: var(--fg-dim); }

	/* ── the anatomy band: the hero ───────────────────────────── */

	.rp-stageband { padding: 0; }
	.rp-readout, .rp-controls { padding-inline: var(--space-lg); }

	/* Folded into the top bar when the controls moved up under the network:
	   it did not earn a 40px row of its own. */
	.rp-legend-item {
		margin: 0;
		font-size: var(--text-small);
		color: var(--fg-mid);
		min-width: 0;
	}

	.rp-panes {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-block: 1px solid var(--rule);
	}

	.rp-pane {
		border: 1px solid color-mix(in srgb, var(--rule) 32%, transparent);
		border-radius: 4px;
		/* Tight vertically: the anatomy inside is a fixed 300px, so every pixel of pane
		   padding is a pixel of component height, and the component has to clear the fold. */
		padding: 8px var(--space-md);
		min-width: 0;
		background: color-mix(in srgb, var(--ink-raised) 45%, transparent);
	}
	/* The open pane is lifted a half-step. The difference between the two is
	   the entire argument, so it gets exactly one unit of emphasis and no more. */
	.rp-pane--sealed { /* geometry identical to the open pane, by design */ }
	.rp-pane--open {
		background: var(--ink-raised);
		border-color: color-mix(in srgb, var(--ormas) 28%, transparent);
	}

	.rp-anatomy { width: 100%; }

	/* ── SVG anatomy internals ────────────────────────────────── */

	.rp :global(.an-name) {
		font-size: 11px; font-weight: 700; letter-spacing: 0.06em;
		fill: var(--fg); font-family: var(--font-sans, system-ui);
	}
	.rp :global(.an-badge) {
		font-size: 9px; letter-spacing: 0.14em; font-family: var(--mono);
		fill: var(--fg-dim);
	}
	.rp :global(.an-sub) { font-size: 9px; font-family: var(--mono); fill: var(--fg-dim); }
	.rp-pane--open :global(.an-badge) { fill: var(--ormas); }
	.rp :global(.an-sub) { font-size: 9px; font-family: var(--mono); fill: var(--fg-dim); }

	.rp :global(.an-input) {
		fill: color-mix(in srgb, var(--base) 30%, transparent);
		stroke: var(--base); stroke-width: 1.1;
	}
	.rp :global(.an-output) {
		fill: color-mix(in srgb, var(--fg) 18%, transparent);
		stroke: color-mix(in srgb, var(--fg) 45%, transparent); stroke-width: 1.1;
	}
	.rp :global(.an-io) { font-size: 9px; font-family: var(--mono); fill: var(--fg-dim); }
	.rp :global(.an-io-sub) { font-size: 8px; font-family: var(--mono); fill: color-mix(in srgb, var(--fg) 34%, transparent); }

	/* ── the network itself ───────────────────────────────────── */

	/* Edges are recessive: they carry structure, not state. The units and the
	   signal carry state, and if the web competed with them the drawing would
	   read as decoration. */
	.rp :global(.an-edge) {
		stroke: color-mix(in srgb, var(--fg) 13%, transparent);
		stroke-width: 0.6;
		fill: none;
	}
	.rp-pane--open :global(.an-edge) { stroke: color-mix(in srgb, var(--ormas) 26%, transparent); }

	.rp :global(.an-spine) {
		stroke: color-mix(in srgb, var(--fg) 10%, transparent);
		stroke-width: 1;
	}

	/* A unit's fill is its stage's health, passed in as --health. Uniform across
	   the stage on purpose: the telemetry resolves to the stage, not the
	   channel. */
	.rp :global(.an-unit) {
		fill: color-mix(in srgb, var(--ormas) calc(var(--health, 0) * 100%), var(--plate));
		stroke: color-mix(in srgb, var(--ormas) 70%, transparent);
		stroke-width: 1.1;
		transition: fill 260ms var(--ease-out);
	}
	/* Sealed: the units are there, drawn at full strength, reporting nothing.
	   Hollow rather than dim — the stage is working, it is just not observable. */
	.rp :global(.an-unit.is-sealed) {
		fill: var(--plate);
		stroke: color-mix(in srgb, var(--fg) 34%, transparent);
	}
	.rp :global(.an-unit.is-destroyed) {
		fill: var(--plate);
		stroke: var(--warn);
		stroke-width: 1.6;
		stroke-dasharray: 2 1.6;
	}

	/* Health as a soft field around the column, so a healthy stage reads at a
	   glance without having to compare eleven small circles. */
	.rp :global(.an-halo) {
		fill: var(--ormas);
		transition: opacity 260ms var(--ease-out);
	}
	.rp :global(.an-footnote) {
		font-size: 7px; font-family: var(--mono); fill: var(--fg-dim);
	}

	/* A correction fired on this component — the working colour. Not the same
	   claim as destruction, which has its own outline: drawing both in the
	   warning colour made a stage that had merely self-corrected read as
	   wreckage. */
	.rp :global(.an-strike) { transition: opacity 160ms linear; }
	.rp :global(.an-strike rect) { fill: none; stroke: var(--ormas); stroke-width: 1.6; }
	.rp :global(.an-gone) {
		fill: none; stroke: var(--warn); stroke-width: 1.6;
		transition: opacity 200ms linear;
	}

	/* ── stage labels ─────────────────────────────────────────────
	   Every one of these needs an explicit font-size. SVG text with none
	   inherits the page's body size and is then multiplied by the viewBox
	   scale, which is how these once rendered at ~29px. */
	.rp :global(.an-stage-shape) {
		font-size: 10px; font-family: var(--mono); font-weight: 700; fill: var(--fg);
	}
	.rp :global(.an-stage-params) {
		font-size: 8px; font-family: var(--mono); fill: var(--fg-dim);
	}
	.rp :global(.an-stage-state) {
		font-size: 9px; font-family: var(--mono); fill: var(--fg-mid);
	}
	.rp :global(.an-stage-state.is-destroyed) { fill: var(--warn); font-weight: 700; }
	.rp :global(.an-stage-metric) {
		font-size: 8px; font-family: var(--mono); fill: var(--fg-dim);
	}

	/* THE SIGNAL. One pulse per unit per gap, staggered, travelling forward.
	   This is the single piece of motion that makes the drawing a network
	   rather than a diagram of one. */
	.rp :global(.an-flow) {
		stroke: var(--base);
		stroke-width: 2;
		stroke-linecap: round;
		fill: none;
		stroke-dasharray: 5 999;
		stroke-dashoffset: 0;
		opacity: 0;
	}
	.rp-pane--open :global(.an-flow) { stroke: var(--ormas); }
	.rp.is-running :global(.an-flow) {
		opacity: 0.85;
		animation: rp-pulse 1.5s linear infinite;
	}
	@keyframes rp-pulse {
		0%   { stroke-dashoffset: 5;  opacity: 0; }
		12%  { opacity: 0.9; }
		88%  { opacity: 0.9; }
		100% { stroke-dashoffset: -100; opacity: 0; }
	}

	.rp :global(.an-tap) { stroke: color-mix(in srgb, var(--ormas) 50%, transparent); stroke-width: 0.9; stroke-dasharray: 2 2; }
	.rp :global(.an-op) {
		fill: color-mix(in srgb, var(--ormas) 10%, transparent);
		stroke: color-mix(in srgb, var(--ormas) 62%, transparent);
		stroke-width: 0.7;
	}
	.rp :global(.an-op-label) { font-size: 6.5px; font-family: var(--mono); fill: var(--ormas); }
	.rp :global(.an-bottleneck) {
		fill: color-mix(in srgb, var(--ormas) 8%, transparent);
		stroke: var(--ormas); stroke-width: 0.9;
	}
	.rp :global(.an-bottleneck-label) { font-size: 7.5px; font-family: var(--mono); fill: var(--ormas); }
	.rp :global(.an-chain-caption) {
		font-size: 7.5px; font-family: var(--mono);
		letter-spacing: 0.1em; fill: var(--ormas);
	}
	.rp :global(.an-chain-caption--void) { fill: var(--fg-dim); }
	.rp :global(.an-name) { fill: var(--fg); }

	.rp :global(.an-void) {
		fill: none;
		stroke: color-mix(in srgb, var(--fg) 26%, transparent);
		stroke-width: 0.9; stroke-dasharray: 3 3;
	}
	.rp :global(.an-void-label) { font-size: 9px; font-family: var(--mono); fill: var(--fg-mid); }
	.rp :global(.an-void-sub) { font-size: 7.5px; font-family: var(--mono); fill: var(--fg-dim); }

	/* ── readout row ──────────────────────────────────────────── */

	/* SHORT VIEWPORTS. The console is built to clear the fold at 900px of window height, which
	   leaves 811px under the nav. At 800px there are only 711px and it does not fit — so on a
	   short window the network drawing gives up 60px and the chrome tightens, which closes
	   most of the gap. Not all of it: at 800px tall the component still runs about 45px past
	   the fold, and shrinking the diagram further would make its labels unreadable, which is
	   a worse trade than a short scroll.

	   Two things this rule needs that are easy to miss. The !important is against an inline
	   style: anatomy.ts sets svg.style.height = "300px" when it draws, so nothing in a
	   stylesheet reaches it otherwise. And the :global() is because that svg is created in
	   JavaScript and therefore carries no [data-astro-cid] — a bare `> svg` compiles to
	   `svg[data-astro-cid-…]` and matches nothing, which is exactly how this first shipped:
	   the padding trims applied, the diagram did not, and the component moved 4px. */
	@media (max-height: 880px) {
		.rp-anatomy > :global(svg) { height: 240px !important; }
		.rp-plain { padding-block: 8px; }
		.rp-pane { padding-block: 6px; }
		.rp-panel { padding-block: 10px; }
	}

	/* ── plain-language strip ── */
	.rp-plain {
		margin: 0;
		padding: 10px var(--space-lg);
		border-bottom: 1px solid var(--rule);
		font-size: 13px;
		line-height: 1.5;
		color: var(--fg-mid);
		max-width: 104ch;
	}
	.rp-plain strong { color: var(--fg); font-weight: 700; }

	/* ── tabs ── */
	.rp-tabs {
		border-top: 1px solid var(--rule);
		background: var(--plate);
	}

	.rp-tablist {
		display: flex;
		gap: 2px;
		padding: 0 var(--space-lg);
		border-bottom: 1px solid var(--rule);
		overflow-x: auto;
		scrollbar-width: none;
	}
	.rp-tablist::-webkit-scrollbar { display: none; }

	.rp-tab {
		font: inherit;
		font-size: var(--text-small);
		font-weight: 600;
		white-space: nowrap;
		padding: 8px 14px;
		border: 0;
		border-bottom: 2px solid transparent;
		background: none;
		color: var(--fg-dim);
		cursor: pointer;
		transition: color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out);
	}
	.rp-tab:hover { color: var(--fg); }
	.rp-tab[aria-selected='true'] {
		color: var(--ormas);
		border-bottom-color: var(--ormas);
	}

	/* NO `display` ON .rp-panel. The panels are toggled with the hidden attribute, and an
	   author display here would outrank the UA rule and make every panel permanently
	   visible — the exact bug that shipped an always-open guide card. */
	/* THE PANEL SETS THE COMPONENT'S HEIGHT, so it is fixed rather than min-height'd: every
	   tab is the same height and switching between them does not make the page jump. 244px
	   is the tallest of the four panels' contents at 1440px, measured, not chosen. */
	.rp-panel {
		padding: var(--space-md) var(--space-lg);
		height: 258px;
		overflow-y: auto;
	}

	.rp-readout {
		display: grid;
		grid-template-columns: 1.7fr 1fr;
		gap: var(--space-lg);
		align-items: start;
	}
	.rp-chart, .rp-ledger { min-width: 0; }
	.rp-chart-label { margin: 0 0 var(--space-sm); }
	/* HEIGHT, NOT ASPECT RATIO. At 5/2 the box grew with its width: 460px tall on a 1150px
	   panel, which is nearly twice the panel it sits in. It now fills the panel it is given. */
	.rp-chart-box { position: relative; height: 196px; min-height: 0; }
	.rp-chart-box canvas { position: absolute; inset: 0; width: 100%; height: 100%; }

	.rp-alarms { min-height: 150px; font-family: var(--mono); font-size: 11px; }
	.rp-alarms :global(.rp-alarms-idle) { margin: 0; color: var(--fg-dim); font-style: italic; }
	.rp-alarms :global(.rp-alarms-count) {
		margin: 0 0 8px;
		font-size: var(--text-eyebrow);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fg-dim);
	}
	.rp-alarms :global(.rp-alarm) {
		display: grid;
		grid-template-columns: 5.2rem 4rem 1fr;
		gap: 4px 10px;
		align-items: baseline;
		margin: 0;
		padding: 4px 0;
		border-top: 1px solid var(--rule);
		color: var(--fg-mid);
		font-variant-numeric: tabular-nums;
	}
	.rp-alarms :global(.rp-alarm.is-latest) { color: var(--fg); }
	.rp-alarms :global(.rp-alarm-step) { color: var(--fg-dim); }
	.rp-alarms :global(.rp-alarm-node) { font-weight: 700; color: var(--fg); }
	.rp-alarms :global(.rp-alarm-diag--dead) { color: var(--warn); font-weight: 700; }
	.rp-alarms :global(.rp-alarm-diag--oscillating) { color: var(--ormas); }
	.rp-alarms :global(.rp-alarm-cap) { grid-column: 2 / -1; color: var(--fg-dim); font-size: 10px; }

	/* ── the verdict ledger ───────────────────────────────────── */

	/* The site already argues this way on the home page: question, how it is
	   answered today, with ORMAS. Same three columns, answered live against the
	   frame on screen, so the difference is read rather than inferred.

	   Every rule here is scoped through .rp-verdict-table — a static element —
	   with :global on the rows, because the rows are injected by script and
	   carry no scoping attribute of their own. */
	/* ── guided read ──────────────────────────────────────────────
	   Three rules, each one written after the previous attempt failed on a real screen.

	   1. THE DOCK DOES NOT MOVE. Version one inserted the annotation beside whichever panel
	      was lit, so it jumped between three places down a component taller than the viewport
	      and the reader lost the Next button. It is now one fixed position for the whole
	      sequence and the lit panel scrolls to the reader instead.

	   2. IT LIVES ON <body>. `.rp` sets container-type: inline-size, which applies layout
	      containment and makes it the containing block for fixed descendants — a fixed card
	      inside it is fixed to the component, not the viewport. The .rp-local custom
	      properties do not travel with it, so everything here reads global tokens.

	   3. HIGHLIGHT BY ADDITION, NOT BY SUBTRACTION. Version two dropped the whole component
	      to 0.3, which reads as disabled rather than guided — the page looked broken. The
	      surroundings now recede only slightly and the lit panel is raised by an outline and
	      a lift, which is the difference between "this is off" and "look here". */
	/* The colour rules for this button live further down, beside .rp-btn--play. They were
	   here, ahead of the base .rp-btn rule, and `color: var(--fg)` won on source order at
	   equal specificity — the amber never applied and the button measured 18.23:1, which is
	   ink. Same class, same weight, later wins. */

	/* Leaf panels only: .rp-ledger is a child of .rp-readout and opacity composites down the
	   tree, so dimming the parent would cap the lit child at whatever the parent is. */
	.rp.is-guided .rp-panes,
	.rp.is-guided .rp-chart,
	.rp.is-guided .rp-ledger,
	.rp.is-guided .rp-verdict,
	.rp.is-guided .rp-bar {
		opacity: 0.55;
		transition: opacity 220ms ease;
	}
	.rp.is-guided .is-lit {
		opacity: 1;
		position: relative;
		z-index: 1;
		border-radius: 4px;
		outline: 2px solid color-mix(in oklab, var(--ormas) 70%, transparent);
		outline-offset: 10px;
		background: var(--plate);
		box-shadow: 0 0 0 10px var(--plate), 0 10px 32px rgb(0 0 0 / 0.08);
	}

	/* ── the dock ── */
	.rp-guide:not([hidden]) {
		position: fixed;
		z-index: 90;                       /* under the nav (100) and its menus (120) */
		left: 50%;
		transform: translateX(-50%);
		bottom: 18px;
		width: min(1240px, calc(100vw - 32px));
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-rows: auto auto;
		align-items: center;
		column-gap: var(--space-lg);
		row-gap: 12px;
		padding: 14px var(--space-lg) 16px;
		border: 1px solid color-mix(in oklab, var(--chart-ormas) 30%, var(--border-hairline));
		border-radius: 10px;
		background: var(--bg-surface);
		box-shadow: 0 12px 40px rgb(0 0 0 / 0.16);
		color: var(--text-primary);
		/* Measured tallest is 224px on a 390×844 phone and 158px on a 1280×640 laptop, so this
		   never engages in practice. It is here for the viewport nobody tested: a long stop on
		   a short window must scroll inside the dock rather than push Next off the bottom. */
		max-height: 46vh;
		overflow-y: auto;
	}

	/* THE RAIL. Full width across the top, one segment per stop, clickable. */
	.rp-guide-rail {
		grid-column: 1 / -1;
		grid-row: 1;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 1fr;
		gap: 4px;
	}
	.rp-guide :global(.rp-guide-seg) {
		appearance: none;
		border: 0;
		padding: 0;
		height: 3px;
		border-radius: 2px;
		background: color-mix(in oklab, var(--text-muted) 28%, transparent);
		cursor: pointer;
		transition: background 180ms ease, height 180ms ease;
	}
	.rp-guide :global(.rp-guide-seg[data-done='true']) {
		background: color-mix(in oklab, var(--chart-ormas) 45%, transparent);
	}
	.rp-guide :global(.rp-guide-seg[aria-current='true']) {
		background: var(--chart-ormas);
		height: 5px;
	}
	.rp-guide :global(.rp-guide-seg:hover) { background: color-mix(in oklab, var(--chart-ormas) 70%, transparent); }

	.rp-guide-text { grid-column: 1; grid-row: 2; min-width: 0; }
	.rp-guide-eyebrow {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 11px;
		letter-spacing: 0.08em;
		color: var(--chart-ormas);
		margin: 0 0 3px;
	}
	.rp-guide-title { margin: 0 0 4px; font-size: var(--text-body); line-height: 1.25; }
	.rp-guide-body {
		margin: 0;
		font-size: var(--text-small);
		line-height: 1.5;
		color: var(--text-secondary);
		max-width: 92ch;
	}

	/* Fixed column, so Close / Back / Next are in the same pixel at every stop — the thing
	   the reader was hunting for when the card used to move. */
	.rp-guide-foot {
		grid-column: 2;
		grid-row: 2;
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.rp-guide-skip {
		font: inherit;
		font-size: var(--text-small);
		background: none;
		border: 0;
		padding: 0 4px;
		color: var(--text-muted);
		cursor: pointer;
	}
	.rp-guide-skip:hover { color: var(--text-primary); }
	.rp-guide :global(.rp-btn) {
		font: inherit;
		font-size: var(--text-small);
		padding: 9px 20px;
		border: 1px solid var(--border-hairline);
		border-radius: 4px;
		background: var(--bg-surface);
		color: var(--text-primary);
		cursor: pointer;
		white-space: nowrap;
	}
	.rp-guide :global(.rp-btn:disabled) { opacity: 0.35; cursor: default; }
	.rp-guide :global(.rp-btn--primary) {
		background: var(--chart-ormas);
		border-color: var(--chart-ormas);
		color: var(--text-on-dark);
	}

	/* TRAVELLING. The run takes several seconds to cross from one stop to the next, and the
	   first version hid the dock for the whole of it — a dimmed component with no controls,
	   which is indistinguishable from a crash. The dock now stays, says what it is doing, and
	   the live segment fills with the epochs so the wait reads as motion. */
	.rp-guide-live {
		display: none;
		margin-left: 10px;
		padding-left: 10px;
		border-left: 1px solid var(--border-hairline);
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}
	.rp-guide.is-travelling .rp-guide-live { display: inline; }
	.rp-guide.is-travelling .rp-guide-title,
	.rp-guide.is-travelling .rp-guide-body { opacity: 0.45; transition: opacity 200ms ease; }
	.rp-guide.is-travelling :global(.rp-guide-seg[aria-current='true']) {
		background: linear-gradient(
			to right,
			var(--chart-ormas) var(--travel, 0%),
			color-mix(in oklab, var(--chart-ormas) 20%, transparent) var(--travel, 0%)
		);
	}

	/* ONLY WHERE THE GUTTER ACTUALLY FITS IT. A 360px panel needs 24px of clearance from the
	   1280px container and 32px from the viewport edge, so the gutter has to be ≥416px — a
	   viewport of 2112px. At 1920px the gutter is 320px and a side panel would sit on top of
	   the thing it is describing, which is the bug this replaced. */
	@media (min-width: 2120px) {
		.rp-guide:not([hidden]) {
			left: auto;
			right: calc((100vw - 1280px) / 2 - 384px);
			transform: none;
			top: 50%;
			translate: 0 -50%;
			bottom: auto;
			width: 360px;
			grid-template-columns: 1fr;
			row-gap: 14px;
		}
		.rp-guide-text, .rp-guide-foot { grid-column: 1; }
		.rp-guide-foot { grid-row: 3; justify-content: space-between; }
	}

	@media (max-width: 760px) {
		.rp-guide:not([hidden]) {
			grid-template-columns: 1fr;
			bottom: 8px;
			width: calc(100vw - 16px);
			padding: 12px 14px 14px;
		}
		.rp-guide-text, .rp-guide-foot { grid-column: 1; }
		.rp-guide-foot { grid-row: 3; justify-content: space-between; }
		.rp-guide-body {
			font-size: 13px;
			display: -webkit-box;
			-webkit-line-clamp: 4;
			line-clamp: 4;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.rp.is-guided .rp-panes,
		.rp.is-guided .rp-chart,
		.rp.is-guided .rp-ledger,
		.rp.is-guided .rp-verdict,
		.rp.is-guided .rp-bar { transition: none; }
		.rp-guide :global(.rp-guide-seg) { transition: none; }
	}

	.rp-verdict { padding: 0; }

	.rp-verdict-table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed;
		margin-top: var(--space-sm);
	}

	.rp-verdict-table thead th {
		text-align: left;
		padding: 0 12px 7px;
		font-size: var(--text-eyebrow);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--fg-dim);
		font-weight: 600;
		border-bottom: 1px solid var(--border-strong);
	}
	.rp-verdict-table thead th:first-child { padding-left: 0; width: 30%; }
