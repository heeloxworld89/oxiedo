---
// THE HERO SYSTEM — rewritten 2026-09-07. Replaces a three-panel strip (network · record ·
// markets) that diagrammed the SITE'S SECTIONS rather than the product, on a 1200x560 artboard
// too short to sit beside anything.
//
// WHAT IT ARGUES, in one frame:
//
//   LEFT      A standard network, ghosted. Same node count, no structure you can address. A "?"
//             where a name would be. This is the industry today: not opaque, UNNAMEABLE.
//
//   RIGHT     ORMAS as concentric rings, built outward from the one architectural decision:
//               core    the bounded 4-operation chain — the primitive
//               ring 1  the six capabilities the primitive makes possible
//               ring 2  the seven use cases, each a combination of those capabilities
//               ring 3  the five markets, each entering through one lead feature
//
// THE CONNECTORS ARE REAL DATA, not decoration. Every chord from a feature to a capability is a
// row of the capability matrix (Commercial Plan `03 §3`), read straight out of data/features.ts.
// Every market line runs to that market's own primaryFeature in data/sectors.ts. Add a feature
// or change a capability in the data and this diagram redraws itself correctly — it cannot go
// out of step with the pages, because it is drawn from the same source they are.
//
// That is also the argument the picture is making: the web in the middle IS the reason seven
// features are one product. You can see them sharing capabilities.
//
// MOTION. One build-outward pass of ~3.2s — core, capabilities, matrix, features, markets — then
// it rests on a complete, still-legible diagram. Not a loop: ui_ux/00 §3 forbids looping
// decoration, and once the diagram has explained itself there is nothing left to animate.
//
// NO JS, NO EXTERNAL ASSETS. Pure CSS keyframes with staggered delays and fill-mode: forwards,
// so it renders identically with JavaScript disabled (Law 3). prefers-reduced-motion jumps
// straight to the final state. Every colour is a token.
import { features } from '../data/features';
import { sectors } from '../data/sectors';

// THREE COLUMNS, 2026-09-09. The artboard was 1400x900 with the ghost squeezed into a narrow left
// strip and the ring taking everything else, so the figure had no room either side and the page
// capped it at .container width on top of that. It is now 1760 wide and genuinely three-column:
// what today costs on the LEFT, the system in the CENTRE, what replaces it on the RIGHT. The two
// side columns are the argument; the ring is the evidence for it.
const W = 820;
const H = 820;

// The radial system sits right of the ghost; these were chosen so the outermost market pills
// clear the divider on the left and the artboard edge on the right.
const CX = 410;
const CY = 410;

const R_CORE = 76;
const R_CAPS = 130;
const R_FEAT = 212;
const R_MKT = 300;


const CHIP_W = 152;
const CHIP_H = 34;
// 192 rather than 178: "Defense & Safety-Critical" is 25 characters, which at 11px JetBrains
// Mono is ~165px and left only 6px of padding a side. Widening keeps the label whole rather than
// shortening a name the rest of the site spells out in full.
const PILL_W = 192;
const PILL_H = 30;

/* ── THE RINGS ARE TILTED PLANES, AND THEY ARE STACKED ───────────────────────────
   Flat concentric circles say "these things are arranged around that thing". Tilting
   the plane and lifting each ring says what the diagram actually argues: the
   primitive is the apex and everything else is built outward AND downward from it.
   Same data, same chords, one more true statement.

   THE PROJECTION IS BAKED AT BUILD TIME, not applied in the browser. This component's
   own rules are "renders identically with JavaScript disabled (Law 3)" and no looping
   decoration, and both survive: the geometry arrives already three-dimensional in the
   markup, the existing one-pass build animation is untouched, and nothing rotates on
   a timer. The only motion added is a tilt that answers the pointer, which is a
   response rather than an animation — at rest the figure is still.

   ORTHOGRAPHIC, not perspective. A perspective divide turns the ring guides into
   shapes SVG has no primitive for, and they would have to become paths that no longer
   match the projected chip positions exactly. Under an orthographic tilt a circle is
   exactly an ellipse, so the guides stay <ellipse> and every point on them lands where
   the geometry says it does. Depth is carried by scale and opacity instead, which is
   what the eye reads first anyway.

   x is untouched by the tilt, so the horizontal extent — the one dimension with no
   room left, with 192px pills reaching 396 of the 410 half-width — cannot change. */
const TILT = 46 * (Math.PI / 180);
const CT = Math.cos(TILT);
const ST = Math.sin(TILT);

/** Height of each ring above the base plane. The core is the apex. */
const Z_MKT = 0;
const Z_FEAT = 20;
const Z_CAPS = 44;
const Z_CORE = 70;

/** A point on a ring plane, projected. `dep` runs -1 (far) to +1 (near). */
const at = (r: number, a: number, z: number) => {
	const fx = r * Math.cos(a);
	const fy = r * Math.sin(a);
	return {
		x: CX + fx,
		y: CY + fy * CT - z * ST,
		a,
		dep: r === 0 ? 0 : fy / r,
	};
};

// Angles run clockwise from the top, so the first item in each ring reads at 12 o'clock
// — which after the tilt is also the far side, so the ring opens towards the reader.
const pos = (r: number, i: number, n: number, z: number) =>
	at(r, ((i / n) * 360 - 90) * (Math.PI / 180), z);

/** Nearer reads slightly larger and slightly brighter. Both kept gentle: this is a
 *  depth cue, and a label that shrinks enough to notice is a label that got harder to
 *  read in exchange for an effect. */
const depthScale = (dep: number) => (1 + dep * 0.055).toFixed(4);
const depthFade = (dep: number) => (0.78 + ((dep + 1) / 2) * 0.22).toFixed(3);

const CAP_ORDER = ['ACCOUNT', 'PROTECT', 'REPAIR', 'DETECT', 'ISOLATE', 'SUPPRESS'] as const;

/* ── THE CAPABILITY LABELS ARE PLACED BY SOLVING, NOT BY RULE ────────────────────
   Flat, a fixed 28px along the radius cleared everything. Tilted, it does not: the
   radial step keeps its full width in x but is squashed to 0.695 of itself in y, so
   labels walk sideways into the feature chips instead of stepping clear of them.
   Measured after the tilt: five of six overlapped a chip, against none before.

   A single better rule does not exist either. PROTECT and SUPPRESS each sit 8.6° from
   a feature chip — six capabilities against seven features will always put some pair
   close — so "push away from the centre" fixes the ones at the sides and drives those
   two straight into the chip above them.

   So each label tries a ring of candidate offsets and takes the first that hits
   nothing. It runs at build time, it is deterministic, and because the whole diagram
   is generated from data/features.ts and data/sectors.ts it keeps working when a
   feature is added or a capability renamed — which a hand-tuned offset per label
   would not. The estimate is conservative: mono at 11px is close enough to 6.9px a
   character, and the check below in the browser measures the real thing. */
const CAP_FONT_W = 6.9;
const CAP_H = 13;

interface Box { l: number; r: number; t: number; b: number }
const boxOf = (cx: number, cy: number, w: number, h: number): Box =>
	({ l: cx - w / 2, r: cx + w / 2, t: cy - h / 2, b: cy + h / 2 });
/* A NEGATIVE PAD: the boxes are GROWN before testing, not shrunk. A solver that
   tests for bare contact places labels one pixel clear of a chip, which is a
   collision to every eye that is not a bounding-box comparison. 5px of air. */
const overlaps = (p1: Box, p2: Box, air = 5) =>
	p1.r + air > p2.l && p1.l - air < p2.r && p1.b + air > p2.t && p1.t - air < p2.b;

const capRaw = CAP_ORDER.map((name, i) => ({ name, ...pos(R_CAPS, i, CAP_ORDER.length, Z_CAPS) }));
const featRaw = features.map((f, i) => ({ feature: f, ...pos(R_FEAT, i, features.length, Z_FEAT) }));
const mktRaw = sectors.map((s, i) => ({ sector: s, ...pos(R_MKT, i, sectors.length, Z_MKT) }));

const obstacles: Box[] = [
	...featRaw.map((f) => boxOf(f.x, f.y, CHIP_W, CHIP_H)),
	...mktRaw.map((m) => boxOf(m.x, m.y, PILL_W, PILL_H)),
	/* The core's FULL box. Shrinking it to 0.78 to approximate the ellipse was wrong
	   at the one place it mattered: an ellipse touches its bounding box at the top
	   centre, which is exactly where ACCOUNT sits, and the solver cheerfully placed
	   it 36px across the disc's crown. Narrower than the box at the corners is a
	   tolerable loss; overlapping the apex is not. */
	boxOf(CX, CY - Z_CORE * ST, R_CORE * 2, R_CORE * CT * 2),
];

/** Tried in order: straight out, straight in, the two verticals, then the diagonals,
 *  at two distances. The first clear one wins; if none is, the last is used and the
 *  browser check will say so rather than this failing silently. */
const CAP_TRIES: Array<[number, number]> = [
	[0, 1], [0, -1], [1, 0], [-1, 0],
	[0.7, 0.7], [-0.7, 0.7], [0.7, -0.7], [-0.7, -0.7],
];

const capPts = capRaw.map((c) => {
	const w = c.name.length * CAP_FONT_W;
	const vy = c.y - (CY - Z_CAPS * ST);
	const away = vy === 0 ? 1 : Math.sign(vy);
	let lx = c.x;
	let ly = c.y + away * 20;
	for (const dist of [20, 28, 36, 46, 58]) {
		let done = false;
		for (const [ux, uy] of CAP_TRIES) {
			// Prefer moving away from the centre vertically: that is where the room is.
			const tx = c.x + ux * dist;
			const ty = c.y + uy * dist * away;
			if (!obstacles.some((o) => overlaps(boxOf(tx, ty, w, CAP_H), o))) {
				lx = tx; ly = ty; done = true; break;
			}
		}
		if (done) break;
	}
	return { ...c, lx, ly: ly + 4 };
});

const featPts = featRaw;
const mktPts = mktRaw;

/* Painter's order. With the plane tilted, a near chip genuinely overlaps a far one, and
   source order would put the far one on top. Sorted copies: the originals stay in data
   order, because the chords look features up by id and the reader of this file should
   not have to know that the render order is a lie. */
const featDraw = [...featPts].sort((p, q) => p.dep - q.dep);
const mktDraw = [...mktPts].sort((p, q) => p.dep - q.dep);

// THE MATRIX, as chords. Each is one cell of Commercial Plan `03 §3`. They are drawn first and
// the core disc is painted over them, so a chord between two near-opposite points reads as
// passing behind the primitive rather than through it.
const chords = featPts.flatMap((fp) =>
	fp.feature.capabilities
		.map((cap) => capPts.find((c) => c.name === cap))
		.filter((c): c is NonNullable<typeof c> => Boolean(c))
		.map((c) => {
			const from = at(R_FEAT - CHIP_H / 2 - 4, fp.a, Z_FEAT);
			return {
				key: `${fp.feature.id}-${c.name}`,
				aa: fp.a, ba: c.a,
				x1: from.x, y1: from.y, x2: c.x, y2: c.y,
			};
		})
);

// Each market enters through one feature. Two markets lead with The Diary, so two lines converge
// on it — that convergence is true and worth seeing.
const entries = mktPts
	.map((mp) => {
		const target = featPts.find((fp) => fp.feature.id === mp.sector.primaryFeature);
		if (!target) return null;
		const from = at(R_MKT - PILL_H / 2 - 4, mp.a, Z_MKT);
		const to = at(R_FEAT + CHIP_H / 2 + 4, target.a, Z_FEAT);
		return {
			key: mp.sector.id,
			aa: mp.a, ba: target.a,
			x1: from.x, y1: from.y, x2: to.x, y2: to.y,
		};
	})
	.filter((e): e is NonNullable<typeof e> => Boolean(e));

// The four bounded operations, as a 2x2 inside the core disc.
const ops = ['LayerNorm', 'Linear ↓', 'PReLU', 'Linear ↑'];

// The ghost. Same node count as the ORMAS side's inner structure, deliberately — the point is
// not that the standard network is smaller, it is that none of it can be addressed.
const GX = 232;
const GY = 268;
const GS = 0.84; // ghost scale — the mesh is a motif, the numbers under it are the argument
// Scaled up ~1.3x from the first draft: at the previous size the ghost occupied under half its
// own panel and read as an afterthought rather than as the other half of the comparison.
// THE COST OF THE LEFT-HAND PICTURE, added 2026-09-09. The standard-network panel argued its
// point in the abstract — a tangled graph and a question mark — and left the bottom third of its
// column empty. These are the published numbers that make the abstraction concrete, and they are
// other people's measurements rather than ours, which is why they belong on the failure side.
//   · MTTF collapses with cluster size: 7.9h at 1,024 GPUs, 1.8h at 16,384.
//   · Llama 3: 419 unexpected interruptions across a 54-day run, ~8 a day.
//   · Failures hit 0.2% of jobs and consume 18.7% of total runtime, because the long jobs are the
//     ones that fail and each failure discards everything since the last checkpoint.
// The fourth row is ours and is the turn: none of that tells you WHICH PART broke.
// The answer to the last failure row, in our own measured numbers. Placed on the ORMAS side
// because the left column asks the question and this is the reply: the same collapse, the same
// task shift, and the one thing a loss curve cannot do.
// WHAT IT BUYS, in the buyer's terms rather than ours. Every row is an established property or a
// published result — nothing here depends on the source-attribution study that has not run yet.
//   1 epoch  — defence market evidence: damage diagnosed within one epoch and repaired through 85
//              individually attributed structural corrections.
//   Native   — the record is a by-product of the backward pass, not a report assembled afterwards.
//   Same     — /technology: what ships is one network of unchanged shape and unchanged inference
//              cost, so nothing is paid for capability that is not being used.
//   Bounded  — every correction is capped as a fraction of the component's own weight and logged.
// SVG text does not wrap, so every label is broken into explicit lines sized to the column. At
// 14px mono the column takes 40 characters; anything longer silently ran through the divider,
// which is what made the middle line look like a rendering fault.
// PAIRED ROW FOR ROW with failureRows below. This is the fix for the fault that made the two
// columns unreadable together: the left stated the problem in money and the right answered in
// architecture, so nothing connected "$100k+ per erasure request" to "Native". Row N on the right
// now answers row N on the left, and the CSS holds them on a shared baseline.
//
// ONE ROW WAS SWAPPED OUT TO KEEP THIS HONEST. The erasure cost is the strongest number here, but
// its real answer — telling you which data a component absorbed — is the source-attribution study
// that has not run yet. Claiming it in the hero would be exactly the overclaim the rest of the
// site refuses. The interruption count replaces it, and every right-hand row below is either a
// published result or a property of the architecture.
// PAIRED ROW FOR ROW with failureRows, and written for someone who has never trained a model.
// The previous version read "1 epoch · Per node · Native · Bounded" — four researcher words that
// require a glossary before they answer anything. Someone deciding whether to spend $15M should
// not have to learn what an epoch is to see why the number changes. Same claims, plain English:
//   Keep the run   — damage diagnosed within one epoch and repaired through attributed structural
//                    corrections, so the run is not discarded back to the last checkpoint.
//   No mystery     — per-node attribution: each failure is traceable to a component.
//   Proof, not     — the record is a by-product of the backward pass, which is what Article 12
//   paperwork        asks a high-risk system to be capable of producing.
//   It can change  — every correction is capped as a fraction of the component's own weight and
//                    logged, which is the shape of evidence a change-control plan requires.
// PAIRED ROW FOR ROW with failureRows, in plain English, and length-matched to it. The right
// column previously ran ~20 characters longer per row, which pushed it a line taller than the
// left on every row — so the paired rows drifted apart and the column overran the band it sits in.
// Both sides now sit at roughly 55 characters.
//
// ONE ROW WAS SWAPPED OUT TO KEEP THIS HONEST: the erasure cost is the strongest number here, but
// its real answer — which data a component absorbed — is the source-attribution study that has not
// run. Claiming it in the hero would be the overclaim the rest of the site refuses.
const resultRows = [
	{ figure: 'Keep the run', unit: '', body: 'Names the component that failed, so it is repaired rather than the run rerun.' },
	{ figure: 'No mystery', unit: '', body: 'Every stop arrives with its cause named, not a guess.' },
	{ figure: 'Proof, built in', unit: '', body: 'The evidence a regulator wants, written as it learns.' },
	{ figure: 'It can change', unit: '', body: 'Every change capped and logged against a limit declared in advance.' },
];

// WHAT IT COSTS TODAY — money and exposure, each from that market's sourced evidence in
// data/markets.ts, written to land without any background in machine learning.
const failureRows = [
	{ figure: '$15M', unit: '', body: 'Of computing burned on one training run that failed.' },
	{ figure: '419', unit: '', body: 'Times that run stopped in 54 days. Nobody knew why.' },
	{ figure: '7', unit: '%', body: 'Of worldwide revenue. The EU fine ceiling, from August 2026.' },
	{ figure: '92', unit: '%', body: 'Of approved medical AI can never be updated at all.' },
];

const ghostNodes = [
	[-96, -99], [5, -125], [101, -91],
	[-125, 0], [-18, -18], [86, 8],
	[-91, 96], [13, 120], [107, 91],
];
const ghostEdges: [number, number][] = [
	[0, 1], [1, 2], [0, 3], [0, 4], [1, 4], [2, 4], [2, 5],
	[3, 4], [4, 5], [3, 6], [4, 6], [4, 7], [4, 8], [5, 8], [6, 7], [7, 8],
];
---

{/* aria-label, NOT <title>. An SVG <title> is the accessible name AND a native browser tooltip, so
    the label followed the cursor around the hero and sat on top of the diagram it was describing.
    aria-label gives assistive tech the same name with no tooltip; the long description stays in
    <desc>, referenced by aria-describedby. The <title> elements on /technology's chart bars are
    deliberate and stay — there, the tooltip is the feature. */}
<div class="hero-fig">
	<div class="hero-fig-ask">
		<p class="hero-fig-ask-label">Five sectors. One question about data, asked five ways.</p>
		<ul class="hero-fig-questions">
			{sectors.map((sec) => (
				<li>
					<span class="hero-fig-q-market">{sec.name}</span>
					<span class="hero-fig-q-text">{sec.question}</span>
				</li>
			))}
		</ul>
		<p class="hero-fig-ask-answer">
			Nothing in a standard network can answer any of them. Not because a standard network is opaque, but because
			no part of it can be named.
		</p>
	</div>

	<div class="hero-fig-body">
		<section class="hero-fig-col">
			<p class="hero-fig-col-title">What that costs today</p>
			<dl class="hero-fig-stats">
				{failureRows.map((r) => (
					<div>
						<dt><span class="hero-fig-num">{r.figure}</span><span class="hero-fig-unit">{r.unit}</span></dt>
						<dd>{r.body}</dd>
					</div>
				))}
			</dl>
			<p class="hero-fig-src">Published figures · one per industry</p>
		</section>

		<figure class="hero-visual">
			<svg
				data-hv-svg
				viewBox={`0 0 ${W} ${H}`}
				role="img"
				aria-label="ORMAS as one system"
				aria-describedby="hv-desc"
				preserveAspectRatio="xMidYMid meet"
			>
				<desc id="hv-desc">
					ORMAS drawn as four concentric rings built outward from one architectural decision — a
					bounded four-operation chain at the centre, then the six capabilities that decision makes
					possible, then the seven features, each connected to the capabilities it is built from,
					then the five sectors, each connected to the feature it enters through.
				</desc>
{/* ring guides */}
		{/* Each guide is its ring's plane seen edge-on-ish: an exact ellipse, lifted by
		    that ring's own height. Three of them at three heights is what makes the
		    structure read as tiers rather than as one flat target. */}
		{/* data-r / data-z is this element's place on the tilted plane. The build bakes
		    one camera into x/y so the figure is three-dimensional with JavaScript off;
		    the model script re-solves the same numbers every frame once it mounts. One
		    source of geometry, two renderers. */}
		<g class="hv-guides">
			<ellipse data-ring data-r={R_CAPS} data-z={Z_CAPS} cx={CX} cy={CY - Z_CAPS * ST} rx={R_CAPS} ry={R_CAPS * CT} class="hv-guide hv-stage-caps" />
			<ellipse data-ring data-r={R_FEAT} data-z={Z_FEAT} cx={CX} cy={CY - Z_FEAT * ST} rx={R_FEAT} ry={R_FEAT * CT} class="hv-guide hv-stage-feat" />
			<ellipse data-ring data-r={R_MKT} data-z={Z_MKT} cx={CX} cy={CY - Z_MKT * ST} rx={R_MKT} ry={R_MKT * CT} class="hv-guide hv-stage-mkt" />
		</g>

		{/* the capability matrix, drawn behind the core */}
		<g class="hv-matrix hv-stage-matrix">
			{chords.map((c) => (
				<line
					data-chord={c.key}
					data-ar={R_FEAT - CHIP_H / 2 - 4} data-aa={c.aa} data-az={Z_FEAT}
					data-br={R_CAPS} data-ba={c.ba} data-bz={Z_CAPS}
					x1={c.x1} y1={c.y1} x2={c.x2} y2={c.y2} class="hv-chord"
				/>
			))}
		</g>

		{/* market entry lines */}
		<g class="hv-entries hv-stage-mkt">
			{entries.map((e) => (
				<line
					data-chord={e.key}
					data-ar={R_MKT - PILL_H / 2 - 4} data-aa={e.aa} data-az={Z_MKT}
					data-br={R_FEAT + CHIP_H / 2 + 4} data-ba={e.ba} data-bz={Z_FEAT}
					x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class="hv-entry"
				/>
			))}
		</g>

		{/* CORE · the primitive. Painted over the chords. */}
		{/* THE APEX. The disc is the primitive's own plane, lifted clear of the rings and
		    tilted with them; the four operation boxes stand upright on it, because type
		    laid into the plane would be type read at 46 degrees. */}
		<g class="hv-core hv-stage-core">
			<ellipse data-ring data-r={R_CORE} data-z={Z_CORE} cx={CX} cy={CY - Z_CORE * ST} rx={R_CORE} ry={R_CORE * CT} class="hv-core-disc" />
			<ellipse data-ring data-r={R_CORE} data-z={Z_CORE} cx={CX} cy={CY - Z_CORE * ST} rx={R_CORE} ry={R_CORE * CT} class="hv-core-ring" />
			{ops.map((op, i) => {
				const col = i % 2;
				const row = i < 2 ? 0 : 1;
				const bx = CX - 60 + col * 62;
				const by = CY - Z_CORE * ST - 30 + row * 28;
				return (
					<g>
						<rect x={bx} y={by} width="58" height="25" rx="4" class="hv-op-box" />
						<text x={bx + 29} y={by + 17} text-anchor="middle" class="hv-op-text">{op}</text>
					</g>
				);
			})}
			<text x={CX} y={CY - Z_CORE * ST + R_CORE * CT + 16} text-anchor="middle" class="hv-core-caption">4 BOUNDED OPS</text>
		</g>

		{/* RING 1 · the six capabilities */}
		<g class="hv-caps hv-stage-caps">
			{capPts.map((c) => (
				<>
					<circle data-node data-r={R_CAPS} data-a={c.a} data-z={Z_CAPS} cx={c.x} cy={c.y} r="4" class="hv-cap-dot" />
					<text
						data-node data-label data-r={R_CAPS} data-a={c.a} data-z={Z_CAPS}
						data-ox={c.lx - c.x} data-oy={c.ly - c.y}
						x={c.lx} y={c.ly} text-anchor="middle" class="hv-cap-text"
					>{c.name}</text>
				</>
			))}
		</g>

		{/* RING 2 · the seven features */}
		<g class="hv-feats hv-stage-feat">
			{featDraw.map((fp) => (
				<g data-card data-r={R_FEAT} data-a={fp.a} data-z={Z_FEAT} data-w={CHIP_W} data-h={CHIP_H}
					data-id={fp.feature.id} style={`opacity:${depthFade(fp.dep)}`}>
					<rect
						x={fp.x - CHIP_W / 2}
						y={fp.y - CHIP_H / 2}
						width={CHIP_W}
						height={CHIP_H}
						rx="6"
						class="hv-chip"
					/>
					<text x={fp.x} y={fp.y + 5} text-anchor="middle" class="hv-chip-text">{fp.feature.name}</text>
				</g>
			))}
		</g>

		{/* RING 3 · the five markets */}
		<g class="hv-mkts hv-stage-mkt">
			{mktDraw.map((mp) => (
				<g data-card data-r={R_MKT} data-a={mp.a} data-z={Z_MKT} data-w={PILL_W} data-h={PILL_H}
					data-id={mp.sector.id} style={`opacity:${depthFade(mp.dep)}`}>
					<rect
						x={mp.x - PILL_W / 2}
						y={mp.y - PILL_H / 2}
						width={PILL_W}
						height={PILL_H}
						rx="15"
						class="hv-pill"
					/>
					<text x={mp.x} y={mp.y + 4} text-anchor="middle" class="hv-pill-text">{mp.sector.name}</text>
				</g>
			))}
		</g>
			</svg>
			<figcaption class="hero-fig-legend">
				<span>One primitive · six capabilities · seven features · five sectors</span>
				{/* Unhidden by the model script, so it only ever promises what is live. */}
				<span class="hero-fig-drive" data-hv-hint hidden>Drag to turn · scroll to open it up</span>
			</figcaption>
		</figure>

		<section class="hero-fig-col">
			<p class="hero-fig-col-title hero-fig-col-title--lit">What replaces it</p>
			<dl class="hero-fig-stats hero-fig-stats--lit">
				{resultRows.map((r) => (
					<div>
						<dt><span class="hero-fig-num">{r.figure}</span><span class="hero-fig-unit">{r.unit}</span></dt>
						<dd>{r.body}</dd>
					</div>
				))}
			</dl>
			<p class="hero-fig-src">Built in, not bolted on</p>
		</section>
	</div>
</div>

<script>
	/* ── THE SYSTEM, AS A MODEL YOU CAN TURN ─────────────────────────────────────
	 * The build bakes one camera into the SVG so the figure is three-dimensional
	 * with JavaScript off — that is this component's Law 3 and it still holds. This
	 * re-solves the same geometry every frame and gives it back to the SAME
	 * elements, so there is one source of truth for the shape and one set of DOM
	 * nodes for it. Nothing is duplicated and nothing is drawn twice.
	 *
	 * WHY THE SVG AND NOT A CANVAS OR WebGL. The eighteen labels here are the seven
	 * product names and the five sector names — navigational content, not
	 * decoration. Painted into a canvas they stop being text: no find-in-page, no
	 * translation, no screen reader, no selection. The research on hybrid
	 * renderers is unanimous that geometry belongs in the fast layer and text
	 * belongs in the DOM, and here the whole diagram is small enough — about forty
	 * elements — that the DOM can carry all of it at sixty frames.
	 *
	 * WHAT IT DOES. Drag turns it. Scrolling past opens the tiers apart, which is
	 * the exploded view the reader gets for free by doing the one thing they were
	 * going to do anyway. Hovering a feature lights the capabilities it actually
	 * consumes — that is a row of the capability matrix, read from the data.
	 *
	 * prefers-reduced-motion: it never moves on its own and never opens on scroll.
	 * It still turns if a reader drags it, because that is a response to a request.
	 */
	const TILT_BASE = 46 * (Math.PI / 180);

	function mountHeroModel() {
		const svg = document.querySelector<SVGSVGElement>('[data-hv-svg]');
		if (!svg || svg.dataset.hvLive === '1') return;
		const fig = svg.closest('.hero-fig');
		if (!fig) return;

		const CX = 410;
		const CY = 410;
		const rings = [...svg.querySelectorAll<SVGEllipseElement>('[data-ring]')];
		const nodes = [...svg.querySelectorAll<SVGElement>('[data-node]')];
		const cards = [...svg.querySelectorAll<SVGGElement>('[data-card]')];
		const chords = [...svg.querySelectorAll<SVGLineElement>('[data-chord]')];
		if (!rings.length || !cards.length) return;

		svg.dataset.hvLive = '1';
		const hint = fig.querySelector<HTMLElement>('[data-hv-hint]');
		if (hint) hint.hidden = false;
		fig.classList.add('is-live');

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const num = (el: Element, k: string, d = 0) => {
			const v = Number(el.getAttribute(k));
			return Number.isFinite(v) ? v : d;
		};

		/* Read once. These never change — the shape is fixed, only the camera moves. */
		const ringDefs = rings.map((el) => ({ el, r: num(el, 'data-r'), z: num(el, 'data-z') }));
		const nodeDefs = nodes.map((el) => ({
			el,
			r: num(el, 'data-r'), a: num(el, 'data-a'), z: num(el, 'data-z'),
			ox: num(el, 'data-ox'), oy: num(el, 'data-oy'),
			label: el.hasAttribute('data-label'),
		}));
		const cardDefs = cards.map((el) => ({
			el,
			r: num(el, 'data-r'), a: num(el, 'data-a'), z: num(el, 'data-z'),
			w: num(el, 'data-w'), h: num(el, 'data-h'),
			rect: el.querySelector<SVGRectElement>('rect'),
			text: el.querySelector<SVGTextElement>('text'),
			id: el.getAttribute('data-id') || '',
		}));
		const coreGroup = svg.querySelector<SVGGElement>('.hv-core');
		const Z_CORE_LIFT = 70;

		const chordDefs = chords.map((el) => ({
			el,
			ar: num(el, 'data-ar'), aa: num(el, 'data-aa'), az: num(el, 'data-az'),
			br: num(el, 'data-br'), ba: num(el, 'data-ba'), bz: num(el, 'data-bz'),
			key: el.getAttribute('data-chord') || '',
		}));

		let yaw = 0;
		let pitch = 0;
		let open = 0;           // 0 closed, 1 fully exploded
		let aimYaw = 0;
		let aimPitch = 0;
		let aimOpen = 0;
		let dragging = false;
		let lastX = 0;
		let lastY = 0;
		let hovered = '';

		const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);

		/* One projection, used by everything. `open` pushes the tiers apart along the
		   lift axis — the core rises, the outer ring stays put — which is the exploded
		   view, and it reads as the system coming apart into its layers rather than as
		   a diagram being scaled. */
		const project = (r: number, a: number, z: number) => {
			const tilt = TILT_BASE + pitch;
			const ct = Math.cos(tilt);
			const st = Math.sin(tilt);
			const lift = z * (1 + open * 2.1);
			const fx = r * Math.cos(a + yaw);
			const fy = r * Math.sin(a + yaw);
			return { x: CX + fx, y: CY + fy * ct - lift * st, dep: r === 0 ? 0 : fy / r };
		};

		function frame() {
			yaw += (aimYaw - yaw) * 0.09;
			pitch += (aimPitch - pitch) * 0.09;
			open += (aimOpen - open) * 0.08;

			const tilt = TILT_BASE + pitch;
			const ct = Math.cos(tilt);
			const st = Math.sin(tilt);

			// The core's caption and its four operation boxes sit on the core's plane,
			// so they rise with it when the model opens. Left behind, the primitive
			// lifts off and its own label stays on the floor.
			const coreLift = -Z_CORE_LIFT * (1 + open * 2.1) * st + Z_CORE_LIFT * st;
			if (coreGroup) coreGroup.setAttribute('transform', `translate(0 ${coreLift})`);

			for (const d of ringDefs) {
				d.el.setAttribute('cy', String(CY - d.z * (1 + open * 2.1) * st));
				d.el.setAttribute('ry', String(Math.max(1, d.r * ct)));
			}
			for (const d of nodeDefs) {
				const p = project(d.r, d.a, d.z);
				if (d.label) {
					d.el.setAttribute('x', String(p.x + d.ox));
					d.el.setAttribute('y', String(p.y + d.oy));
				} else {
					d.el.setAttribute('cx', String(p.x));
					d.el.setAttribute('cy', String(p.y));
				}
			}
			/* Painter's order every frame: turning the model changes which chip is in
			   front, and SVG paints in document order, so the order has to be rewritten
			   rather than computed once at build. */
			const sorted = [...cardDefs].map((d) => ({ d, p: project(d.r, d.a, d.z) }))
				.sort((m, n2) => m.p.dep - n2.p.dep);
			for (const { d, p } of sorted) {
				if (d.rect) {
					d.rect.setAttribute('x', String(p.x - d.w / 2));
					d.rect.setAttribute('y', String(p.y - d.h / 2));
				}
				if (d.text) {
					d.text.setAttribute('x', String(p.x));
					d.text.setAttribute('y', String(p.y + (d.h > 32 ? 5 : 4)));
				}
				/* A much wider range than the static figure needed. At rest the labels
				   are solved so none overlaps; once it turns, a far chip WILL pass
				   behind a near one, and the only thing that makes that read as depth
				   rather than as a collision is the far one visibly receding. */
				const near = (p.dep + 1) / 2;
				d.el.style.opacity = String(0.3 + near * 0.7);
				const k = 0.9 + near * 0.16;
				d.el.setAttribute('transform', `translate(${p.x} ${p.y}) scale(${k}) translate(${-p.x} ${-p.y})`);
				d.el.parentNode?.appendChild(d.el);
			}
			for (const d of chordDefs) {
				const a = project(d.ar, d.aa, d.az);
				const b = project(d.br, d.ba, d.bz);
				d.el.setAttribute('x1', String(a.x));
				d.el.setAttribute('y1', String(a.y));
				d.el.setAttribute('x2', String(b.x));
				d.el.setAttribute('y2', String(b.y));
				const lit = hovered !== '' && d.key.startsWith(hovered);
				d.el.classList.toggle('is-lit', lit);
				d.el.classList.toggle('is-dim', hovered !== '' && !lit);
			}
			raf = requestAnimationFrame(frame);
		}

		/* ── turning ─────────────────────────────────────────────────────────────── */
		const onDown = (e: PointerEvent) => {
			dragging = true;
			lastX = e.clientX;
			lastY = e.clientY;
			svg.setPointerCapture(e.pointerId);
			fig.classList.add('is-turning');
		};
		const onMove = (e: PointerEvent) => {
			if (!dragging) return;
			aimYaw += (e.clientX - lastX) * 0.006;
			// Clamped: past about 25 degrees either way the rings pass edge-on and the
			// whole figure collapses to a line.
			aimPitch = clamp(aimPitch + (e.clientY - lastY) * 0.0035, -0.44, 0.34);
			lastX = e.clientX;
			lastY = e.clientY;
		};
		const onUp = (e: PointerEvent) => {
			dragging = false;
			try { svg.releasePointerCapture(e.pointerId); } catch { /* already gone */ }
			fig.classList.remove('is-turning');
		};

		/* ── opening ─────────────────────────────────────────────────────────────
		   Driven by where the figure sits in the viewport, not by a wheel listener:
		   scrolling the page must never be captured by a graphic. */
		const onScroll = () => {
			if (reduced) return;
			const r = fig.getBoundingClientRect();
			const seen = clamp((window.innerHeight - r.top) / (window.innerHeight + r.height), 0, 1);
			aimOpen = clamp((seen - 0.35) / 0.4, 0, 1);
		};

		const feats = [...svg.querySelectorAll<SVGGElement>('.hv-feats [data-card]')];
		for (const g of feats) {
			const id = g.getAttribute('data-id') || '';
			g.addEventListener('pointerenter', () => { hovered = id; });
			g.addEventListener('pointerleave', () => { hovered = ''; });
		}

		svg.addEventListener('pointerdown', onDown);
		svg.addEventListener('pointermove', onMove);
		svg.addEventListener('pointerup', onUp);
		svg.addEventListener('pointercancel', onUp);
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll);
		onScroll();

		let raf = requestAnimationFrame(frame);

		document.addEventListener('astro:before-swap', () => {
			cancelAnimationFrame(raf);
			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('resize', onScroll);
		}, { once: true });
	}

	document.addEventListener('astro:page-load', mountHeroModel);
	if (document.readyState !== 'loading') mountHeroModel();
	else document.addEventListener('DOMContentLoaded', mountHeroModel);
</script>

<style>
	.hero-visual {
		width: 100%;
	}

	/* THE SIZE CAP. width:100% on a 1400x900 artboard inside a wide container drew the diagram at
	   ~1900x1220 — taller than the viewport on its own, before the copy band above it. Capping
	   the HEIGHT against the viewport is the direct control: preserveAspectRatio="xMidYMid meet"
	   then scales the drawing down to fit and centres it, so the whole hero lands on one screen
	   at any window size instead of running off the bottom. */
	.hero-visual svg {
		display: block;
		width: 100%;
		height: auto;
		max-height: min(52vh, 560px);
		overflow: visible;
	}

	/* A 1400-wide artboard scaled into a 390px phone renders 11px labels at 3px — the diagram
	   would be decoration rather than information. It scrolls in its own track instead, at a
	   floor where the type is still readable. ui_ux/00 §2: wide content scrolls inside its own
	   overflow-x container; the page body never scrolls sideways. */
	@media (max-width: 1023px) {
		.hero-visual {
			overflow-x: auto;
			overscroll-behavior-x: contain;
			-webkit-overflow-scrolling: touch;
		}

		.hero-visual svg {
			min-width: 1080px;
		}
	}

	/* ── type ─────────────────────────────────────────────────────────────────────── */
	.hv-panel-label,
	.hv-cap-text,
	.hv-op-text,
	.hv-core-caption,
	.hv-chip-text,
	.hv-pill-text,
	.hv-ghost-caption,
	.hv-legend {
		font-family: 'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
	}

	/* ── left · the ghost ─────────────────────────────────────────────────────────── */
	/* Lifted from 0.16 / 0.30. The ghost is half the argument — it has to be legible enough to be
	   read as a network, not so bright that it competes with the system beside it. */
	.hv-ghost-edge {
		stroke: var(--text-on-dark);
		stroke-width: 1;
		opacity: 0.22;
	}

	.hv-ghost-node {
		fill: none;
		stroke: var(--text-on-dark);
		stroke-width: 1.25;
		opacity: 0.42;
	}

	.hv-ghost-void {
		fill: var(--bg-dark);
		stroke: var(--text-on-dark);
		stroke-width: 1;
		stroke-dasharray: 3 4;
		opacity: 0.4;
	}

	.hv-ghost-mark {
		font-family: 'Fraunces', Georgia, serif;
		font-size: 34px;
		fill: var(--text-on-dark);
		opacity: 0.45;
	}

	.hv-ghost-caption {
		font-size: 12px;
		fill: var(--text-on-dark);
		opacity: 0.5;
	}

	.hv-ghost-caption--key {
		opacity: 0.8;
	}

	/* ── right · rings ────────────────────────────────────────────────────────────── */
	.hv-guide {
		fill: none;
		stroke: var(--text-on-dark);
		stroke-width: 1;
		opacity: 0.09;
	}

	.hv-chord {
		stroke: var(--accent-on-dark);
		stroke-width: 1;
		opacity: 0.22;
	}

	.hv-entry {
		stroke: var(--accent-on-dark);
		stroke-width: 1.25;
		opacity: 0.42;
	}

	.hv-core-disc {
		fill: var(--bg-dark);
	}

	.hv-core-ring {
		fill: none;
		stroke: var(--accent-on-dark);
		stroke-width: 1.5;
		opacity: 0.85;
	}

	.hv-op-box {
		fill: none;
		stroke: var(--accent-on-dark);
		stroke-width: 1;
		opacity: 0.5;
	}

	.hv-op-text {
		font-size: 10px;
		fill: var(--accent-on-dark);
		opacity: 0.95;
	}

	.hv-core-caption {
		font-size: 10px;
		letter-spacing: 0.16em;
		fill: var(--accent-on-dark);
		opacity: 0.75;
	}

	.hv-cap-dot {
		fill: var(--accent-on-dark);
		opacity: 0.9;
	}

	.hv-cap-text {
		font-size: 11px;
		letter-spacing: 0.14em;
		fill: var(--text-on-dark);
		opacity: 0.85;
	}

	.hv-chip {
		fill: var(--bg-dark);
		stroke: var(--text-on-dark);
		stroke-width: 1;
		stroke-opacity: 0.35;
	}

	.hv-chip-text {
		font-size: 11.5px;
		fill: var(--text-on-dark);
		opacity: 0.95;
	}

	.hv-pill {
		fill: var(--bg-dark);
		stroke: var(--accent-on-dark);
		stroke-width: 1;
		stroke-opacity: 0.6;
	}

	.hv-pill-text {
		font-size: 11px;
		fill: var(--accent-on-dark);
	}

	/* ── build-outward, once ──────────────────────────────────────────────────────── */
	.hv-ghost,
	.hv-stage-core,
	.hv-stage-caps,
	.hv-stage-matrix,
	.hv-stage-feat,
	.hv-stage-mkt {
		opacity: 0;
		animation: hv-in 620ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) forwards;
	}
	.hv-stage-core   { animation-delay: 420ms; }
	.hv-stage-caps   { animation-delay: 900ms; }
	.hv-stage-matrix { animation-delay: 1400ms; }
	.hv-stage-feat   { animation-delay: 1900ms; }
	.hv-stage-mkt    { animation-delay: 2500ms; }

	/* the core is the primitive everything else grows from, so it is the one thing that scales in */
	.hv-stage-core {
		transform-box: fill-box;
		transform-origin: center;
		animation-name: hv-in-core;
	}

	@keyframes hv-in {
		from { opacity: 0; }
		to   { opacity: 1; }
	}

	@keyframes hv-in-core {
		from { opacity: 0; transform: scale(0.86); }
		to   { opacity: 1; transform: scale(1); }
	}

	@media (prefers-reduced-motion: reduce) {
		.hv-ghost,
		.hv-stage-core,
		.hv-stage-caps,
		.hv-stage-matrix,
		.hv-stage-feat,
		.hv-stage-mkt {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}

	/* ── THE FIGURE IS A LAYOUT, NOT A DRAWING ────────────────────────────────────────────────
	   Every element here used to be a <text> at an absolute y inside one 1760-wide artboard. That
	   is why each fix broke something else: there was no layout engine, so a column with a tall
	   mesh in it and a column with nothing in it both started their stats at the same hard-coded
	   y, leaving 350px of void on one side. Grid removes the whole class of fault — columns size
	   themselves, text wraps, nothing can cross a divider, and it reflows on a phone for free.
	   The SVG now draws the diagram and nothing else. ─────────────────────────────────────── */
	.hero-fig {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xl);
	}

	/* ── the ask: five buyers, five questions, one missing answer ── */
	.hero-fig-ask-label,
	.hero-fig-col-title,
	.hero-fig-src {
		font-family: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
		font-size: 0.6875rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-on-dark);
		opacity: 0.5;
	}

	.hero-fig-questions {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
		gap: var(--space-md) var(--space-lg);
		list-style: none;
		margin: var(--space-lg) 0 0;
		padding: 0;
	}

	.hero-fig-questions > li {
		padding-top: var(--space-sm);
		border-top: 1px solid rgba(255, 255, 255, 0.14);
	}

	.hero-fig-q-market {
		display: block;
		font-family: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
		font-size: 0.625rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent-on-dark);
		opacity: 0.75;
	}

	.hero-fig-q-text {
		display: block;
		margin-top: 4px;
		font-size: 0.9375rem;
		line-height: 1.35;
		color: var(--text-on-dark);
	}

	.hero-fig-ask-answer {
		margin-top: var(--space-lg);
		max-width: 68ch;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-on-dark);
		opacity: 0.72;
	}

	/* ── the comparison ── */
	.hero-fig-body {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-2xl);
		align-items: start;
	}

	/* Grid cell: min-width:0 or a long label pushes the track wider than its share and squeezes
	   the diagram — the standard grid overflow trap. */
	.hero-fig-col { min-width: 0; }

	.hero-fig-col-title { opacity: 0.6; }
	.hero-fig-col-title--lit { color: var(--accent-on-dark); opacity: 0.9; }

	.hero-fig-stats { margin: var(--space-lg) 0 0; }

	.hero-fig-stats > div {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 7.25rem;
		padding-block: var(--space-md);
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.hero-fig-stats dt {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px;
		font-family: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
		font-weight: 700;
		color: var(--chart-warning-on-dark);
	}

	.hero-fig-stats--lit dt { color: var(--accent-on-dark); }

	.hero-fig-num { font-size: 1.75rem; line-height: 1; }

	/* The cost column holds numbers, which want to be big. The answer column holds short phrases —
	   at 1.75rem "Proof, built in" is 250px against a 230px track, so it gets its own size rather
	   than being shortened until it happens to fit. */
	.hero-fig-stats--lit .hero-fig-num {
		font-size: 1.25rem;
		line-height: 1.25;
	}
	.hero-fig-unit { font-size: 0.9375rem; font-weight: 400; opacity: 0.8; }

	.hero-fig-stats dd {
		margin: 6px 0 0;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--text-on-dark);
		opacity: 0.66;
	}

	.hero-fig-src { margin-top: var(--space-md); opacity: 0.34; }

	/* ── the diagram ── */
	.hero-visual { margin: 0; min-width: 0; }
	.hero-visual svg { display: block; width: 100%; height: auto; }

	/* ── the model's own affordances ─────────────────────────────────────────── */
	/* user-select:none, because a drag is a drag. Without it, pulling the model
	   sideways selects every label it passes and leaves the figure strewn with
