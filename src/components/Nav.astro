---
// design/01 §Navigation Design, design/12 §Navigation. Scroll background and the mobile menu
// toggle are Block 4 (nav.ts) — this component provides markup and states only.
import Button from './Button.astro';

const links = [
	{ href: '/solutions', label: 'Solutions' },
	{ href: '/sectors', label: 'Sectors' },
	{ href: '/licensing', label: 'Licensing' },
	{ href: '/paper', label: 'Paper' },
	{ href: '/insights', label: 'Insights' },
	{ href: '/about', label: 'About' },
];
---

<header class="nav">
	<div class="nav-bar">
		<a href="/" class="nav-wordmark">OXIEDO</a>

		<ul class="nav-links">
			{links.map((link) => (
				<li><a href={link.href} class="nav-link">{link.label}</a></li>
			))}
		</ul>

		<div class="nav-cta">
			<Button variant="secondary" size="small" href="/invest">Invest</Button>
			<Button variant="primary" size="small" href="/contact">Book Now</Button>
		</div>

		<button
			type="button"
			class="nav-hamburger"
			aria-label="Menu"
			aria-expanded="false"
			aria-controls="nav-mobile"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>
	</div>

	<div class="nav-mobile" id="nav-mobile">
		<button type="button" class="nav-mobile-close" aria-label="Close menu">×</button>
		<ul class="nav-mobile-links">
			{links.map((link) => (
				<li><a href={link.href} class="nav-mobile-link">{link.label}</a></li>
			))}
		</ul>
		<div class="nav-mobile-cta">
			<Button variant="primary" fullWidth href="/contact">Book Now</Button>
			<Button variant="secondary" fullWidth href="/invest">Invest</Button>
		</div>
	</div>
</header>
