---
// design/12 §Diagrams — Type 1 Unicode schematic. Maps over data/solutions.ts; no ladder
// content is hardcoded here. See src/data/solutions.ts for the stub-vs-canonical note.
import { solutions } from '../data/solutions';

const order: Array<'available' | 'inbuild' | 'upcoming'> = ['available', 'inbuild', 'upcoming'];
const labels: Record<(typeof order)[number], string> = {
	available: 'AVAILABLE NOW',
	inbuild: 'IN BUILD',
	upcoming: 'UPCOMING',
};
const rule = '━'.repeat(56);

const lines: string[] = [rule];
for (const status of order) {
	const items = solutions.filter((s) => s.status === status);
	if (items.length === 0) continue;
	lines.push(`  ${labels[status]}`);
	for (const item of items) {
		lines.push(`  [ ${item.name.toUpperCase()} ]`);
	}
	lines.push(rule);
}
const schematic = lines.join('\n');
---

<pre class="ladder-schematic"><code>{schematic}</code></pre>
