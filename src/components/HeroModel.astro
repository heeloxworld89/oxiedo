		text-transform: uppercase;
		fill: var(--text-on-dark);
		fill-opacity: 0.6;
	}

	/* ── shells ──────────────────────────────────────────────────────────────── */
	.hm-shell { fill: none; stroke: var(--text-on-dark); stroke-opacity: 0.16; stroke-width: 1; }

	.hm-chord { stroke: var(--accent-on-dark); stroke-opacity: 0.2; stroke-width: 0.8; }
	.hm-entry { stroke: var(--text-on-dark); stroke-opacity: 0.16; stroke-width: 0.8; }
