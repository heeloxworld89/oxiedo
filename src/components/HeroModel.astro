---
/* THE OPENED NODE.
 *
 * WHAT IT ARGUES, in one frame. On the left, a neural network — layers of units,
 * connections, the ordinary thing. One of its units is called out and magnified on
 * the right, and it is open: inside is the bounded four-operation chain, and around
 * that, in shells, everything the bound makes possible — the six capabilities, the
 * seven features, the five sectors.
 *
 * That is the company's sentence as a picture. A standard unit cannot be opened
 * because its gradient path runs through everything downstream and has no fixed
 * length; ORMAS bounds that path to four operations, and a part with a bounded path
 * is a part you can point at. So: open one node and look inside. The page is called
 * The Black Box and this is what opening one looks like.
 *
 * WHY IT REPLACED CONCENTRIC RINGS. Three flat rings said "these things are arranged
 * around that thing", which is true and inert. Shells at different orientations
 * around a nucleus say "this is one object with an interior", which is the claim.
 * Atom visualisers have drawn structure that way for a century because it reads
 * instantly as a thing with an inside.
 *
 * EVERY LINE IS DATA. Each chord from a feature to a capability is a row of the
 * capability matrix in data/features.ts; each sector's line runs to that sector's own
 * primaryFeature in data/sectors.ts. Add a feature and the picture redraws itself
 * correctly, because it is drawn from the files the pages are drawn from.
 *
 * SVG, DRIVEN BY A PROJECTION. The geometry is solved twice: once at build, baking a
 * camera into the markup so the figure is three-dimensional with JavaScript off, and
 * again every frame once the model mounts, into the same elements. The eighteen
 * labels are the product and sector names — navigational content — so they stay real
 * text. Painted into a canvas they would lose find-in-page, translation, selection
 * and every screen reader.
 */
import { features } from '../data/features';
import { sectors } from '../data/sectors';

/* A WIDE ARTBOARD, because the column is wide. The previous figure was 820x820 in a
   container capped by height, so preserveAspectRatio fitted it by the short edge and
   left a third of the frame empty on each side. */
/* SIZED TO THE WORST CASE, MEASURED OVER A FULL TURN. The shells rotate, so the
   silhouette is not the one the build happens to bake — sampled across a rotation the
   drawing reaches x 66..1294 and y -25..529 against a 1240x470 box. It was running 54
   past the right edge, 25 above the top and 59 below, and overflow:visible meant those
   labels were not clipped by the SVG but by the page: "Certified Deletion" behind the
   masthead, "Medical AI" off the side. 12px of margin on the measured extent. */
const W = 1320;
/* Measured, not guessed: the drawing occupies y 15..455 of this box. An artboard
   taller than its content is dead space that the page cannot see and cannot close,
   because preserveAspectRatio centres the whole viewBox — 570 was putting 77px of
   nothing above the figure and 66 below, which read on the page as a gap under the
   paragraph that no margin was responsible for. */
const H = 590;

/* THE MESH IS A SHALLOW HORIZONTAL STRIP NOW, not a third of the frame.
   It is context — "the opened node is one unit of an ordinary network" — and it was
   spending 330 units of width to say that while the subject of the picture made do
   with what was left. Compressed to 220, which buys the node a 400 outer shell in
   place of 340: eighteen percent more room between labels, and the cull has that
   much less to hide. */
const NET_X0 = 34;
const NET_X1 = 252;
/* THE UNIT IS ONE OF THE NETWORK'S OWN NODES, not a marker parked beside them.
   Sixteen pixels to the left of the output layer, it read as a stray ring that had
   missed what it was pointing at, and the whole callout depends on the reader
   believing the magnified object came out of this mesh. Middle node, last layer. */
const SRC = { x: NET_X1, y: 300 };

// The opened node.
const CX = 790;
const CY = 300;
const R_CORE = 76;
/* Wider than the first pass. Eighteen labels on three shells of 118/196/272 bunched
   badly enough that the cull was hiding a third of them at rest, and a hero that
   hides a third of its content at rest is not finished. The artboard is 1240 wide
   and the opened node was only using 540 of it. */
const R_CAPS = 178;
const R_FEAT = 296;
const R_MKT = 400;

const CHIP_W = 146;
const CHIP_H = 28;
const PILL_W = 184;
const PILL_H = 26;

/* ── the camera ─────────────────────────────────────────────────────────────────
   Orthographic. A perspective divide turns a circle into a shape SVG has no
   primitive for, and every ring here has to stay an exact ellipse so the points on
   it land where the geometry says. Depth is carried by scale and opacity, which the
   eye reads first anyway. */
const YAW0 = -0.35;
const PITCH0 = 0.42;

/** Each shell has its OWN orientation. Coplanar rings are a target; rings at
 *  different tilts are an object with an interior, which is the entire point. */
const SHELLS = {
	caps: { tilt: 0.0, roll: 0.0 },
	feat: { tilt: 0.55, roll: 0.42 },
	mkt: { tilt: -0.42, roll: -0.5 },
};

interface P3 { x: number; y: number; z: number }

const rotX = (p: P3, a: number): P3 => ({
	x: p.x,
	y: p.y * Math.cos(a) - p.z * Math.sin(a),
	z: p.y * Math.sin(a) + p.z * Math.cos(a),
});
const rotY = (p: P3, a: number): P3 => ({
	x: p.x * Math.cos(a) + p.z * Math.sin(a),
	y: p.y,
	z: -p.x * Math.sin(a) + p.z * Math.cos(a),
});
const rotZ = (p: P3, a: number): P3 => ({
	x: p.x * Math.cos(a) - p.y * Math.sin(a),
	y: p.x * Math.sin(a) + p.y * Math.cos(a),
	z: p.z,
});

/** A point at angle `a` on a shell of radius `r`, taken through that shell's own
 *  orientation and then through the camera. `dep` runs -1 (far) to +1 (near). */
const onShell = (r: number, a: number, shell: { tilt: number; roll: number }) => {
	let p: P3 = { x: r * Math.cos(a), y: 0, z: r * Math.sin(a) };
	p = rotX(p, shell.tilt);
	p = rotZ(p, shell.roll);
	p = rotY(p, YAW0);
	p = rotX(p, PITCH0);
	return { x: CX + p.x, y: CY + p.y, dep: r === 0 ? 0 : p.z / r };
};

const ring = (r: number, i: number, n: number, shell: { tilt: number; roll: number }) => {
	const a = ((i / n) * 360 - 90) * (Math.PI / 180);
	return { a, ...onShell(r, a, shell) };
};

const CAP_ORDER = ['ACCOUNT', 'PROTECT', 'REPAIR', 'DETECT', 'ISOLATE', 'SUPPRESS'] as const;

const capPts = CAP_ORDER.map((name, i) => ({ name, ...ring(R_CAPS, i, CAP_ORDER.length, SHELLS.caps) }));
const featPts = features.map((f, i) => ({ feature: f, ...ring(R_FEAT, i, features.length, SHELLS.feat) }));
const mktPts = sectors.map((s, i) => ({ sector: s, ...ring(R_MKT, i, sectors.length, SHELLS.mkt) }));

/* THE MATRIX, as chords: one per cell of the capability matrix. */
const chords = featPts.flatMap((fp) =>
	fp.feature.capabilities
		.map((cap) => capPts.find((c) => c.name === cap))
		.filter((c): c is NonNullable<typeof c> => Boolean(c))
		.map((c) => ({
			key: `${fp.feature.id}-${c.name}`,
			fa: fp.a, ca: c.a,
			x1: fp.x, y1: fp.y, x2: c.x, y2: c.y,
		})),
);

/* Each sector enters through one feature. Two lead with The Diary, so two lines
   converge on it — that convergence is true and worth seeing. */
const entries = mktPts
	.map((mp) => {
		const target = featPts.find((fp) => fp.feature.id === mp.sector.primaryFeature);
		if (!target) return null;
		return { key: mp.sector.id, ma: mp.a, fa: target.a, x1: mp.x, y1: mp.y, x2: target.x, y2: target.y };
	})
	.filter((e): e is NonNullable<typeof e> => Boolean(e));

/* ── the network on the left ──────────────────────────────────────────────────
   Four layers, drawn small and dim. It is context, not the subject: it says the
   opened node is one unit of an ordinary network rather than a diagram floating on
   its own. */
const NET_LAYERS = [3, 5, 5, 3];
const netNodes = NET_LAYERS.map((count, li) => {
	const x = NET_X0 + (li / (NET_LAYERS.length - 1)) * (NET_X1 - NET_X0);
	const span = 26 + count * 17;
	return Array.from({ length: count }, (_, k) => ({
		x,
		y: CY + (count === 1 ? 0 : (k / (count - 1) - 0.5) * span),
	}));
});
const netEdges = netNodes.flatMap((layer, li) =>
	li === netNodes.length - 1
		? []
		: layer.flatMap((a, ai) =>
			netNodes[li + 1].map((b, bi) => ({ key: `${li}-${ai}-${bi}`, l: li, x1: a.x, y1: a.y, x2: b.x, y2: b.y })),
		),
);

const ops = ['LayerNorm', 'Linear ↓', 'PReLU', 'Linear ↑'];

/* ── WHAT EACH THING IS, FOR THE PANEL THAT OPENS WHEN IT IS CLICKED ───────────
   Read from data/features.ts and data/sectors.ts, the same files the pages use, so
   a panel cannot say something the feature's own page contradicts. The capability
   panels are derived rather than written: a capability IS the set of features that
   consume it, and that set is the capability matrix. */
interface Panel {
	id: string;
	kind: 'feature' | 'sector' | 'capability';
	name: string;
	question: string;
	body: string;
	meta: string;
	href?: string;
}

const panels: Panel[] = [
	...features.map((f) => ({
		id: `p-${f.id}`,
		kind: 'feature' as const,
		name: f.name,
		question: f.question,
		body: f.summary,
		meta: `Needs: ${f.requires}`,
		href: `/product/${f.id}`,
	})),
	...sectors.map((sec) => ({
		id: `p-${sec.id}`,
		kind: 'sector' as const,
		name: sec.name,
		question: sec.question,
		body: sec.cost,
		meta: `Enters through ${features.find((f) => f.id === sec.primaryFeature)?.name ?? '—'}`,
		href: `/sectors/${sec.id}`,
	})),
	/* A CAPABILITY IS NOT WRITTEN ANYWHERE, so it is not written here either. There is
	   no prose for the six in data/, and a definition composed for a tooltip would be
	   a claim about the architecture that nothing in the archive backs. What a
	   capability demonstrably IS, from the data alone, is the set of features that use
	   it and the sectors those features are the way into — so the panel says that, and
	   sends the reader to a page that does have the prose. */
	...CAP_ORDER.map((cap) => {
		const users = features.filter((f) => f.capabilities.includes(cap));
		const reach = sectors.filter((sec) => users.some((f) => f.id === sec.primaryFeature));
		return {
			id: `p-cap-${cap.toLowerCase()}`,
			kind: 'capability' as const,
			name: cap,
			question: 'One of the six capabilities the bounded chain makes possible.',
			body: users.length === 1
				? `Used by one of the seven features: ${users[0].name}.`
				: `Used by ${users.length} of the seven features: ${users.map((f) => f.name).join(', ')}.`,
			meta: reach.length
				? `Reaches ${reach.map((sec) => sec.name).join(' · ')}`
				: 'No sector enters through it directly.',
			href: '/technology',
		};
	}),
];

const fmtDep = (d: number) => (0.34 + ((d + 1) / 2) * 0.66).toFixed(3);
---

<figure class="hm" data-hm>
	<svg
		data-hm-svg
		viewBox={`0 0 ${W} ${H}`}
		role="img"
		aria-labelledby="hm-title"
		aria-describedby="hm-desc"
		preserveAspectRatio="xMidYMid meet"
	>
		<title id="hm-title">One node of a neural network, opened</title>
		<desc id="hm-desc">
			A neural network on the left. One of its units is magnified on the right and shown open:
			at its centre the bounded four-operation chain — LayerNorm, Linear down, PReLU, Linear up
			— and around it three shells carrying the six capabilities the bound makes possible, the
			seven features built from those capabilities, and the five sectors each feature serves.
			Lines between the shells are the capability matrix and each sector's lead feature.
		</desc>

		{/* ── the network ─────────────────────────────────────────────────────── */}
		<g>
			{/* TWO STROKES PER EDGE, and the first one is the important one. A single
			    dashed stroke that is only visible while a dash is passing does not draw
			    a network — it draws scattered tick marks with nothing joining them, and
			    that is exactly how it looked on screen. The solid stroke is the
			    connection; the dashed one travelling over it is the signal. */}
			{netEdges.map((e) => (
				<line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class="hm-net-wire" data-l={e.l} />
			))}
			{netEdges.map((e) => (
				<line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class="hm-net-edge" data-l={e.l} />
			))}
			{netNodes.flatMap((layer, li) =>
				layer.map((n) => (
					<circle
						cx={n.x} cy={n.y}
						r={li === netNodes.length - 1 ? 4.5 : 3.6}
						class="hm-net-node" data-l={li}
					/>
				)),
			)}
		</g>

		{/* THE CALLOUT. Two lines from the unit to the opened view: the oldest device in
		    technical drawing for "this, magnified", and it is what makes the right-hand
		    object legible as one node rather than as a second diagram. */}
		<g>
			<line data-callout="a" x1={SRC.x} y1={SRC.y} x2={CX} y2={CY - R_MKT} class="hm-lead" />
			<line data-callout="b" x1={SRC.x} y1={SRC.y} x2={CX} y2={CY + R_MKT} class="hm-lead" />
			<circle cx={SRC.x} cy={SRC.y} r="9" class="hm-src-ring" />
			<circle cx={SRC.x} cy={SRC.y} r="4" class="hm-src-dot" />
			{/* In the throat of the callout, where the two lines are still close together
			    and nothing else is drawn. Above the node it lay across the mesh wiring. */}
			<text x={SRC.x + 16} y={SRC.y + 4} text-anchor="start" class="hm-src-label">one unit</text>
		</g>

		{/* ── shells ──────────────────────────────────────────────────────────── */}
		<g>
			<ellipse data-shell="caps" data-r={R_CAPS} cx={CX} cy={CY} rx={R_CAPS} ry={R_CAPS * 0.4} class="hm-shell" />
			<ellipse data-shell="feat" data-r={R_FEAT} cx={CX} cy={CY} rx={R_FEAT} ry={R_FEAT * 0.4} class="hm-shell" />
			<ellipse data-shell="mkt" data-r={R_MKT} cx={CX} cy={CY} rx={R_MKT} ry={R_MKT * 0.4} class="hm-shell" />
		</g>

		<g>
			{chords.map((c) => (
				<line
					data-chord={c.key} data-fa={c.fa} data-ca={c.ca}
					data-fr={R_FEAT} data-cr={R_CAPS}
					x1={c.x1} y1={c.y1} x2={c.x2} y2={c.y2} class="hm-chord"
				/>
			))}
			{entries.map((e) => (
				<line
					data-entry={e.key} data-ma={e.ma} data-fa={e.fa}
					data-mr={R_MKT} data-fr={R_FEAT}
					x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class="hm-entry"
				/>
			))}
		</g>

		{/* ── the nucleus: the bounded chain ──────────────────────────────────── */}
		<g data-core>
			<circle cx={CX} cy={CY} r={R_CORE} class="hm-core-disc" />
			<circle cx={CX} cy={CY} r={R_CORE} class="hm-core-ring" />
			{ops.map((op, i) => {
				const col = i % 2;
				const row = i < 2 ? 0 : 1;
				const bx = CX - 52 + col * 54;
				const by = CY - 24 + row * 24;
				return (
					<g>
						<rect x={bx} y={by} width="50" height="20" rx="3" class="hm-op" />
						<text x={bx + 25} y={by + 14} text-anchor="middle" class="hm-op-text">{op}</text>
					</g>
				);
			})}
			{/* Inside the disc, not under it. Outside, it sat in the shells' airspace and
			    a sector pill printed straight across it — and unlike the pills it is not
			    in the cull, so nothing was ever going to move out of its way. */}
			<text x={CX} y={CY - R_CORE + 27} text-anchor="middle" class="hm-core-cap">4 BOUNDED OPS</text>
		</g>

		{/* ── capabilities ────────────────────────────────────────────────────── */}
		<g>
			{capPts.map((c) => (
				<g
					data-orb="caps" data-a={c.a} data-r={R_CAPS} data-id={c.name}
					data-hm-panel={`p-cap-${c.name.toLowerCase()}`}
					role="button" tabindex="0"
					aria-label={`${c.name} — what this capability is`}
					style={`opacity:${fmtDep(c.dep)}`}
				>
					{/* A HIT AREA. A capability is a 4.5px dot with a line of text ten pixels
					    above it, and an SVG group does not catch a pointer in the gap between
					    its children — a click on the middle of this group went straight
					    through to the page behind it and opened nothing. Measured. A
					    transparent rect gives the label one target, which is also what turns
					    a nine-pixel dot into something a thumb can hit. */}
					<rect class="hm-hit" x={c.x - 52} y={c.y - 22} width="104" height="34" />
					<circle cx={c.x} cy={c.y} r="4.5" class="hm-cap-dot" />
					<text x={c.x} y={c.y - 10} text-anchor="middle" class="hm-cap-text" data-cull>{c.name}</text>
				</g>
			))}
		</g>

		{/* ── features ────────────────────────────────────────────────────────── */}
		<g>
			{featPts.map((fp) => (
				<g
					data-orb="feat" data-a={fp.a} data-r={R_FEAT}
					data-w={CHIP_W} data-h={CHIP_H} data-id={fp.feature.id}
					data-hm-panel={`p-${fp.feature.id}`}
					role="button" tabindex="0"
					aria-label={`${fp.feature.name} — what this feature does`}
					style={`opacity:${fmtDep(fp.dep)}`}
				>
					<rect x={fp.x - CHIP_W / 2} y={fp.y - CHIP_H / 2} width={CHIP_W} height={CHIP_H} rx="5" class="hm-chip" data-cull />
					<text x={fp.x} y={fp.y + 4} text-anchor="middle" class="hm-chip-text">{fp.feature.name}</text>
					{/* Shown only on a narrow screen — see .hm.is-compact. */}
					<circle cx={fp.x} cy={fp.y} r="4" class="hm-chip-dot" />
				</g>
			))}
		</g>

		{/* ── sectors ─────────────────────────────────────────────────────────── */}
		<g>
			{mktPts.map((mp) => (
				<g
					data-orb="mkt" data-a={mp.a} data-r={R_MKT}
					data-w={PILL_W} data-h={PILL_H} data-id={mp.sector.id}
					data-hm-panel={`p-${mp.sector.id}`}
					role="button" tabindex="0"
					aria-label={`${mp.sector.name} — what this sector asks`}
					style={`opacity:${fmtDep(mp.dep)}`}
				>
					<rect x={mp.x - PILL_W / 2} y={mp.y - PILL_H / 2} width={PILL_W} height={PILL_H} rx="14" class="hm-pill" data-cull />
					<circle cx={mp.x} cy={mp.y} r="4.5" class="hm-chip-dot" />
					<text x={mp.x} y={mp.y + 4} text-anchor="middle" class="hm-pill-text">{mp.sector.name}</text>
				</g>
			))}
		</g>
	</svg>

	{/* ONE PANEL PER THING, IN THE MARKUP.
	    Real content, not strings assembled in JavaScript: it is in the HTML for a
	    crawler and a screen reader whether or not the model ever mounts, and every
	    word of it comes from the same data files the product and sector pages are
	    built from. The native popover attribute carries the rest — top layer, light
	    dismiss, Escape, focus return — none of which is worth reimplementing. */}
	<div class="hm-panels">
		{panels.map((p) => (
			<div class="hm-panel" id={p.id} popover="auto" data-kind={p.kind}>
				<p class="hm-panel-kind">{p.kind}</p>
				<p class="hm-panel-name">{p.name}</p>
				<p class="hm-panel-q">{p.question}</p>
				<p class="hm-panel-body">{p.body}</p>
				<p class="hm-panel-meta">{p.meta}</p>
				{p.href && <a class="hm-panel-link" href={p.href}>Read the page →</a>}
			</div>
		))}
	</div>

	<figcaption class="hm-legend">
		<span>One bounded node · six capabilities · seven features · five sectors</span>
		<span class="hm-drive" data-hm-hint hidden>Drag to turn it</span>
	</figcaption>
</figure>

<script>
	/* The same geometry the build baked, re-solved every frame into the same elements.
	   One source of shape, two renderers, no duplicated DOM. */
	const CX = 790;
	const CY = 300;
	const YAW0 = -0.35;
	const PITCH0 = 0.42;
	const SHELLS: Record<string, { tilt: number; roll: number }> = {
		caps: { tilt: 0.0, roll: 0.0 },
		feat: { tilt: 0.55, roll: 0.42 },
		mkt: { tilt: -0.42, roll: -0.5 },
	};

	interface V3 { x: number; y: number; z: number }
	const rotX = (p: V3, a: number): V3 =>
		({ x: p.x, y: p.y * Math.cos(a) - p.z * Math.sin(a), z: p.y * Math.sin(a) + p.z * Math.cos(a) });
	const rotY = (p: V3, a: number): V3 =>
		({ x: p.x * Math.cos(a) + p.z * Math.sin(a), y: p.y, z: -p.x * Math.sin(a) + p.z * Math.cos(a) });
	const rotZ = (p: V3, a: number): V3 =>
		({ x: p.x * Math.cos(a) - p.y * Math.sin(a), y: p.x * Math.sin(a) + p.y * Math.cos(a), z: p.z });

	function mountHeroModel() {
		const svg = document.querySelector<SVGSVGElement>('[data-hm-svg]');
		if (!svg || svg.dataset.live === '1') return;
		const fig = svg.closest<HTMLElement>('[data-hm]');
		if (!fig) return;
		svg.dataset.live = '1';

		const hint = fig.querySelector<HTMLElement>('[data-hm-hint]');
		if (hint) hint.hidden = false;
		fig.classList.add('is-live');

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const num = (el: Element, k: string) => Number(el.getAttribute(k)) || 0;

		const orbs = [...svg.querySelectorAll<SVGGElement>('[data-orb]')].map((el) => ({
			el,
			shell: el.getAttribute('data-orb') as string,
			a: num(el, 'data-a'),
			r: num(el, 'data-r'),
			w: num(el, 'data-w'),
			h: num(el, 'data-h'),
			id: el.getAttribute('data-id') || '',
			rect: el.querySelector<SVGRectElement>('rect:not(.hm-hit)'),
			hit: el.querySelector<SVGRectElement>('rect.hm-hit'),
			dot: el.querySelector<SVGCircleElement>('circle'),
			chipDot: el.querySelector<SVGCircleElement>('circle.hm-chip-dot'),
			text: el.querySelector<SVGTextElement>('text'),
			cull: el.querySelector<SVGElement>('[data-cull]'),
			/* Measured, not assumed. The caps carry no rect, so their width was a flat
			   74 for every one of them — "ACCOUNT" is 56 and "SUPPRESS" is 70, and the
			   cull was reserving the wrong span for both. */
			textW: 74,
		}));
		for (const o of orbs) {
			if (o.w) continue;
			try { o.textW = (o.text?.getComputedTextLength?.() ?? 74) + 6; } catch { /* not laid out yet */ }
		}
		/* Radii come off the elements, not from constants retyped in here. The first
		   pass hardcoded 118 / 196 / 272 in the script as well as in the frontmatter,
		   which is two sources of truth for one geometry and a silent mis-draw the
		   moment either moves. */
		const chords = [...svg.querySelectorAll<SVGLineElement>('[data-chord]')].map((el) => ({
			el, fa: num(el, 'data-fa'), ca: num(el, 'data-ca'),
			fr: num(el, 'data-fr'), cr: num(el, 'data-cr'),
			key: el.getAttribute('data-chord') || '',
		}));
		const entryDefs = [...svg.querySelectorAll<SVGLineElement>('[data-entry]')].map((el) => ({
			el, ma: num(el, 'data-ma'), fa: num(el, 'data-fa'),
			mr: num(el, 'data-mr'), fr: num(el, 'data-fr'),
			key: el.getAttribute('data-entry') || '',
		}));
		const shellEls = [...svg.querySelectorAll<SVGEllipseElement>('[data-shell]')].map((el) => ({
			el, shell: el.getAttribute('data-shell') as string, r: num(el, 'data-r'),
		}));
		const leadA = svg.querySelector<SVGLineElement>('[data-callout="a"]');
		const leadB = svg.querySelector<SVGLineElement>('[data-callout="b"]');

		let yaw = 0;
		let aimYaw = 0;
		let pitch = 0;
		let aimPitch = 0;
		let hovered = '';    // a feature id: lights the chords leaving that feature
		let hoverCap = '';   // a capability name: lights the chords arriving at it
		let dragging = false;
		let lastX = 0;
		let lastY = 0;
		let spin = reduced ? 0 : 1;
		const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);

		const project = (r: number, a: number, shell: string) => {
			const s = SHELLS[shell] ?? SHELLS.caps;
			let p: V3 = { x: r * Math.cos(a), y: 0, z: r * Math.sin(a) };
			p = rotX(p, s.tilt);
			p = rotZ(p, s.roll);
			p = rotY(p, YAW0 + yaw);
			p = rotX(p, PITCH0 + pitch);
			return { x: CX + p.x, y: CY + p.y, dep: r === 0 ? 0 : p.z / r };
		};

		/* A SHELL'S SILHOUETTE. Under an orthographic camera a tilted circle is still an
		   exact ellipse; these are its axes, found by projecting two perpendicular
		   diameters, so the guide always matches the points sitting on it. */
		const shellPath = (r: number, shell: string) => {
			const p0 = project(r, 0, shell);
			const p1 = project(r, Math.PI / 2, shell);
			const ax = Math.hypot(p0.x - CX, p0.y - CY);
			const ay = Math.hypot(p1.x - CX, p1.y - CY);
			const rot = (Math.atan2(p0.y - CY, p0.x - CX) * 180) / Math.PI;
			return { rx: Math.max(1, ax), ry: Math.max(1, ay), rot };
		};

		function frame(now: number) {
			if (!dragging) aimYaw += 0.0016 * spin;
			yaw += (aimYaw - yaw) * 0.08;
			pitch += (aimPitch - pitch) * 0.08;

			for (const s of shellEls) {
				const g = shellPath(s.r, s.shell);
				s.el.setAttribute('rx', String(g.rx));
				s.el.setAttribute('ry', String(g.ry));
				s.el.setAttribute('transform', `rotate(${g.rot} ${CX} ${CY})`);
			}

			const placed = [...orbs].map((o) => ({ o, p: project(o.r, o.a, o.shell) }))
				.sort((m, n) => m.p.dep - n.p.dep);

			/* Move everything first, then decide what is visible, then paint. Doing all
			   three in one pass is what made the last two attempts wrong in ways that
			   only showed up while it was turning. */
			for (const { o, p } of placed) {
				if (o.hit) {
					o.hit.setAttribute('x', String(p.x - 52));
					o.hit.setAttribute('y', String(p.y - 22));
				}
				if (o.chipDot) {
					o.chipDot.setAttribute('cx', String(p.x));
					o.chipDot.setAttribute('cy', String(p.y));
				}
				if (o.rect) {
					o.rect.setAttribute('x', String(p.x - o.w / 2));
					o.rect.setAttribute('y', String(p.y - o.h / 2));
				} else if (o.dot) {
					o.dot.setAttribute('cx', String(p.x));
					o.dot.setAttribute('cy', String(p.y));
				}
				if (o.text) {
					o.text.setAttribute('x', String(p.x));
					o.text.setAttribute('y', String(o.rect ? p.y + 4 : p.y - 10));
				}
			}

			const boxes: Array<{ l: number; r: number; t: number; b: number }> = [];
			/* THE NUCLEUS IS ABSOLUTE. A third of a 184px pill is sixty pixels of label
			   lying across the subject of the picture, so it gets no tolerance at all. */
			const core = { l: CX - 76, r: CX + 76, t: CY - 76, b: CY + 76 };
			const onCore = (bx: { l: number; r: number; t: number; b: number }) =>
				bx.r > core.l && bx.l < core.r && bx.b > core.t && bx.t < core.b;

			/* GREEDY CULL, NEAREST FIRST. Eighteen labels on three shells will cross at
			   some rotation whatever offsets they are given — that is geometry. So the
			   nearest wins the space and anything that would sit on one already placed
			   is hidden until the model turns. */
			for (let i = placed.length - 1; i >= 0; i--) {
				const { o, p } = placed[i];
				/* THE BOX HAS TO BE WHERE THE INK IS. A capability label has no rect and
				   is drawn at p.y - 10, but the cull was testing a box centred on p.y —
				   thirteen pixels below the glyphs, so it cleared collisions the label
				   was actually in. That is why SUPPRESS kept printing through The Update
				   Engine while the check reported nothing. */
				/* A CAPABILITY IS A DOT AND A LABEL, and the box has to cover both. The
				   group holds a circle at p.y and text at p.y - 10, so its real extent
				   runs from about p.y - 20 to p.y + 6 — twenty-six tall. Modelling it as
				   thirteen, centred fourteen above, described a box that missed the dot
				   entirely, which is why SUPPRESS kept clipping The Update Engine
				   through three different thresholds: the rule was never wrong, it was
				   being asked about the wrong rectangle. */
				const w = o.w || o.textW;
				const h = o.h || 26;
				const cy2 = o.rect ? p.y : p.y - 7;
				const box = { l: p.x - w / 2, r: p.x + w / 2, t: cy2 - h / 2, b: cy2 + h / 2 };

				/* SEPARATION, NOT A FRACTION OF AREA. Two thresholds were tried — a third
				   of the label's own area, then a twentieth — and both left grazes on
				   screen while reporting themselves satisfied, because a corner clip of
				   9x9 is a rounding error as an area and a visibly broken word to a
				   reader. Overlapping text does not get less overlapping when the
				   rectangle is large. So: no two labels may come within 3px, full stop.
				   It costs a label or two at some angles and it is never ambiguous. */
				const PAD = 3;
				const hit = onCore(box) || boxes.some((q) =>
					box.r + PAD > q.l && box.l - PAD < q.r && box.b + PAD > q.t && box.t - PAD < q.b);

				const near = (p.dep + 1) / 2;
				o.el.style.opacity = hit ? '0' : String(0.45 + near * 0.55);
				o.el.style.pointerEvents = hit ? 'none' : '';
				if (!hit) boxes.push(box);
			}

			/* Painter's order: FAR FIRST, so the near ones are appended last and end up
			   on top. The previous pass appended nearest-first, which is the order that
			   puts the far labels over the near ones — the exact opposite of depth. */
			for (const { o } of placed) o.el.parentNode?.appendChild(o.el);

			for (const c of chords) {
				const a = project(c.fr, c.fa, 'feat');
				const b = project(c.cr, c.ca, 'caps');
				c.el.setAttribute('x1', String(a.x)); c.el.setAttribute('y1', String(a.y));
				c.el.setAttribute('x2', String(b.x)); c.el.setAttribute('y2', String(b.y));
				/* The dash matters: a bare startsWith would also light every chord of a
				   feature whose id merely begins with this one's. */
				const lit = (hovered !== '' && c.key.startsWith(`${hovered}-`)) ||
					(hoverCap !== '' && c.key.endsWith(`-${hoverCap}`));
				c.el.classList.toggle('is-lit', lit);
				c.el.classList.toggle('is-dim', (hovered !== '' || hoverCap !== '') && !lit);
			}
			for (const e of entryDefs) {
				const a = project(e.mr, e.ma, 'mkt');
				const b = project(e.fr, e.fa, 'feat');
				e.el.setAttribute('x1', String(a.x)); e.el.setAttribute('y1', String(a.y));
				e.el.setAttribute('x2', String(b.x)); e.el.setAttribute('y2', String(b.y));
			}
			if (leadA && leadB) {
				const g = shellPath(shellEls.find((s) => s.shell === 'mkt')?.r ?? 340, 'mkt');
				leadA.setAttribute('y2', String(CY - Math.max(g.ry, 120)));
				leadB.setAttribute('y2', String(CY + Math.max(g.ry, 120)));
			}
			raf = requestAnimationFrame(frame);
		}

		/* ── A PRESS IS A CLICK UNTIL IT MOVES ───────────────────────────────────
		   setPointerCapture on pointerdown redirects every later pointer event to the
		   SVG, which means the browser's click lands on the SVG and never on the label
		   — the labels were wired up correctly and simply never heard. Measured: the
		   handler was attached, the panel existed, and clicking a chip did nothing.

		   So capture is deferred until the pointer has actually travelled 4px. Below
		   that it is a click and the label gets it; past that it is a drag and the
		   model takes over. It is also the right behaviour on a touch screen, where
		   every tap carries a pixel or two of movement. */
		const DRAG_SLOP = 4;
		let downX = 0;
		let downY = 0;
		let downOn: Element | null = null;
		let pressed = false;

		const onDown = (e: PointerEvent) => {
			pressed = true;
			dragging = false;
			downX = lastX = e.clientX;
			downY = lastY = e.clientY;
			downOn = (e.target as Element)?.closest?.('[data-hm-panel]') ?? null;
		};
		const onMove = (e: PointerEvent) => {
			if (!pressed) return;
			if (!dragging && Math.hypot(e.clientX - downX, e.clientY - downY) < DRAG_SLOP) return;
			if (!dragging) {
				dragging = true;
				// Turning it is a clear signal the reader is done reading.
				closePanel();
				try { svg.setPointerCapture(e.pointerId); } catch { /* fine */ }
				fig.classList.add('is-turning');
			}
			aimYaw += (e.clientX - lastX) * 0.006;
			aimPitch = clamp(aimPitch + (e.clientY - lastY) * 0.004, -0.5, 0.5);
			lastX = e.clientX; lastY = e.clientY;
		};
		const onUp = (e: PointerEvent) => {
			if (pressed && !dragging && downOn) openFor(downOn as SVGGElement);
			pressed = false;
			dragging = false;
			downOn = null;
			try { svg.releasePointerCapture(e.pointerId); } catch { /* gone */ }
			fig.classList.remove('is-turning');
		};

		/* HOVERING ANY LABEL STOPS THE MODEL, not only a feature chip. It used to be
		   chips alone, and the result was that a sector or capability label could not
		   be clicked without chasing it: the reader aims, the model turns, the pointer
		   lands on nothing. Whatever is under the pointer is what the reader is trying
		   to reach, so hold still for all of them. */
		for (const o of orbs) {
			if (!o.el.hasAttribute('data-hm-panel')) continue;
			o.el.addEventListener('pointerenter', () => {
				spin = 0;
				if (o.shell === 'feat') hovered = o.id;
				else if (o.shell === 'caps') hoverCap = o.id;
			});
			o.el.addEventListener('pointerleave', () => {
				if (openPanel) return;   // an open panel keeps its own subject lit
				hovered = '';
				hoverCap = '';
				spin = reduced ? 0 : 1;
			});
		}

		/* ── CLICK A LABEL, READ WHAT IT IS ──────────────────────────────────────
		   The panel is a native popover: the browser puts it in the top layer, closes
		   it on Escape or a click outside, and returns focus. None of that is worth
		   hand-rolling, and hand-rolled versions are where focus traps come from.

		   THE MODEL STOPS WHILE A PANEL IS OPEN. The anchor is a label on a turning
		   object; positioning a popover against a moving target means either chasing
		   it every frame or watching it drift away from what it describes. Reading is
		   not a moment to keep animating underneath someone. */
		let openPanel: HTMLElement | null = null;
		const supportsPopover = typeof HTMLElement !== 'undefined'
			&& typeof (HTMLElement.prototype as { showPopover?: unknown }).showPopover === 'function';

		const GAP = 12;   // between the label and the panel that explains it

		/* VIEWPORT COORDINATES, because a popover lives in the top layer.
		   showPopover() promotes the panel out of the figure and into the top layer,
		   where position resolves against the initial containing block — the viewport —
		   and not against the element it is written inside. Figure-relative numbers are
		   therefore wrong by however far down the page the figure sits, which is exactly
		   how a panel anchored to a label in plain view opened below the fold. Measured:
		   on screen false, twice. The panel is position:fixed and these are viewport
		   numbers; one clamp at the end decides, rather than a run of branches
		   overwriting each other. */
		const place = (panel: HTMLElement, target: SVGGElement) => {
			const t = target.getBoundingClientRect();
			const w = panel.offsetWidth || 300;
			const h = panel.offsetHeight || 170;
			const M = 12;
			const above = t.top - h - GAP;
			const below = t.bottom + GAP;
			// Above by preference — it keeps the label and the thing it explains in one
			// glance — but below whenever above would not fit and below would.
			const goAbove = above >= M || below + h > window.innerHeight - M;
			let top = goAbove ? above : below;
			top = Math.max(M, Math.min(top, window.innerHeight - M - h));
			let left = t.left + t.width / 2 - w / 2;
			left = Math.max(M, Math.min(left, window.innerWidth - M - w));
			panel.style.top = `${Math.round(top)}px`;
			panel.style.left = `${Math.round(left)}px`;
			/* THE BEAK. Clamping the panel to the viewport moves it off the label's
			   centre, so the beak cannot just sit at 50% — it tracks the label, which
			   is the whole point of it: it says which of forty labels this card is
			   about. Held 14px clear of either rounded corner. */
			panel.dataset.side = goAbove ? 'above' : 'below';
			const cx = t.left + t.width / 2 - left;
			panel.style.setProperty('--caret-x', `${Math.round(clamp(cx, 14, w - 14))}px`);
		};

		const closePanel = () => {
			if (!openPanel) return;
			if (supportsPopover) { try { openPanel.hidePopover(); } catch { /* already closed */ } }
			openPanel.classList.remove('is-open');
			openPanel = null;
			hovered = '';
			hoverCap = '';
			spin = reduced ? 0 : 1;
		};

		const openFor = (el: SVGGElement) => {
			const id = el.getAttribute('data-hm-panel');
			if (!id) return;
			const panel = fig.querySelector<HTMLElement>(`#${CSS.escape(id)}`);
			if (!panel) return;
			if (openPanel === panel) { closePanel(); return; }
			closePanel();
			openPanel = panel;
			spin = 0;
			const who = el.getAttribute('data-id') || '';
			hovered = el.getAttribute('data-orb') === 'feat' ? who : '';
			hoverCap = el.getAttribute('data-orb') === 'caps' ? who : '';
			/* ONE MECHANISM AT A TIME. Setting .is-open AND calling showPopover() meant
			   the browser could close the popover on Escape or a click outside while
			   the class stayed behind — and .is-open forces display:block, so the panel
			   went on sitting there after being dismissed, and the next label opened
			   underneath it. The class exists only for browsers without the popover
			   API; where the API is present it owns the state completely. */
			if (supportsPopover) {
				try { panel.showPopover(); } catch { /* already open */ }
			} else {
				panel.classList.add('is-open');
			}
			// After it is laid out, or offsetWidth is zero and it lands in the corner.
			requestAnimationFrame(() => place(panel, el));
			panel.addEventListener('toggle', (e) => {
				if ((e as ToggleEvent).newState === 'closed' && openPanel === panel) closePanel();
			}, { once: true });
		};

		for (const o of orbs) {
			if (!o.el.hasAttribute('data-hm-panel')) continue;
			o.el.addEventListener('keydown', (e) => {
				const k = (e as KeyboardEvent).key;
				if (k === 'Enter' || k === ' ') { e.preventDefault(); openFor(o.el); }
			});
		}
		// Without popover support there is no light dismiss, so provide one.
		if (!supportsPopover) {
			document.addEventListener('click', closePanel);
			document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePanel(); });
		}

		/* ── NARROW SCREENS GET THE NODE, NOT THE WHOLE SCENE ────────────────────
		   The artboard is 1240x470. At 390px the rendered box is 350x133, which puts
		   the labels at about three pixels — measured, and indefensible. There is no
		   arrangement of eighteen labels that is legible in 350 by 133.
		   So the viewBox crops to the opened node and the labels come off: what is
		   left is the object itself, which is worth looking at, and the legend
		   underneath carries the words in real text at a real size. Cropping rather
		   than shrinking, because the thing this figure has to say on a phone is
		   "a node, opened", not "here are eighteen names you cannot read". */
		/* THREE TIERS, SET BY WHAT A LABEL ACTUALLY MEASURES ON SCREEN.
		   A label is 11 units in the viewBox, so its rendered size is
		   11 x (box width / viewBox width). The full scene is 1240 wide, so at a
		   1020px box the labels land at 9px and at a 780px box at 6.3 — measured.
		   Cropping to the node narrows the viewBox to 800, which makes labels BIGGER
		   for the same box: 10.7px at 780. So the middle tier crops rather than
		   shrinks, and only the narrowest tier gives the labels up. */
		const FULL_VB = '0 0 1320 590';
		const NODE_VB = `${CX - 500} ${CY - 285} 1000 570`;
		const MIN_LABEL_PX = 9;
		const fitViewBox = () => {
			const w = svg.getBoundingClientRect().width;
			const cropped = (11 * w) / 1320 < MIN_LABEL_PX;
			svg.setAttribute('viewBox', cropped ? NODE_VB : FULL_VB);
			// Even cropped, below about 580px the labels fall under 8px.
			fig.classList.toggle('is-compact', (11 * w) / 1000 < 8);
			fig.classList.toggle('is-cropped', cropped);
		};
		fitViewBox();
		window.addEventListener('resize', fitViewBox);

		svg.addEventListener('pointerdown', onDown);
		svg.addEventListener('pointermove', onMove);
		svg.addEventListener('pointerup', onUp);
		svg.addEventListener('pointercancel', onUp);

		let raf = requestAnimationFrame(frame);
		document.addEventListener('astro:before-swap', () => {
			cancelAnimationFrame(raf);
			window.removeEventListener('resize', fitViewBox);
		}, { once: true });
	}

	document.addEventListener('astro:page-load', mountHeroModel);
	if (document.readyState !== 'loading') mountHeroModel();
	else document.addEventListener('DOMContentLoaded', mountHeroModel);
</script>

<style>
	.hm { margin: 0; min-width: 0; position: relative; }

	/* ── THE PANEL ────────────────────────────────────────────────────────────
	   A small card next to the thing it describes, not a sheet over the page. A
	   modal for forty words is a punishment: it takes the whole screen, blocks
	   everything behind it and has to be dismissed before anything else can
	   happen. This is anchored, light, and closes on Escape, on a click outside
	   or on turning the model. */
	.hm-panels { position: absolute; inset: 0; pointer-events: none; }
	.hm-panel {
		/* fixed, not absolute: in the top layer this resolves against the viewport,
		   and fixed says so rather than leaving it to look like an accident. */
		position: fixed;
		margin: 0;
		inset: auto;
		width: min(300px, 78vw);
		padding: 14px 16px 15px;
		border: 1px solid color-mix(in oklab, var(--accent-on-dark) 42%, transparent);
		border-radius: 10px;
		background: color-mix(in oklab, var(--bg-dark) 96%, #000);
		box-shadow: 0 18px 44px rgba(0, 0, 0, 0.55), 0 2px 0 rgba(255, 255, 255, 0.05) inset;
		color: var(--text-on-dark);
		pointer-events: auto;
		overflow: visible;
	}
	/* :popover-open for the native path, .is-open for the fallback. */
	.hm-panel:not(:popover-open):not(.is-open) { display: none; }
	.hm-panel:popover-open, .hm-panel.is-open {
		display: block;
		animation: hm-pop 160ms var(--ease-out, cubic-bezier(0.25,0.46,0.45,0.94));
	}
	@keyframes hm-pop {
		from { opacity: 0; transform: translateY(6px) scale(0.985); }
		to   { opacity: 1; transform: none; }
	}
	.hm-panel::backdrop { background: transparent; }

	/* A rotated square sharing the panel's own fill and edge: two of its four borders
	   are dropped so only the two facing outward are drawn, and it overlaps the panel
	   edge by a pixel so the join has no seam. */
	.hm-panel::after {
		content: '';
		position: absolute;
		left: var(--caret-x, 50%);
		width: 10px;
		height: 10px;
		margin-left: -5px;
		background: color-mix(in oklab, var(--bg-dark) 96%, #000);
		border: 1px solid color-mix(in oklab, var(--accent-on-dark) 42%, transparent);
		transform: rotate(45deg);
	}
	.hm-panel[data-side='above']::after {
		bottom: -6px;
		border-top: 0;
		border-left: 0;
	}
	.hm-panel[data-side='below']::after {
		top: -6px;
		border-bottom: 0;
		border-right: 0;
	}

	.hm-panel-kind {
		margin: 0 0 6px;
		font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
		font-size: 9.5px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent-on-dark);
	}
	.hm-panel-name {
		margin: 0;
		font-size: 16px;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}
	.hm-panel-q {
		margin: 7px 0 0;
		font-size: 12.5px;
		line-height: 1.45;
		color: var(--accent-on-dark);
	}
	.hm-panel-body { margin: 9px 0 0; font-size: 13px; line-height: 1.5; }
	.hm-panel-meta {
		margin: 10px 0 0;
		padding-top: 9px;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
		font-size: 10.5px;
		line-height: 1.45;
		color: var(--rule-on-dark);
	}
	.hm-panel-link {
		display: inline-block;
		margin-top: 10px;
		font-size: 12px;
		font-weight: 600;
		color: var(--accent-on-dark);
	}
	.hm-hit { fill: transparent; pointer-events: all; }
	[data-hm-panel] { cursor: pointer; }
	[data-hm-panel]:focus-visible { outline: 2px solid var(--accent-on-dark); outline-offset: 3px; }
	.hm svg {
		display: block;
		width: 100%;
		height: auto;
		/* With the full width to work in, the cap can be generous: the artboard is
		   1240x570, so at 1240 wide this is 570 tall and the labels render at their
		   designed 11px instead of the four or five they were getting. */
		max-height: min(62vh, 640px);
		/* hidden, not visible. The artboard is sized to the worst case now, so nothing
		   should reach the edge — but in the cropped tier the network sits 366 units
		   outside the viewBox by design, and overflow:visible does not mean "draw
		   outside my box", it means "draw outside my box and over the page". */
		overflow: hidden;
	}
	.hm.is-live svg {
		cursor: grab;
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}
	.hm.is-turning svg { cursor: grabbing; }

	/* ── the network ─────────────────────────────────────────────────────────── */
	/* THE MESH RUNS. It is the ordinary network the opened node came out of, and a
	   still one reads as a diagram of a network rather than as a network. The signal
	   is a dash travelling each edge — one CSS animation on a shared property, GPU
	   work, no JavaScript per frame for sixty edges — and the edges take the accent
	   rather than grey, so the left of the frame stops looking like a placeholder. */
	/* GRADED BY DEPTH, and the grade means something: the signal brightens as it goes
	   forward, from deep indigo at the input to the near-white the opened node is
	   drawn in. The dash travels from x1 to x2, and every edge is authored input-side
	   first, so the direction of travel is the direction of the forward pass. Two
	   accent tokens and the mix between them — no hue invented for decoration. */
	.hm-net-wire {
		stroke: var(--accent-on-dark);
		stroke-opacity: 0.14;
		stroke-width: 0.7;
	}
	.hm-net-wire[data-l='0'] { stroke: color-mix(in oklab, var(--accent-on-dark) 45%, var(--accent-mid)); }
	.hm-net-wire[data-l='1'] { stroke: color-mix(in oklab, var(--accent-on-dark) 72%, var(--accent-mid)); }
	.hm-net-wire[data-l='2'] { stroke-opacity: 0.2; }

	.hm-net-edge {
		stroke: var(--accent-on-dark);
		stroke-opacity: 0.55;
		stroke-width: 1.1;
		stroke-linecap: round;
		stroke-dasharray: 4 30;
		animation: hm-flow 2.6s linear infinite;
	}
	.hm-net-edge[data-l='0'] {
		stroke: color-mix(in oklab, var(--accent-on-dark) 55%, var(--accent-mid));
		animation-duration: 3.4s;
		animation-delay: -0.7s;
	}
	.hm-net-edge[data-l='1'] {
		animation-duration: 2.8s;
		animation-delay: -1.3s;
	}
	.hm-net-edge[data-l='2'] {
		stroke: color-mix(in oklab, var(--accent-soft) 60%, var(--accent-on-dark));
		stroke-opacity: 0.75;
		animation-duration: 2.1s;
	}
	@keyframes hm-flow { to { stroke-dashoffset: -34; } }

	.hm-net-node {
		fill: var(--accent-on-dark);
		fill-opacity: 0.55;
		animation: hm-breathe 3.2s ease-in-out infinite;
	}
	.hm-net-node[data-l='0'] { fill: color-mix(in oklab, var(--accent-on-dark) 40%, var(--accent-mid)); animation-delay: -2.2s; }
	.hm-net-node[data-l='1'] { fill: color-mix(in oklab, var(--accent-on-dark) 65%, var(--accent-mid)); animation-delay: -1.1s; }
	.hm-net-node[data-l='2'] { fill: var(--accent-on-dark); animation-delay: -0.4s; }
	.hm-net-node[data-l='3'] {
		fill: color-mix(in oklab, var(--accent-soft) 70%, var(--accent-on-dark));
		animation-delay: 0s;
	}
	@keyframes hm-breathe {
		0%, 100% { fill-opacity: 0.38; }
		50%      { fill-opacity: 0.85; }
	}

	.hm-lead {
		stroke: var(--accent-on-dark);
		stroke-opacity: 0.28;
		stroke-width: 1;
		stroke-dasharray: 3 5;
	}
	.hm-src-ring { fill: none; stroke: var(--accent-on-dark); stroke-opacity: 0.7; stroke-width: 1.2; }
	.hm-src-dot { fill: var(--accent-on-dark); }
	.hm-src-label {
		font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
		font-size: 10px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		fill: var(--text-on-dark);
		fill-opacity: 0.6;
	}

	/* ── shells ──────────────────────────────────────────────────────────────── */
	.hm-shell { fill: none; stroke: var(--text-on-dark); stroke-opacity: 0.16; stroke-width: 1; }

	.hm-chord { stroke: var(--accent-on-dark); stroke-opacity: 0.2; stroke-width: 0.8; }
	.hm-entry { stroke: var(--text-on-dark); stroke-opacity: 0.16; stroke-width: 0.8; }
	.hm-chord, .hm-entry { transition: stroke-opacity 180ms ease, stroke 180ms ease; }
	.hm-chord.is-lit { stroke-opacity: 0.95; stroke-width: 1.5; }
	.hm-chord.is-dim { stroke-opacity: 0.05; }

	/* ── nucleus ─────────────────────────────────────────────────────────────── */
	.hm-core-disc { fill: var(--bg-dark); fill-opacity: 0.94; }
	.hm-core-ring { fill: none; stroke: var(--accent-on-dark); stroke-opacity: 0.75; stroke-width: 1.4; }
	.hm-op { fill: none; stroke: var(--accent-on-dark); stroke-opacity: 0.5; stroke-width: 0.9; }
	.hm-op-text { font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); font-size: 9px; fill: var(--accent-on-dark); }
	.hm-core-cap {
		font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
		font-size: 9px;
		letter-spacing: 0.14em;
		fill: var(--accent-on-dark);
		fill-opacity: 0.8;
	}

	/* ── the three shells' contents ──────────────────────────────────────────── */
	.hm-cap-dot { fill: var(--accent-on-dark); }
	.hm-cap-text {
		font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
		font-size: 10px;
		letter-spacing: 0.12em;
		fill: var(--text-on-dark);
	}
	.hm-chip { fill: var(--bg-dark); fill-opacity: 0.92; stroke: var(--rule-on-dark); stroke-width: 1; }
	.hm-chip-text { font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); font-size: 11px; fill: var(--text-on-dark); }
	.hm-pill { fill: var(--bg-dark); fill-opacity: 0.92; stroke: var(--accent-on-dark); stroke-opacity: 0.55; stroke-width: 1; }
	.hm-pill-text { font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); font-size: 11px; fill: var(--accent-on-dark); }
	/* Only the feature shell is interactive: hovering one traces its capabilities. */
	[data-orb="feat"] { cursor: pointer; }

	/* Cropped to the node: the network and its callout are outside the frame, so they
	   come off rather than being sliced by the viewBox edge — a half-drawn network
	   bleeding off the side looks like a rendering fault, not like a crop. */
	.hm.is-cropped .hm-net-node,
	.hm.is-cropped .hm-net-wire,
	.hm.is-cropped .hm-net-edge,
	.hm.is-cropped .hm-lead,
	.hm.is-cropped .hm-src-ring,
	.hm.is-cropped .hm-src-dot,
	.hm.is-cropped .hm-src-label { display: none; }

	/* Cropped to the node: the network on the left is out of frame, so the legend
	   carries that part. Worth the trade — the subject is the opened node. */
	/* Inside the first line, not after the whole caption: appended to the figcaption
	   it landed under "drag to turn it" as a line of its own, opening with a stray
	   separator — "· ONE UNIT OF A NETWORK" reading as a fragment left behind. */
	.hm.is-cropped .hm-legend > span:first-child::after {
		content: ' · one unit of a network';
		opacity: 0.7;
	}

	/* SVG defaults an unfilled shape to black, which on this ground is a hole. The
	   three shells keep the colours they carry at full width: the feature chip's
	   hairline, the sector pill's accent, so the object still distinguishes its
	   three orbits once the names are gone. */
	.hm-chip-dot { display: none; }
	[data-orb='feat'] .hm-chip-dot { fill: var(--rule-on-dark); }
	[data-orb='mkt'] .hm-chip-dot {
		fill: var(--accent-on-dark);
		fill-opacity: 0.85;
	}

	/* COMPACT: THE OBJECT, WITHOUT THE NAMES IT HAS NO ROOM FOR — but not a field of
	   empty boxes, which is what hiding the text alone produced. Measured on a 390px
	   phone: eighteen outlined pills with nothing written in any of them, which reads
	   as a page that failed to load rather than as a deliberate simplification.
	   So the chip becomes the node it always stood for: the outline goes, a dot
	   appears, and the rect stays in place as an invisible 44px-wide target — a phone
	   still gets to tap any of the eighteen and read what it is. */
	.hm.is-compact [data-orb] text,
	.hm.is-compact .hm-src-label,
	.hm.is-compact .hm-op-text { display: none; }
	.hm.is-compact .hm-chip-dot { display: block; }
	.hm.is-compact .hm-chip,
	.hm.is-compact .hm-pill {
		fill: transparent;
		stroke: transparent;
	}
	.hm.is-compact .hm-core-cap { font-size: 7px; }

	.hm-legend {
		margin-top: var(--space-md);
		text-align: center;
		font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
		font-size: var(--text-eyebrow);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.hm-drive:not([hidden]) { display: block; margin-top: 4px; opacity: 0.8; }

	@media (prefers-reduced-motion: reduce) {
		.hm-chord, .hm-entry { transition: none; }
		/* The mesh keeps its colour and its dash; it just stops travelling. */
		/* With motion off the travelling dash has nothing to say, so drop it entirely
		   and let the solid wire carry the network on its own. */
		.hm-net-edge { display: none; }
		.hm-net-wire { stroke-opacity: 0.28; }
		.hm-net-node { animation: none; }
		.hm-net-node { fill-opacity: 0.6; }
		.hm-panel:popover-open, .hm-panel.is-open { animation: none; }
	}
