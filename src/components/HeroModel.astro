---
/* THE OPENED NODE.
 *
 * WHAT IT ARGUES. A standard unit cannot be opened, because its gradient path runs
 * through everything downstream and has no fixed length. ORMAS bounds that path to
 * four operations, and a part with a bounded path is a part you can point at. So:
 * one unit of a neural network, opened, with the bounded chain at its face — and
 * underneath it, everything the bound makes possible.
 *
 * WHY THE NAMES CAME OFF THE OBJECT. They were in orbit: eighteen of them, on three
 * shells, around a disc, in a column seven hundred pixels wide. Every version of
 * that was a fight — a cull that deleted a third of them, then a solver that flung
 * them to the frame edge, then a leash, then more passes. The ratio was the problem
 * the whole time. A radial arrangement carries five to seven things before it costs
 * the reader more than it gives, its centre should not be filled with labels, and it
 * already asks more of a reader than a straight list does. Eighteen names, three
 * ring systems and a chord matrix in that space was never going to resolve, and a
 * picture that has to be fought into legibility every frame is not finished, it is
 * unfinished in a way that happens to be moving.
 *
 * So the object carries no text at all. It is a sphere with the chain on its face
 * and three rings around it, and the only thing it has to do is be worth looking at
 * and say "this has an inside". The eighteen names sit below it in three rows, where
 * they cannot collide because a grid cannot collide, where they are real HTML with
 * real focus rings and real tap targets, and where the relationships are shown by
 * lighting up rather than by drawing sixty lines across the picture. Point at a
 * feature and the capabilities it uses and the sectors it serves light up with it.
 *
 * EVERY RELATION IS DATA. Which capabilities a feature uses is its row of the matrix
 * in data/features.ts; which feature a sector enters through is its primaryFeature
 * in data/sectors.ts. Add a feature and the picture redraws itself correctly.
 *
 * THE RINGS ARE REAL 3D. Each is a circle in space, projected through the same
 * camera, and split at the horizon into the half in front of the sphere and the half
 * behind it. The back half is drawn first and the sphere covers it. That is why it
 * reads as a solid object rather than as three ovals laid on top of a circle.
 */
import { features } from '../data/features';
import { sectors } from '../data/sectors';

const CAP_ORDER = ['ACCOUNT', 'PROTECT', 'REPAIR', 'DETECT', 'ISOLATE', 'SUPPRESS'] as const;
type Capability = (typeof CAP_ORDER)[number];

const ops = ['LayerNorm', 'Linear ↓', 'PReLU', 'Linear ↑'];

/* ── the object ─────────────────────────────────────────────────────────────── */
/* SIZED TO CONTAIN THE WHOLE OBJECT. The outer ring reaches 184 from the centre in
   every direction once the three rolls are accounted for, so the board is that plus
   a margin — no overflow, nothing leaning into the note columns either side. */
const W = 460;
const H = 440;
const CX = 230;
const CY = 220;
const R_SPHERE = 92;

/* Three rings at different attitudes. Tilt leans the ring away from the camera,
   roll spins it in its own plane; together they are what stops three circles round
   one sphere reading as three concentric ovals. */
const RINGS = [
	{ r: 120, tilt: 1.16, roll: 0.0 },
	{ r: 152, tilt: 1.22, roll: 1.05 },
	{ r: 184, tilt: 1.1, roll: -1.0 },
];

interface V3 { x: number; y: number; z: number }
const rotX = (p: V3, a: number): V3 =>
	({ x: p.x, y: p.y * Math.cos(a) - p.z * Math.sin(a), z: p.y * Math.sin(a) + p.z * Math.cos(a) });
const rotY = (p: V3, a: number): V3 =>
	({ x: p.x * Math.cos(a) + p.z * Math.sin(a), y: p.y, z: -p.x * Math.sin(a) + p.z * Math.cos(a) });
const rotZ = (p: V3, a: number): V3 =>
	({ x: p.x * Math.cos(a) - p.y * Math.sin(a), y: p.x * Math.sin(a) + p.y * Math.cos(a), z: p.z });

/* THE CAMERA, once, here and again in the script. z is depth: positive is toward
   the reader, which is what decides whether a stretch of ring is in front of the
   sphere or behind it. */
const project = (r: number, a: number, ring: { tilt: number; roll: number }, yaw = 0) => {
	let p: V3 = { x: r * Math.cos(a), y: 0, z: r * Math.sin(a) };
	p = rotX(p, ring.tilt);
	p = rotZ(p, ring.roll);
	p = rotY(p, yaw);
	return { x: CX + p.x, y: CY + p.y, z: p.z };
};

/* A ring, split at the horizon. Sampled rather than solved: the exact split point is
   a root of a trig equation and the difference at 96 samples is a third of a pixel. */
const SAMPLES = 96;
const ringHalves = (ring: { r: number; tilt: number; roll: number }, yaw = 0) => {
	const pts = Array.from({ length: SAMPLES + 1 }, (_, i) =>
		project(ring.r, (i / SAMPLES) * Math.PI * 2, ring, yaw));
	const runs: { front: boolean; d: string }[] = [];
	let cur: string[] = [];
	let front = pts[0].z >= 0;
	for (const p of pts) {
		const isFront = p.z >= 0;
		if (isFront !== front && cur.length) {
			runs.push({ front, d: `M${cur.join('L')}` });
			cur = [cur[cur.length - 1]];
			front = isFront;
		}
		cur.push(`${p.x.toFixed(1)},${p.y.toFixed(1)}`);
	}
	if (cur.length > 1) runs.push({ front, d: `M${cur.join('L')}` });
	return runs;
};
const bakedRings = RINGS.map((ring, i) => ({ i, halves: ringHalves(ring) }));

/* ── what each thing is, for the card that opens when it is clicked ───────────
   Read from data/features.ts and data/sectors.ts, the same files the pages are
   built from, so a card cannot say something a feature's own page contradicts. */
interface Panel {
	id: string;
	kind: 'feature' | 'sector' | 'capability';
	name: string;
	question: string;
	body: string;
	meta: string;
	href?: string;
}

const panels: Panel[] = [
	...features.map((f) => ({
		id: `p-${f.id}`,
		kind: 'feature' as const,
		name: f.name,
		question: f.question,
		body: f.summary,
		meta: `Needs: ${f.requires}`,
		href: `/product/${f.id}`,
	})),
	...sectors.map((sec) => ({
		id: `p-${sec.id}`,
		kind: 'sector' as const,
		name: sec.name,
		question: sec.question,
		body: sec.cost,
		meta: `Enters through ${features.find((f) => f.id === sec.primaryFeature)?.name ?? '—'}`,
		href: `/sectors/${sec.id}`,
	})),
	/* A CAPABILITY IS NOT WRITTEN ANYWHERE, so it is not written here either. There is
	   no prose for the six in data/, and a definition composed for a card would be a
	   claim about the architecture that nothing in the archive backs. What a
	   capability demonstrably IS, from the data alone, is the set of features that use
	   it and the sectors those features are the way into. */
	...CAP_ORDER.map((cap) => {
		const users = features.filter((f) => f.capabilities.includes(cap as Capability));
		const reach = sectors.filter((sec) => users.some((f) => f.id === sec.primaryFeature));
		return {
			id: `p-cap-${cap.toLowerCase()}`,
			kind: 'capability' as const,
			name: cap as string,
			question: 'One of the six capabilities the bounded chain makes possible.',
			body: users.length === 1
				? `Used by one of the seven features: ${users[0].name}.`
				: `Used by ${users.length} of the seven features: ${users.map((f) => f.name).join(', ')}.`,
			meta: reach.length
				? `Reaches ${reach.map((sec) => sec.name).join(' · ')}`
				: 'No sector enters through it directly.',
			href: '/technology',
		};
	}),
];

/* The three rows, and the links between them that the highlight follows. */
const capRow = CAP_ORDER.map((cap) => ({
	id: `p-cap-${cap.toLowerCase()}`,
	name: cap as string,
	feats: features.filter((f) => f.capabilities.includes(cap as Capability)).map((f) => f.id),
}));
const featRow = features.map((f) => ({
	id: `p-${f.id}`,
	key: f.id,
	name: f.name,
	caps: f.capabilities.map((c) => `p-cap-${String(c).toLowerCase()}`),
	secs: sectors.filter((s) => s.primaryFeature === f.id).map((s) => `p-${s.id}`),
}));
const secRow = sectors.map((sec) => ({
	id: `p-${sec.id}`,
	name: sec.name,
	feat: `p-${sec.primaryFeature}`,
}));
---

<figure class="hm" data-hm>
	{/* ── THE OBJECT ──────────────────────────────────────────────────────────
	    No text but the chain on its face. Everything that used to orbit it is in
	    the rows below, where a grid guarantees what a solver could only attempt. */}
	<div class="hm-stage">
		<svg
			data-hm-svg
			viewBox={`0 0 ${W} ${H}`}
			role="img"
			aria-label="One unit of a neural network, opened"
			aria-describedby="hm-desc"
			preserveAspectRatio="xMidYMid meet"
		>
			<desc id="hm-desc">
				A sphere with three rings around it. On its face, the bounded four-operation chain:
				LayerNorm, Linear down, PReLU, Linear up. The rows beneath name the six capabilities
				the bound makes possible, the seven features built from them, and the five sectors
				each feature serves.
			</desc>
			<defs>
				{/* Lit from the upper left, falling away to the far edge. A flat fill was
				    the thing that read as a circle rather than as a body. */}
				<radialGradient id="hm-face" cx="34%" cy="28%" r="78%">
					<stop offset="0%" stop-color="#2E3163" />
					<stop offset="52%" stop-color="#1D2045" />
					<stop offset="100%" stop-color="#121430" />
				</radialGradient>
				{/* Kept off the sphere's own edge. Spread across it, the halo washed the rim
				    out and the body stopped having a boundary at all. */}
				<radialGradient id="hm-halo" cx="50%" cy="50%" r="50%">
					<stop offset="72%" stop-color="rgba(165,160,255,0)" />
					<stop offset="86%" stop-color="rgba(165,160,255,0.10)" />
					<stop offset="100%" stop-color="rgba(165,160,255,0)" />
				</radialGradient>
			</defs>

			<circle cx={CX} cy={CY} r={R_SPHERE * 1.42} fill="url(#hm-halo)" />

			{/* Behind the sphere. Drawn first so the sphere covers it — the occlusion is
			    what makes a ring read as going round rather than lying on top. */}
			<g data-rings="back">
				{bakedRings.map((r) => r.halves.filter((h) => !h.front).map((h) => (
					<path d={h.d} class="hm-ring hm-ring--back" data-ring={r.i} data-front="0" />
				)))}
			</g>

			<g class="hm-body">
				<circle cx={CX} cy={CY} r={R_SPHERE} fill="url(#hm-face)" />
				<circle cx={CX} cy={CY} r={R_SPHERE} class="hm-rim" />
				<text x={CX} y={CY - R_SPHERE + 24} text-anchor="middle" class="hm-cap">the bounded chain</text>
				{ops.map((op, i) => {
					const by = CY - 48 + i * 26;
					return (
						<g>
							<rect x={CX - 45} y={by} width="90" height="18" rx="3" class="hm-op" />
							<text x={CX} y={by + 12.8} text-anchor="middle" class="hm-op-text">{op}</text>
							{i < ops.length - 1 && (
								<path d={`M${CX},${by + 18} v5 m-2.6,-2.6 l2.6,2.6 l2.6,-2.6`} class="hm-op-arrow" />
							)}
						</g>
					);
				})}
			</g>

			<g data-rings="front">
				{bakedRings.map((r) => r.halves.filter((h) => h.front).map((h) => (
					<path d={h.d} class="hm-ring hm-ring--front" data-ring={r.i} data-front="1" />
				)))}
			</g>

			{/* One carrier per ring, riding it. The only motion in the figure. */}
			<g data-carriers>
				{RINGS.map((_, i) => <circle r="3.4" class="hm-carrier" data-carrier={i} cx={CX} cy={CY} />)}
			</g>
		</svg>
	</div>

	{/* ── THE THREE ROWS ──────────────────────────────────────────────────────
	    Real buttons, in a grid. They cannot overlap, they take focus, they are a
	    proper tap target, and the text is HTML so it is crisp at any size and
	    findable on the page. Pointing at one lights everything it is joined to,
	    which is the same information the chords carried and none of the mess. */}
	<div class="hm-tax" data-tax>
		<section class="hm-row">
			<p class="hm-row-label">Six capabilities</p>
			<ul class="hm-chips">
				{capRow.map((c) => (
					<li>
						<button
							type="button" class="hm-chip hm-chip--cap"
							data-node={c.id} data-kin={c.feats.map((f) => `p-${f}`).join(' ')}
						>{c.name}</button>
					</li>
				))}
			</ul>
		</section>

		<section class="hm-row">
			<p class="hm-row-label">Seven features</p>
			<ul class="hm-chips">
				{featRow.map((f) => (
					<li>
						<button
							type="button" class="hm-chip hm-chip--feat"
							data-node={f.id} data-kin={[...f.caps, ...f.secs].join(' ')}
						>{f.name}</button>
					</li>
				))}
			</ul>
		</section>

		<section class="hm-row">
			<p class="hm-row-label">Five sectors</p>
			<ul class="hm-chips">
				{secRow.map((s) => (
					<li>
						<button
							type="button" class="hm-chip hm-chip--sec"
							data-node={s.id} data-kin={s.feat}
						>{s.name}</button>
					</li>
				))}
			</ul>
		</section>
	</div>

	{/* ONE CARD PER THING, IN THE MARKUP. Real content, not strings assembled in
	    JavaScript: it is in the HTML for a crawler and a screen reader whether or
	    not the script ever runs, and every word comes from the same data files the
	    product and sector pages are built from. */}
	<div class="hm-panels">
		{panels.map((p) => (
			<div class="hm-panel" id={p.id} popover="auto" data-kind={p.kind}>
				<p class="hm-panel-kind">{p.kind}</p>
				<p class="hm-panel-name">{p.name}</p>
				<p class="hm-panel-q">{p.question}</p>
				<p class="hm-panel-body">{p.body}</p>
				<p class="hm-panel-meta">{p.meta}</p>
				{p.href && <a class="hm-panel-link" href={p.href}>Read the page →</a>}
			</div>
		))}
	</div>

	<figcaption class="hm-legend">
		One unit of a neural network, opened. Point at any name to see what it joins.
	</figcaption>
</figure>

<script>
	/* The same camera the build used, re-solved each frame into the same elements.
	   One source of shape, two renderers, no duplicated DOM. */
	const W = 460;
	const H = 440;
	const CX = 230;
	const CY = 220;
	const R_SPHERE = 92;
	const RINGS = [
		{ r: 120, tilt: 1.16, roll: 0.0 },
		{ r: 152, tilt: 1.22, roll: 1.05 },
		{ r: 184, tilt: 1.1, roll: -1.0 },
	];
	const SAMPLES = 96;

	interface V3 { x: number; y: number; z: number }
	const rotX = (p: V3, a: number): V3 =>
		({ x: p.x, y: p.y * Math.cos(a) - p.z * Math.sin(a), z: p.y * Math.sin(a) + p.z * Math.cos(a) });
	const rotY = (p: V3, a: number): V3 =>
		({ x: p.x * Math.cos(a) + p.z * Math.sin(a), y: p.y, z: -p.x * Math.sin(a) + p.z * Math.cos(a) });
	const rotZ = (p: V3, a: number): V3 =>
		({ x: p.x * Math.cos(a) - p.y * Math.sin(a), y: p.x * Math.sin(a) + p.y * Math.cos(a), z: p.z });

	function mountHeroModel() {
		const fig = document.querySelector<HTMLElement>('[data-hm]');
		if (!fig || fig.dataset.hmLive === '1') return;
		fig.dataset.hmLive = '1';

		const svg = fig.querySelector<SVGSVGElement>('[data-hm-svg]');
		const backG = fig.querySelector<SVGGElement>('[data-rings="back"]');
		const frontG = fig.querySelector<SVGGElement>('[data-rings="front"]');
		if (!svg || !backG || !frontG) return;

		const carriers = [...fig.querySelectorAll<SVGCircleElement>('[data-carrier]')];
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const project = (r: number, a: number, ring: { tilt: number; roll: number }, yaw: number) => {
			let p: V3 = { x: r * Math.cos(a), y: 0, z: r * Math.sin(a) };
			p = rotX(p, ring.tilt);
			p = rotZ(p, ring.roll);
			p = rotY(p, yaw);
			return { x: CX + p.x, y: CY + p.y, z: p.z };
		};

		/* A POOL OF PATHS, REUSED. A ring crosses the horizon twice, so it is at most
		   two runs each side, and the DOM never has to grow or shrink — which is the
		   whole reason the old figure kept losing the pointer: it was taking nodes out
		   and putting them back every frame. Nothing is added or removed here after
		   mount; only the d attribute changes. */
		const pool: { back: SVGPathElement[]; front: SVGPathElement[] } = { back: [], front: [] };
		const MAX_RUNS = 3;
		for (const side of ['back', 'front'] as const) {
			const host = side === 'back' ? backG : frontG;
			host.textContent = '';
			for (let i = 0; i < RINGS.length * MAX_RUNS; i++) {
				const el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
				el.setAttribute('class', `hm-ring hm-ring--${side}`);
				// An SVG path with no fill declared is black, not transparent.
				el.setAttribute('fill', 'none');
				el.style.display = 'none';
				host.appendChild(el);
				pool[side].push(el);
			}
		}

		let yaw = 0;
		let raf = 0;
		let last = 0;

		const draw = (t: number) => {
			const dt = last ? Math.min(64, t - last) : 16;
			last = t;
			if (!reduced) yaw += dt * 0.00013;

			const used = { back: 0, front: 0 };
			RINGS.forEach((ring, ri) => {
				let cur: string[] = [];
				let front = project(ring.r, 0, ring, yaw).z >= 0;
				const flush = () => {
					if (cur.length < 2) return;
					const side = front ? 'front' : 'back';
					const el = pool[side][used[side]];
					if (!el) return;
					used[side] += 1;
					el.setAttribute('d', `M${cur.join('L')}`);
					el.style.display = '';
				};
				for (let i = 0; i <= SAMPLES; i++) {
					const p = project(ring.r, (i / SAMPLES) * Math.PI * 2, ring, yaw);
					const isFront = p.z >= 0;
					if (isFront !== front && cur.length) {
						flush();
						cur = [cur[cur.length - 1]];
						front = isFront;
					}
					cur.push(`${p.x.toFixed(1)},${p.y.toFixed(1)}`);
				}
				flush();

				/* The carrier rides its ring and goes behind the sphere with it: hidden
				   when it is on the far side AND inside the disc, which is exactly when a
				   real bead would be out of sight. Near the camera it is bigger. */
				const c = carriers[ri];
				if (c) {
					const a = yaw * (2.4 + ri * 0.55) + ri * 2.1;
					const p = project(ring.r, a, ring, yaw);
					const depth = p.z / ring.r;
					const hidden = depth < 0 && Math.hypot(p.x - CX, p.y - CY) < R_SPHERE;
					c.setAttribute('cx', p.x.toFixed(1));
					c.setAttribute('cy', p.y.toFixed(1));
					c.setAttribute('r', (2.4 + (depth + 1) * 1.1).toFixed(2));
					c.style.opacity = hidden ? '0' : String(0.45 + ((depth + 1) / 2) * 0.55);
				}
			});
			for (const side of ['back', 'front'] as const) {
				for (let i = used[side]; i < pool[side].length; i++) pool[side][i].style.display = 'none';
			}
			raf = requestAnimationFrame(draw);
		};
		raf = requestAnimationFrame(draw);

		/* ── THE ROWS ────────────────────────────────────────────────────────────
		   Pointing at a name lights everything it is joined to and dims the rest. It
		   is the chord matrix and the sector lines, shown by relation rather than by
		   drawing sixty strokes over the picture. */
		const tax = fig.querySelector<HTMLElement>('[data-tax]');
		const chips = [...fig.querySelectorAll<HTMLButtonElement>('[data-node]')];
		const byId = new Map(chips.map((c) => [c.dataset.node as string, c]));

		const light = (chip: HTMLButtonElement | null) => {
			if (!chip) {
				for (const c of chips) c.classList.remove('is-lit', 'is-dim', 'is-on');
				fig.classList.remove('is-tracing');
				return;
			}
			const kin = new Set((chip.dataset.kin || '').split(' ').filter(Boolean));
			fig.classList.add('is-tracing');
			for (const c of chips) {
				const id = c.dataset.node as string;
				const on = c === chip;
				const lit = kin.has(id);
				c.classList.toggle('is-on', on);
				c.classList.toggle('is-lit', lit);
				c.classList.toggle('is-dim', !on && !lit);
			}
		};

		let openPanel: HTMLElement | null = null;
		const closePanel = () => {
			if (!openPanel) return;
			const p = openPanel;
			openPanel = null;
			try { p.hidePopover(); } catch { /* already closed */ }
			p.classList.remove('is-open');
		};

		const supportsPopover = typeof HTMLElement !== 'undefined' &&
			typeof (HTMLElement.prototype as { showPopover?: unknown }).showPopover === 'function';

		/* A CARD NEXT TO THE THING IT EXPLAINS, not a sheet over the page. A popover
		   is in the top layer, so position resolves against the viewport — the panel
		   is fixed and these are viewport numbers, and one clamp at the end decides
		   rather than a run of branches overwriting each other. */
		const place = (panel: HTMLElement, chip: HTMLElement) => {
			const t = chip.getBoundingClientRect();
			const w = panel.offsetWidth || 300;
			const h = panel.offsetHeight || 170;
			const M = 12;
			const GAP = 10;
			const above = t.top - h - GAP;
			const below = t.bottom + GAP;
			const goAbove = above >= M || below + h > window.innerHeight - M;
			let top = goAbove ? above : below;
			top = Math.max(M, Math.min(top, window.innerHeight - M - h));
			let left = t.left + t.width / 2 - w / 2;
			left = Math.max(M, Math.min(left, window.innerWidth - M - w));
			panel.style.top = `${Math.round(top)}px`;
			panel.style.left = `${Math.round(left)}px`;
			panel.dataset.side = goAbove ? 'above' : 'below';
			const cx = t.left + t.width / 2 - left;
			panel.style.setProperty('--caret-x', `${Math.round(Math.min(Math.max(cx, 14), w - 14))}px`);
		};

		const openFor = (chip: HTMLButtonElement) => {
			const id = chip.dataset.node;
			if (!id) return;
			const panel = fig.querySelector<HTMLElement>(`#${CSS.escape(id)}`);
			if (!panel) return;
			if (openPanel === panel) { closePanel(); return; }
			closePanel();
			openPanel = panel;
			if (supportsPopover) { try { panel.showPopover(); } catch { /* already open */ } }
			else panel.classList.add('is-open');
			requestAnimationFrame(() => place(panel, chip));
		};

		/* ONE LISTENER PER PANEL, AT MOUNT, WITHOUT once. Attached inside openFor with
		   { once: true } it was consumed by the toggle that fires when the popover
		   OPENS, so nothing was left to hear the close — and the previous figure then
		   sat frozen for the rest of the session. */
		for (const panel of fig.querySelectorAll<HTMLElement>('.hm-panel')) {
			panel.addEventListener('toggle', (e) => {
				if ((e as ToggleEvent).newState === 'closed' && openPanel === panel) closePanel();
			});
		}

		for (const chip of chips) {
			chip.addEventListener('pointerenter', () => light(chip));
			chip.addEventListener('focus', () => light(chip));
			chip.addEventListener('click', () => openFor(chip));
		}
		tax?.addEventListener('pointerleave', () => light(null));
		tax?.addEventListener('focusout', (e) => {
			if (!tax.contains((e as FocusEvent).relatedTarget as Node)) light(null);
		});
		if (!supportsPopover) document.addEventListener('click', closePanel);
		window.addEventListener('resize', () => closePanel());

		document.addEventListener('astro:before-swap', () => {
			cancelAnimationFrame(raf);
			closePanel();
		}, { once: true });
		void byId;
	}

	document.addEventListener('astro:page-load', mountHeroModel);
	if (document.readyState !== 'loading') mountHeroModel();
	else document.addEventListener('DOMContentLoaded', mountHeroModel);
</script>

