---
// design/12 §CTA Buttons. Primary (amber fill) · secondary (ghost) · tertiary (text + arrow).
// Disabled state is signalled by opacity and cursor, never colour alone (Law 6). Nav.astro
// (task 1.1, built before this component existed) has its own equivalent CTA classes rather
// than this component — a deliberate consequence of the task ordering, not an oversight; see
// this task's SURPRISES.
export interface Props {
	variant?: 'primary' | 'secondary' | 'tertiary';
	href?: string;
	disabled?: boolean;
	type?: 'button' | 'submit' | 'reset';
}

const { variant = 'primary', href, disabled = false, type = 'button' } = Astro.props;
---

{
	href ? (
		<a
			class={`btn btn--${variant}`}
			href={disabled ? undefined : href}
			aria-disabled={disabled ? 'true' : undefined}
			tabindex={disabled ? -1 : undefined}
		>
			<slot />
			{variant === 'tertiary' && <span aria-hidden="true"> →</span>}
		</a>
	) : (
		<button class={`btn btn--${variant}`} type={type} disabled={disabled}>
			<slot />
			{variant === 'tertiary' && <span aria-hidden="true"> →</span>}
		</button>
	)
}
