---
// FAQ — rebuilt 2026-09-07.
//
// WHAT THE OLD PAGE WAS. Twenty-five questions in five hard-coded groups, with category "tabs"
// that were anchor links rather than filters, a superseded product model ("six pre-bookable
// solutions", "are the features sold separately"), invented scarcity ("three slots per quarter"),
// a price range contradicting /licensing, and one sentence with a clause missing. All gone; the
// question set now lives in data/faq.ts.
//
// WHY THIS PAGE HAS SEARCH. Research on FAQ UX is consistent that a search field is the single
// largest improvement available to any page past roughly twenty questions, and that filtering
// beats anchor-jumping because it removes what does not match rather than merely moving the
// viewport. This page has 55. It gets both, plus a live count so the filter's effect is visible
// rather than inferred.
//
// WHY <details> RATHER THAN THE Accordion COMPONENT. Accordion.astro renders open and depends on
// accordion.ts to collapse, so without JS the page is 55 open answers. Native <details> is closed
// by default with no JS at all, is keyboard-operable for free, and lets the browser's own find
// function reach text inside collapsed panels. On the one page most likely to be read by someone
// searching for a single specific answer, that is the correct primitive.
//
// STRUCTURED DATA. The FAQPage JSON-LD is generated from the same array the page renders, so the
// two cannot drift. Hand-maintaining it beside the markup is how structured data silently stops
// matching the page it describes.
import Page from '../layouts/Page.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import PageBanner from '../components/PageBanner.astro';
import { faqs, faqCategories } from '../data/faq';

const countFor = (id: string) => faqs.filter((f) => f.cat === id).length;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
	})),
};
---

<Page title="FAQ" description={"The questions a technical evaluation, a security review and a procurement process actually ask, answered without hedging — including the uncomfortable ones."}>
	<PageBanner
		eyebrow="FAQ"
		title={`${faqs.length} questions, answered without hedging.`}
		trail={[{ label: 'Home', href: '/' }, { label: 'FAQ' }]}
	/>

	<section class="section-tight container">
		<p class="faq-lede">
			These are the questions that actually get asked in a technical evaluation, a security
			review and a procurement process — including the ones with uncomfortable answers. Where
			something is not established, it says so and says why.
		</p>

		<div class="faq-search">
			<label class="visually-hidden" for="faq-q">Search the questions</label>
			<span class="faq-search-icon" aria-hidden="true">⌕</span>
			<input
				type="search"
				id="faq-q"
				class="faq-search-input"
				placeholder="Search — try &ldquo;GDPR&rdquo;, &ldquo;cost&rdquo;, &ldquo;on-premise&rdquo;, &ldquo;scale&rdquo;"
				autocomplete="off"
			/>
			<kbd class="faq-search-key" aria-hidden="true">/</kbd>
		</div>

		<div class="faq-filters" role="group" aria-label="Filter by category">
			<button type="button" class="faq-chip is-active" data-cat="all">
				Everything <span class="faq-chip-n tabular">{faqs.length}</span>
			</button>
			{faqCategories.map((c) => (
				<button type="button" class="faq-chip" data-cat={c.id}>
					{c.label} <span class="faq-chip-n tabular">{countFor(c.id)}</span>
				</button>
			))}
		</div>

		<p class="faq-count" id="faq-count" role="status" aria-live="polite">
			Showing all {faqs.length} questions
		</p>
	</section>

	<section class="section-tight container">
		<div class="faq-body">
			{faqCategories.map((c) => (
				<section class="faq-cat" data-cat={c.id}>
					<div class="faq-cat-head">
						<h2 class="faq-cat-title">{c.label}</h2>
						<p class="faq-cat-blurb">{c.blurb}</p>
					</div>
					{faqs.filter((f) => f.cat === c.id).map((f) => (
						<details class="faq-item" id={f.id} data-cat={c.id}>
							<summary class="faq-q">
								<span class="faq-q-text">{f.q}</span>
								<span class="faq-q-icon" aria-hidden="true"></span>
							</summary>
							<div class="faq-a">
								{f.a.map((para) => <p class="faq-a-p">{para}</p>)}
								{f.link && (
									<a class="faq-a-link" href={f.link.href}>{f.link.label} →</a>
								)}
							</div>
						</details>
					))}
				</section>
			))}

			<div class="faq-empty" id="faq-empty" hidden>
				<p class="faq-empty-title">Nothing matches that.</p>
				<p class="faq-empty-body">
					If the question is not here, it is one worth answering. Ask it directly and the reply
					comes from the person who built the architecture.
				</p>
				<Button variant="primary" href="/contact">Ask it directly</Button>
			</div>
		</div>
	</section>

	<section class="band band--dark section reveal">
		<div class="container faq-closing">
			<Eyebrow>STILL DECIDING</Eyebrow>
			<h2 class="faq-closing-title">The fastest way through this is a conversation.</h2>
			<p class="faq-closing-lede">
				Bring what you train, what obligation you carry, and what a failure currently costs you to
				diagnose. Those three answers decide whether this is relevant to you faster than any page
				can.
			</p>
			<div class="faq-closing-cta">
				<Button variant="primary" href="/contact">Start a conversation</Button>
				<Button variant="secondary" href="/technology">Read the research</Button>
			</div>
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

	<script>
		// Search + category filtering. Both narrow the same set, so they compose: picking a category
		// and then typing searches within it. The count line is the feedback mechanism — a filter
		// whose effect is not visible reads as a broken filter.
		const input = document.getElementById('faq-q') as HTMLInputElement | null;
		const countEl = document.getElementById('faq-count');
		const emptyEl = document.getElementById('faq-empty');
		const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.faq-chip'));
		const cats = Array.from(document.querySelectorAll<HTMLElement>('.faq-cat'));
		const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('.faq-item'));

		// Index built from the DOM rather than shipped as data attributes: the text is already on
		// the page, and duplicating ~30KB of it into markup to search it would be absurd.
		const index = items.map((el) => ({
			el,
			cat: el.dataset.cat ?? '',
			text: (el.textContent ?? '').toLowerCase().replace(/\s+/g, ' '),
		}));

		let activeCat = 'all';

		function apply() {
			const q = (input?.value ?? '').trim().toLowerCase();
			const terms = q.split(/\s+/).filter(Boolean);
			let shown = 0;

			for (const entry of index) {
				const catOk = activeCat === 'all' || entry.cat === activeCat;
				const textOk = terms.every((t) => entry.text.includes(t));
				const visible = catOk && textOk;
				entry.el.hidden = !visible;
				// Open matches while searching so the answer is readable without a second click,
				// and close them again when the query is cleared.
				if (terms.length) entry.el.open = visible;
				else entry.el.open = false;
				if (visible) shown += 1;
			}

			// A category heading with nothing under it is noise.
			for (const cat of cats) {
				const any = Array.from(cat.querySelectorAll<HTMLDetailsElement>('.faq-item')).some(
					(el) => !el.hidden,
				);
				cat.hidden = !any;
			}

			if (emptyEl) emptyEl.hidden = shown !== 0;
			if (countEl) {
				if (shown === 0) countEl.textContent = 'No matching questions';
				else if (!terms.length && activeCat === 'all') {
					countEl.textContent = `Showing all ${shown} questions`;
				} else {
					countEl.textContent = `Showing ${shown} of ${index.length} questions`;
				}
			}
		}

		input?.addEventListener('input', apply);

		for (const chip of chips) {
			chip.addEventListener('click', () => {
				activeCat = chip.dataset.cat ?? 'all';
				for (const c of chips) c.classList.toggle('is-active', c === chip);
				apply();
			});
		}

		// "/" focuses search, Escape clears it. Both are the conventions a reader who uses search
		// heavily will already try.
		document.addEventListener('keydown', (e) => {
			const target = e.target as HTMLElement | null;
			const typing = target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
			if (e.key === '/' && !typing) {
				e.preventDefault();
				input?.focus();
			}
			if (e.key === 'Escape' && typing && input && input.value) {
				input.value = '';
				apply();
			}
		});

		// Deep links: /faq#gdpr-position opens that answer rather than scrolling to a closed row.
		function openHash() {
			const id = decodeURIComponent(location.hash.slice(1));
			if (!id) return;
			const el = document.getElementById(id);
			if (el instanceof HTMLDetailsElement) {
				el.open = true;
				el.scrollIntoView({ block: 'center' });
			}
		}
		window.addEventListener('hashchange', openHash);
		openHash();
	</script>
</Page>
