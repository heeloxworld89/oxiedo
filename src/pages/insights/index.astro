---
// Data-table feed, no thumbnails. Zero posts is deliberate and nothing is fabricated to fill it.
//
// REWRITTEN 2026-09-07. The empty state was one sentence — "Nothing published yet" — which reads
// as an abandoned section rather than one that has not started. An empty page on a live site
// costs credibility unless it says why it is empty and hands the reader somewhere real, so it
// now does both. The feed markup below is untouched and takes over the moment a post exists.
import Page from '../../layouts/Page.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Page title="Insights: documented analysis" description={"Documented analysis with sourced claims: what we know, what we do not, and what changed our minds."}>
	<section class="section container">
		<Eyebrow>INSIGHTS</Eyebrow>
		<h1>Insights</h1>
		<p class="insights-intro">
			Documented analysis with sourced claims: what we know, what we do not, and what changed
			our minds. Not marketing, and not opinion pieces about the future of AI.
		</p>
	</section>

	<section class="section container reveal">
		{
			posts.length === 0 ? (
				<div class="insights-empty">
					<p class="insights-empty-title">Nothing here yet, and that is on purpose.</p>
					<p class="insights-empty-body">
						Every hour spent writing about the work is an hour not spent on it, and at a team of
						one that trade is not currently worth making. Posts will appear here when there is
						something to report that is not already written up properly somewhere else on this
						site, which at the moment everything is.
					</p>
					<p class="insights-empty-body">
						The substance is not hidden. It is on these three pages.
					</p>
					<ul class="insights-empty-routes">
						<li>
							<a href="/technology"><strong>The technology</strong><span>The architecture, 383 experiments, the results, and a section on what is not established</span></a>
						</li>
						<li>
							<a href="/sectors"><strong>The markets</strong><span>Five industries, the regulation driving each, and the sources behind every figure</span></a>
						</li>
						<li>
							<a href="/faq"><strong>The FAQ</strong><span>The questions an evaluation actually asks, answered without hedging</span></a>
						</li>
					</ul>
				</div>
			) : (
				<div class="insights-feed">
					{posts.map((post) => (
						<a href={`/insights/${post.id}`} class="insights-row">
							<span class="insights-row-date tabular">
								{post.data.date.toISOString().slice(0, 10).replace(/-/g, '.')}
							</span>
							<span class="insights-row-title">{post.data.title}</span>
							<span class="insights-row-category">{post.data.category}</span>
							<span class="insights-row-read">READ →</span>
						</a>
					))}
				</div>
			)
		}
	</section>
</Page>
