---
// ui_ux/06 §2. 65ch measure, centred. Telemetry blocks (used inside post body content) inset
// full-bleed to the measure's edges plus 24px — handled by .post-body :global(.telemetry-block).
import Page from './Page.astro';

export interface Props {
	title: string;
	date: Date;
	readTime: string;
	category: string;
}

const { title, date, readTime, category } = Astro.props;
const formattedDate = date.toISOString().slice(0, 10).replace(/-/g, '.');
---

<Page title={title}>
	<article class="section container post">
		<p class="post-meta tabular">
			{formattedDate} · {category} · {readTime}
		</p>
		<h1>{title}</h1>
		<div class="post-body">
			<slot />
		</div>
	</article>
</Page>
