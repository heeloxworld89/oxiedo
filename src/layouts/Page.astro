---
// Nav + main + footer, wrapped in the Base shell. Every real page uses this, not Base directly.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
	title: string;
	description?: string;
	indexable?: boolean;
	breadcrumbs?: Array<{ name: string; path: string }>;
	schema?: Record<string, unknown> | Array<Record<string, unknown>>;
	ogImagePath?: string;
}

const { title, description, indexable, breadcrumbs, schema, ogImagePath } = Astro.props;
---

<Base title={title} description={description} indexable={indexable} breadcrumbs={breadcrumbs} schema={schema} ogImagePath={ogImagePath}>
	<a href="#main-content" class="skip-link">Skip to content</a>
	<Nav />
	<main id="main-content">
		<slot />
	</main>
	<Footer />
</Base>
