---
// `title` must be a string that already exists verbatim in website/design/ for that route — no
// source specifies a <title> convention, so each page supplies its own sourced string rather
// than this layout inventing one.
// ClientRouter added 2026-09-06: moving between solution sub-pages was a hard white blink.
// It cross-fades navigation instead. Progressive enhancement — with JS disabled the browser
// just does a normal page load, so nothing depends on it. The reduced-motion case is handled
// in motion.css, which disables the transition entirely rather than fading fast.
import { ClientRouter } from 'astro:transitions';
import lastmod from '../data/lastmod.json';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
/* Responsive overrides load after components.css so they win at equal specificity.
   Split four ways so a parallel sweep cannot produce four conflicting edits to one file. */
import '../styles/responsive-hero.css';
import '../styles/responsive-console.css';
import '../styles/responsive-pages.css';
import '../styles/responsive-chrome.css';
import '../styles/motion.css';

export interface Props {
	/** The page's own name. The brand suffix is appended here, once, for every page. */
	title: string;
	/** One sentence, 50–160 chars. Shown in search results and on every shared link. */
	description?: string;
	/** Set false on /404 so it stays out of the index. */
	indexable?: boolean;
	/** Trail for BreadcrumbList schema. Mirror whatever PageBanner renders visually, minus Home. */
	breadcrumbs?: Array<{ name: string; path: string }>;
	/** Any additional JSON-LD entity for this page. Merged into the same @graph. */
	schema?: Record<string, unknown> | Array<Record<string, unknown>>;
	/** Absolute-from-root path to a page-specific social card, e.g. the replay
	 *  cards under /black-box/cards. Falls back to the site card. Pass a PNG or JPEG:
	 *  Twitter does not reliably render SVG. */
	ogImagePath?: string;
}

const { title, description, indexable = true, breadcrumbs, schema, ogImagePath } = Astro.props;

// SITE — confirmed by the founder 2026-09-08: oxiedo.com is owned. Canonicals, Open Graph URLs
// and the sitemap are all built from this, and src/pages/sitemap.xml.ts holds the same constant —
// change both together. If this is ever wrong, every canonical points at a domain we do not
// control, which is worse for search than having no canonical at all.
const SITE = 'https://oxiedo.com';

const pageTitle = title.toLowerCase().includes('oxiedo') ? title : `${title} — Oxiedo`;
const desc =
	description ??
	'ORMAS is a neural network training architecture that makes per-component causal attribution a physical property of training, not something reconstructed afterwards.';
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE).href;
// Per-page cards are rendered by scripts/build-og-cards.mjs into public/og/. The version
// suffix is in the filename because X and LinkedIn cache a card by URL for weeks: a
// redesigned card at the same URL keeps previewing as the old one.
const ogImage = new URL(ogImagePath ?? '/og/home-v2.png', SITE).href;
const ogAlt = pageTitle;

// ─── JSON-LD ────────────────────────────────────────────────────────────────
// STABLE @ids, and everything points at them. Before 2026-09-18 this layout
// restated the whole organisation on all 26 pages as an anonymous node, which
// is not one entity a crawler accumulates confidence in — it is 26 unrelated
// nodes that happen to share a name. A search engine builds a Knowledge Graph
// entity out of corroboration, and there is nothing to corroborate when every
// page asserts the company from scratch and nothing references anything.
//
// The fragments never change. They hang off canonical URLs, so a node survives
// the page it was first declared on being renamed — which /demo → /black-box
// had just demonstrated is a thing that happens.
const ORG_ID = `${SITE}/#organization`;
const SITE_ID = `${SITE}/#website`;
const FOUNDER_ID = `${SITE}/#founder`;
const LOGO_ID = `${SITE}/#logo`;
const ORMAS_ID = `${SITE}/#ormas`;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const PAGE_ID = `${canonical}#webpage`;
const CRUMB_ID = `${canonical}#breadcrumb`;

// Organisation. Every claim is stated on /press under FAST FACTS, so the markup
// cannot drift from the page a journalist checks it against. Nothing is here
// that is not there: no legalName (the company is not yet incorporated), no
// address (none is published), no telephone, no aggregateRating.
const orgLd = {
	'@type': 'Organization',
	'@id': ORG_ID,
	name: 'Oxiedo',
	url: SITE,
	description:
		'Oxiedo is a research company founded by Rokib Al Dhin Raadh, building ORMAS, a neural network training architecture that produces a causal account of its own behaviour as a physical consequence of how it learns.',
	foundingDate: '2023',
	// REQUIRED, and it was missing entirely. Google's organisation result does
	// not render a logo it has to infer from a favicon; the property has to name
	// an image. Both properties are references to the node below rather than one
	// inline object and one pointer at it — a nested definition resolves for a
	// parser that keeps the tree, and dangles for anything that flattens the
	// graph first, which is most of them.
	logo: { '@id': LOGO_ID },
	image: { '@id': LOGO_ID },
	founder: { '@id': FOUNDER_ID },
	slogan: 'AI that can see inside itself, and fix what it finds.',
	contactPoint: { '@type': 'ContactPoint', contactType: 'sales', url: `${SITE}/contact`, availableLanguage: 'en' },
	// knowsAbout is the topic declaration. It is the one place the site states,
	// in machine-readable form, which field this name belongs to — which is the
	// question a search engine is actually failing to answer when it decides
	// "Oxiedo" is a misspelling of a drug brand.
	knowsAbout: [
		'Neural network training',
		'Machine learning interpretability',
		'Training-time telemetry',
		'Data provenance',
		'Model auditability',
		'AI governance',
	],
	// sameAs is how a crawler ties an account to a company, and it is verified by
	// reciprocity — the linked profile has to point back. One entry is one
	// corroboration, which is why the entity is not resolving. Every profile
	// added here must link to oxiedo.com from its own bio or it counts for
	// nothing. The outstanding list is in `Replay Demo Plan/12_ENTITY_AND_SEO.md`;
	// this array is the record of which ones exist.
	sameAs: ['https://x.com/oxiedo_ai'],
};

// 512×512 raster — the mark is brushed metal, so there is no SVG of it.
const logoLd = {
	'@type': 'ImageObject',
	'@id': LOGO_ID,
	url: `${SITE}/icons/icon-512.png`,
	contentUrl: `${SITE}/icons/icon-512.png`,
	width: 512,
	height: 512,
	caption: 'Oxiedo',
};

// ORMAS, the architecture, as an entity distinct from Oxiedo, the company that
// publishes it. That distinction is the first thing /faq has to explain to a
// human, so it is worth stating to a crawler in the same breath.
//
// IT LIVES HERE, not on the two pages that describe it. It was declared twice —
// once in index.astro, once in product.astro — and the two copies had already
// drifted apart, which is the whole failure mode: a crawler reconciling two
// different descriptions of one name concludes it is looking at two things, or
// at one thing the site cannot describe consistently. Every page now carries
// the same node, so 26 pages corroborate one architecture instead of two pages
// each asserting their own.
const ormasLd = {
	'@type': 'SoftwareApplication',
	'@id': ORMAS_ID,
	name: 'ORMAS',
	alternateName: 'Orchestrated Repair and Monitoring with Architectural Self-correction',
	applicationCategory: 'DeveloperApplication',
	applicationSubCategory: 'Machine learning training architecture',
	operatingSystem: 'Linux',
	description:
		'A neural network training architecture that records what a model took from each source of data as it trains, so data locked by regulation and contract becomes data an institution can defensibly train on.',
	url: `${SITE}/product`,
	author: { '@id': ORG_ID },
	provider: { '@id': ORG_ID },
	creator: { '@id': FOUNDER_ID },
	subjectOf: [{ '@id': `${SITE}/#ormas-preprint` }, { '@id': `${SITE}/#deepmath-2026` }],
	// NO aggregateRating and NO price. Both are what a rich result for this type
	// needs, and both would have to be invented: there are zero customers and the
	// licence fee is agreed per institution. An ineligible listing is the correct
	// outcome; a fabricated rating is a manual action.
	offers: {
		'@type': 'Offer',
		category: 'Annual deployment licence, per institution',
		availability: 'https://schema.org/PreOrder',
		url: `${SITE}/licensing`,
		priceSpecification: {
			'@type': 'PriceSpecification',
			description: 'Agreed per institution and written into the contract. No price list.',
		},
	},
};

// THE FOUNDER. Stated as fully as the facts allow, because an entity with one named person behind
// it resolves only if that person resolves too: name, the name he is known by, role, what he built,
// the paper he wrote, and the one profile that links back to oxiedo.com from its own bio.
const founderLd = {
	'@type': 'Person',
	'@id': FOUNDER_ID,
	name: 'Rokib Al Dhin Raadh',
	alternateName: 'Raad',
	jobTitle: 'Founder & CEO',
	description:
		'Rokib Al Dhin Raadh is the founder and CEO of Oxiedo and the inventor of ORMAS, a neural network training architecture that records every change it makes to itself as it trains. He designed the architecture, built it, ran its 383 controlled experiments and is the sole author of the ORMAS preprint. His paper on its stability theory is accepted for a poster at DeepMath 2026.',
	url: `${SITE}/about#founder`,
	worksFor: { '@id': ORG_ID },
	knowsAbout: ['Neural network training', 'Machine learning interpretability', 'Self-correcting neural networks', 'Continual learning'],
	sameAs: ['https://x.com/Raad_X_'],
};

// The preprint, authored by the founder. Public on Zenodo with a DOI since 1 August 2026.
const PAPER_ID = `${SITE}/#ormas-preprint`;
const paperLd = {
	'@type': 'ScholarlyArticle',
	'@id': PAPER_ID,
	headline: 'ORMAS: Neural Architectural Transparency Enables Autonomous Self-Correction',
	author: { '@id': FOUNDER_ID },
	datePublished: '2026-08-01',
	url: 'https://zenodo.org/records/21730363',
	sameAs: 'https://doi.org/10.5281/zenodo.21730363',
	// The DOI as a typed identifier, not only a URL: it is the one string a citation manager,
	// Google Scholar and an answer engine can all resolve to the same record.
	identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: '10.5281/zenodo.21730363' },
	publisher: { '@type': 'Organization', name: 'Zenodo', url: 'https://zenodo.org' },
	isAccessibleForFree: true,
	inLanguage: 'en',
	about: { '@id': ORMAS_ID },
};

// Accepted for a poster at DeepMath 2026 (decision, 30 September 2026).
const deepmathLd = {
	'@type': 'ScholarlyArticle',
	'@id': `${SITE}/#deepmath-2026`,
	headline: 'Self-Repair as a Bounded Disturbance: Input-to-State Stability of Neural Network Training Dynamics',
	author: { '@id': FOUNDER_ID },
	url: 'https://deepmath-conference.com/',
	// Accepted, not published: the paper is not public yet, so there is no datePublished and no
	// link to the text. Replace url with the paper's own page once DeepMath releases it.
	creativeWorkStatus: 'Accepted for a poster presentation',
	dateCreated: '2026-09-30',
	inLanguage: 'en',
	about: { '@id': ORMAS_ID },
	isPartOf: {
		'@type': 'Event',
		name: 'DeepMath 2026: Conference on the Mathematical Theory of Deep Neural Networks',
		// description, organizer and image were flagged missing by Search Console on 2026-09-30.
		// The organizer is the conference itself; the image is our own card for the poster.
		description:
			'DeepMath 2026, the Conference on the Mathematical Theory of Deep Neural Networks, in Columbus, Ohio. Rokib Al Dhin Raadh of Oxiedo presents an accepted poster on the input-to-state stability of self-repairing neural network training.',
		organizer: { '@type': 'Organization', name: 'DeepMath', url: 'https://deepmath-conference.com/' },
		performer: { '@id': FOUNDER_ID },
		image: `${SITE}/og/deepmath-2026-v2.png`,
		startDate: '2026-10-29',
		endDate: '2026-10-30',
		eventStatus: 'https://schema.org/EventScheduled',
		eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
		url: 'https://deepmath-conference.com/',
		location: {
			'@type': 'Place',
			name: 'Columbus, Ohio, USA',
			address: { '@type': 'PostalAddress', addressLocality: 'Columbus', addressRegion: 'OH', addressCountry: 'US' },
		},
	},
};

// WebSite is the node that declares what this domain IS, distinct from the
// company that runs it. No SearchAction: the sitelinks searchbox was retired in
// November 2024, and the FAQ filter is client-side with no URL to hand over —
// markup for an endpoint that does not exist is a lie a crawler can catch.
const websiteLd = {
	'@type': 'WebSite',
	'@id': SITE_ID,
	url: SITE,
	name: 'Oxiedo',
	description:
		'ORMAS is a neural network training architecture that makes per-component causal attribution a physical property of training.',
	publisher: { '@id': ORG_ID },
	inLanguage: 'en',
};

// EVERY JSON-LD ENTITY GOES IN ONE @graph, not in several <script> blocks.
// Separate blocks are parsed as unrelated entities, so a crawler has no way to
// know the breadcrumb belongs to the same page as the organisation. A graph
// with @id references states the relationship outright.
const breadcrumbLd = breadcrumbs?.length
	? {
			'@type': 'BreadcrumbList',
			'@id': CRUMB_ID,
			itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((b, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				name: b.name,
				item: new URL(b.path, SITE).href,
			})),
		}
	: null;

// The three pages that are ABOUT the company get `about`; the rest would be
// overclaiming — /careers is not a page about Oxiedo as an entity, it is a page
// the entity publishes, which is what `publisher` says.
const ORG_PAGES = new Set(['/', '/about', '/press']);

// dateModified from the same table the sitemap reads, so the two can never disagree about
// when a page last changed — a crawler that finds them contradicting each other discounts
// both. Absent rather than guessed for a route with no entry: a made-up freshness date is
// the specific thing that makes Google stop reading them.
const modified = (lastmod as Record<string, string>)[pathname];

// The specific WebPage subtype where one exists, so a crawler knows what kind of page it is
// reading without inferring it. /faq is not here: it declares its own FAQPage node.
const PAGE_TYPES: Record<string, string> = {
	'/about': 'AboutPage',
	'/contact': 'ContactPage',
	'/product': 'CollectionPage',
	'/sectors': 'CollectionPage',
	'/insights': 'CollectionPage',
};

const webPageLd = {
	'@type': PAGE_TYPES[pathname] ?? 'WebPage',
	'@id': PAGE_ID,
	url: canonical,
	name: pageTitle,
	description: desc,
	isPartOf: { '@id': SITE_ID },
	publisher: { '@id': ORG_ID },
	inLanguage: 'en',
	...(modified ? { dateModified: modified } : {}),
	...(ORG_PAGES.has(pathname) ? { about: { '@id': ORG_ID } } : {}),
	...(pathname === '/about' ? { mainEntity: { '@id': FOUNDER_ID } } : {}),
	// speakable names the two lines an assistant should read aloud or quote for "what is
	// Oxiedo": the headline and the line under it, both of which are plain statements.
	...(pathname === '/'
		? { speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.hero-headline', '.hero-subhead'] } }
		: {}),
	...(breadcrumbLd ? { breadcrumb: { '@id': CRUMB_ID } } : {}),
};

const graph = [
	orgLd,
	logoLd,
	founderLd,
	paperLd,
	deepmathLd,
	websiteLd,
	ormasLd,
	webPageLd,
	breadcrumbLd,
	...(Array.isArray(schema) ? schema : schema ? [schema] : []),
]
	.filter(Boolean)
	.map((e) => ({ ...(e as Record<string, unknown>) }));
const pageLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>document.documentElement.classList.add('js');</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={desc} />
		<meta name="author" content="Rokib Al Dhin Raadh" />
		<link rel="canonical" href={canonical} />
		{!indexable && <meta name="robots" content="noindex, follow" />}

		{/* SEARCH ENGINE OWNERSHIP VERIFICATION. These prove control of the domain to a webmaster
		    console; they are not ranking signals and they carry no script. They sit in the shared
		    layout rather than on index.astro alone because a console re-checks periodically and
		    will re-verify against any page it happens to crawl.

		    Google is verified by DNS TXT on the apex instead, which covers www, non-www, http and
		    https in one property. Do not remove these once verified: the console drops the
		    property when the token disappears. */}
		<meta name="msvalidate.01" content="FBC421207EE5371613CEF15DCE90B7F7" />

{/* ICONS. There were none before this: favicon.svg was a 0-byte placeholder and /icons was
		    empty, so every browser fell through to a 404 on /favicon.ico and drew a blank page.
		    The mark is a raster render — brushed metal, bevelled edges — so there is no SVG icon:
		    the material IS the mark, and vectorising it would discard the thing that identifies it.
		    Cut from media/newfav-only-logo.png, which carries alpha, so the glyph sits on the
		    browser's own tab colour rather than on a tile of ours.
		    THE 16/32 SIZES ARE LIFTED. The metal averages 45/255; a dark tab bar is ~32/255, so at
		    tab size the fill very nearly merges into it and only the bevel highlights hold the
		    shape. Measured on both a light and a dark tab before setting the amount. */}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/icons/favicon-96.png" type="image/png" sizes="96x96" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		{/* Tints the mobile browser chrome, so it tracks the page ground, not the icon. */}
		<meta name="theme-color" content="#F3F1EA" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#16182B" media="(prefers-color-scheme: dark)" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Oxiedo" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={desc} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content={ogAlt} />
		<meta property="og:locale" content="en_GB" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@oxiedo_ai" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={desc} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogAlt} />
		<meta name="twitter:creator" content="@Raad_X_" />

		<script type="application/ld+json" set:html={JSON.stringify(pageLd)} is:inline />
		<ClientRouter />
		<link rel="preload" href="/fonts/Fraunces-Variable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/PlusJakartaSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<slot />

		<!--
			THE MOBILE MENU, bound here and deliberately not in a module. This is the only route to
			navigation on a phone, so it must not depend on anything that can fail upstream: no
			bundler output, no ClientRouter, no astro:page-load, no other script's errors. It is
			inline, runs the moment it is parsed, and every listener is delegated to `document` so
			it keeps working after a client-side navigation replaces the header.
		-->
		<script is:inline>
			(function () {
				if (window.__oxiedoNav) return;
				window.__oxiedoNav = true;

				var HTML = document.documentElement;
				function panel() { return document.querySelector('.nav-mobile'); }
				function burger() { return document.querySelector('.nav-hamburger'); }
				function isOpen() { var p = panel(); return !!(p && p.hasAttribute('open')); }

				function closeMenu() {
					var p = panel();
					if (p && p.hasAttribute('open')) {
						if (typeof p.close === 'function') p.close(); else p.removeAttribute('open');
					}
					var b = burger(); if (b) b.setAttribute('aria-expanded', 'false');
					HTML.classList.remove('nav-locked');
				}

				function openMenu() {
					var p = panel(); if (!p) return;
					// showModal() puts the panel in the top layer, clear of the header's
					// backdrop-filter containing block. The fallbacks matter: showModal throws if
					// the dialog is already open, and a browser without <dialog> still gets a
					// usable panel from the open attribute.
					try {
						if (typeof p.showModal === 'function') p.showModal();
						else p.setAttribute('open', '');
					} catch (err) { p.setAttribute('open', ''); }
					var b = burger(); if (b) b.setAttribute('aria-expanded', 'true');
					HTML.classList.add('nav-locked');
					var first = p.querySelector('a[href], button');
					if (first) first.focus();
				}

				document.addEventListener('click', function (e) {
					var t = e.target;
					if (!t || !t.closest) return;
					if (t.closest('.nav-hamburger')) {
						e.preventDefault();
						if (isOpen()) closeMenu(); else openMenu();
						return;
					}
					if (t.closest('.nav-mobile-close')) { e.preventDefault(); closeMenu(); return; }

					var tog = t.closest('.nav-mobile-toggle');
					if (tog) {
						e.preventDefault();
						var sub = tog.parentElement && tog.parentElement.nextElementSibling;
						// NOT `isOpen`. That name belongs to the panel helper in the enclosing
						// scope, and `var` hoists to the top of THIS function — so declaring it
						// here shadowed the helper with undefined for the whole handler, and the
						// hamburger branch above threw "isOpen is not a function" on its first
						// line. The listener died and the menu button did nothing at all.
						var subExpanded = tog.getAttribute('aria-expanded') === 'true';
						tog.setAttribute('aria-expanded', subExpanded ? 'false' : 'true');
						if (sub) sub.hidden = subExpanded;
						return;
					}
					if (t.closest('.nav-mobile a')) closeMenu();
				});

				// Escape and the backdrop are handled by the dialog itself; this keeps the
				// hamburger's aria-expanded and the scroll lock in step when the UA closes it.
				document.addEventListener('close', function (e) {
					if (e.target && e.target.classList && e.target.classList.contains('nav-mobile')) {
						var b = burger(); if (b) b.setAttribute('aria-expanded', 'false');
						HTML.classList.remove('nav-locked');
					}
				}, true);

				// Tapping the backdrop closes. The dialog element's own box is the panel, so a
				// click whose target IS the dialog landed outside it.
				document.addEventListener('click', function (e) {
					if (e.target && e.target.classList && e.target.classList.contains('nav-mobile')) closeMenu();
				});

				document.addEventListener('keydown', function (e) {
					if (e.key === 'Escape' && !isOpen()) closeMenu();
				});

				document.addEventListener('astro:after-swap', closeMenu);
			})();
		</script>

		<script>
			// Each script exports an idempotent init. astro:page-load fires on the first load and
			// after every ClientRouter navigation, so interactivity is re-attached to the new DOM
			// rather than silently dying after the first client-side navigation.
			import initReveal from '../scripts/reveal.ts';
			import initNav from '../scripts/nav.ts';
			import initAccordion from '../scripts/accordion.ts';
			import initForm from '../scripts/form.ts';

			// Each init is isolated. They used to run as four bare calls in one callback, so the
			// first one to throw silently killed every init after it — a reveal-animation error
			// could take out the mobile navigation, and nothing in the UI would say why.
			document.addEventListener('astro:page-load', () => {
				for (const [name, fn] of [
					['reveal', initReveal],
					['nav', initNav],
					['accordion', initAccordion],
					['form', initForm],
				] as const) {
					try {
						fn();
					} catch (err) {
						console.error(`[oxiedo] ${name} init failed:`, err);
					}
				}
			});
		</script>
	</body>
</html>
