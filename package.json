{
  "name": "oxiedo-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:nav": "node scripts/test-nav.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "verify": "npm run build && python3 check.py && python3 scripts/verify-replay-bundle.py && node scripts/check-schema.mjs && node scripts/check-replay-scoping.mjs && node scripts/test-replay-engine.mjs && npm run test:nav",
    "build:bundles": "python3 scripts/build-replay-bundle.py && python3 scripts/verify-replay-bundle.py",
    "test:replay": "node scripts/test-replay-engine.mjs"
  },
  "dependencies": {
    "astro": "7.3.1",
    "katex": "0.18.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
